%% TRIM SIZE: \trimsize{width=W,height=H}
%%   W and H must have units, either in (inches) or mm (millimters). Same units for both.
%% Both W and H have upper and lower limits. H must exceed W by a certain amount.
%%   Default width=5.5in,height=8.5in, a common size for print-on-demand un USA. If you set
%% either of width or height, then you must also set the other.
\newlength\nvt@trimwidth \newlength\nvt@trimheight
\newif\ifnvt@metric %% Becomes true if W and H use metric units.
\DeclareDocumentCommand\trimsize{m}{%% Ignored when mode=usl.
  \directlua{nvt.parsetrimsize('\luaescapestring{#1}')}
  \ifnum\tmpreturn=-1\relax
    \nvt@fatal{Duplicate setting for \string\trimsize.}
  \fi
  \ifnum\tmpreturn=1\relax
    \edef\tmprtw{\fpeval{round(72*\tmptw/72.27,3)}}
    \edef\tmprth{\fpeval{round(72*\tmpth/72.27,3)}}
    \setlength\nvt@trimwidth{\tmprtw bp}\setlength\nvt@trimheight{\tmprth bp}
    \xdef\nvt@TrimBox{/TrimBox [ 0 0 \tmprtw\space\tmprth\space]}
    \ifnum\tmpmetric=1\global\nvt@metrictrue\else\global\nvt@metricfalse\fi
  \else
    \nvt@fatal{Bad setting for \string\trimsize.^^J%%
      \spii Format: \string\strimsize{width=W,height=H}^^J%%
      \spiv W -> Width of finished pages. Default 5.5in.^^J%%
      \spiv H -> Height of finished pages. Default 8.5in.^^J%%
      \spix W and H require units, in (inches) or mm (millimeters).^^J%%
      \spix Whatever units you use, must be the same for both.^^J%%
      \spix W and H have minimum and maximum values, which accomodate widely-used^^J%%
      \spix British and American book sizes for print-on-demand popular fiction.^^J%%
      \spix But W and H do not accomodate very small, or business paper sizes.^^J%%
      \spix H must exceed W by a certain amount. See Novelette docs for info.}%%
  \fi
}%%
\trimsize{width=5.5in,height=8.5in} %% Default.
\directlua{nvt.didtrimsize=0}
\@onlypreamble\trimsize
