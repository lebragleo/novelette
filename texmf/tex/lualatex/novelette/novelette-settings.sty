%%
\newif\ifnvt@diddocdate
\def\thedocdate{} %% Default.
\def\docdate#1{%%
  \ifnvt@diddocdate\nvt@duplicatesettingtrue\fi
  \edef\nvt@rawdocdate{\nvt@expdet{#1}}
  \catcode`\#=12 \catcode`\$=12 \catcode`\%=12 \catcode`\&=12
  \directlua{nvt.parsedocdate('\luaescapestring{\nvt@rawdocdate}')}
  \catcode`\#=6 \catcode`\$=3 \catcode`\%=14 \catcode`\&=4
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad setting for \string\docdate\space in Preamble.^^J%%
      \spii Format: \string\docdate{yyyy/mm/dd} or empty.}
    \def\thedocdate{}
  \else
    \edef\thedocdate{\tmpdocdate}
  \fi
  \nvt@diddocdatetrue
}%%
