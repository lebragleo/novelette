%% ENABLE:
%%   You may enable some features that are not ordinarily pre-set for you. The setting consists
%% of comma-separated choices. You may use \enable more than once in Preamble (cumulative effect).
%%   britq -> Normally, Novelette resolves ``` and ''' as American-style quotes: double outside,
%%     single inside (ordinary LaTeX does the wrong thing). \enable{britq} resolves triple quotes
%%     British-style: single outsdie, double inside.
%%   xmp -> Adds XMP metadata, only in good final mode.
%%     With or without xmp, the Info dictionary always contains essential metadata.
%%   guide=G -> Marker in left margin at line G, only on first page of component in draft mode.
%%     guide=last places marker at last line per page (not including footer).
%%\newif\ifnvt@didenable
\newif\ifnvt@britq
\newif\ifnvt@xmp
\newif\ifnvt@hasguide
\def\nvt@guideline{0}
\DeclareDocumentCommand\enable{m}{%%
%%  \ifnvt@didenable\nvt@duplicatesettingtrue\fi
  \begingroup
  \def\tmpbritq{0}\def\tmpxmp{0}
  \def\tmphasguide{0}\def\tmpguide{0}
  \directlua{nvt.parseenable('\luaescapestring{#1}')}
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad setting for \string\enable.^^J%%
      \spii Format: \string\enable{comma,separated,choices}.^^J%%
      \spiv Choices:  britq xmp}%%
  \fi
  \ifnum\tmpbritq=1\relax\global\nvt@britqtrue\fi
  \ifnum\tmpxmp=1\relax\global\nvt@xmptrue\fi
  \ifnum\tmphasguide=1\relax\global\nvt@hasguidetrue\xdef\nvt@guideline{\tmpguideline}\fi
  \endgroup
%%  \nvt@didenabletrue
}%%
\@onlypreamble\enable
