%% HYPHENATION LANGUAGE:
%%   Novelette is monolingual. You may load a single hyphenation pattern for one of the
%% major Western European languages. Although you may type text in any language supported
%% by the Novelette fonts, it will be hyphenated according to the rules of your main language.
%%   Neither babel nor polyglossia are loaded, so there are no 'shortcuts' or other
%% language-dependent rules. However, the fonts have built-in support for Catalan 'ele geminada',
%% and Dutch 'jacute', in any language. There is also built-in support for French punctuation,
%% because ~ is re-defined as a thin non-breaking space, rather than full-width.
%%   Hyphenation is automatically disabled in areas where it would not be appropriate.
\newif\ifnvt@didlang %% True if \lang set.
\newif\ifnvt@nohyphenate %% True when \lang is a no-hyphen choice. Default en, but ignores it.
\newif\ifnvt@genericen\nvt@genericentrue %% Becomes false if valid \lang other than {en}.
\def\nvt@lang{english} %% Default.
\def\lang#1{%% If your language is English, then set en-US or en-UK instead!
  \ifnvt@didlang\nvt@duplicatesettingtrue\fi
  \def\nvt@rawlang{#1}
  \def\tmpreturn{3}
  \directlua{nvt.parselang('\luaescapestring{\nvt@rawlang}')}
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad setting for \string\lang.^^J%%
      \spii Unavailable language code, or multiple language codes.^^J%%
      \spii Novelette only supports some of the major Western European languages.^^J%%
      \spii See Novelette docs for list of available language codes.}
    \def\nvt@lang{en}
  \else
    \edef\nvt@lang{\tmplang}
  \fi
  \ifnum\tmpreturnlang=1\relax\nvt@genericenfalse\fi
  \ifnum\tmpreturnlang=2\relax\nvt@nohyphenatetrue\fi
  \nvt@didlangtrue
}%%
\@onlypreamble\lang
