%% MODE:
%%   The mode determines what the compiler will do, in the event of error or warning.
%% Choices: draft preview final (also dev and usl for developer only).
%%   In draft mode (default), a few inspections are not performed, possibly saving time.
%% PDF/X is disabled, and the metadata title is prefixed by DRAFT.
%%   In preview mode, all inspections are performed. The metadata title is prefixed by PREVIEW.
%% PDF/X is disabled. Use preview mode for final check, and for circulating a copy to editors.
%%   In final mode, all inspections are performed. If success, PDF/X is enabled upon request.
%% Your document is as ready as it can get.
%%   When draft, preview, or final mode fails with error/warning/badbox, the metadata title
%% is prefixed with BAD DRAFT, and PDF/X is disabled. This reduces the likelihood that you will
%% upload a bad result to your print service.
\newif\ifnvt@draft\nvt@drafttrue \def\nvt@titleprefix{DRAFT: } %% Default.
\newif\ifnvt@usl
\newif\ifnvt@dev
\newif\ifnvt@preview
\newif\ifnvt@final
\def\mode#1{%%
  \directlua{nvt.parsemode('\luaescapestring{#1}')}
  \ifnum\tmpreturn=-1\relax
    \nvt@fatal{Duplicate setting for \string\mode.}
  \fi
  \ifnum\tmpreturn=0\relax
    \nvt@fatal{Bad setting for \string\mode.^^J%%
      Choices: draft preview final. Default draft.}%% usl, dev for developer only.
    \batchmode \read-1 to \sorry
  \fi
}%%
\@onlypreamble\mode
