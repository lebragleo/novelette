%% OVERVIEW:
%%   Novelette does not use class options. Instead, you write various settings in the Preamble.
%% The values are stored until AtBeginDocument. Every setting has a default.
%%   When a setting is written, it is immediately sanity-checked for syntax and allowed values.
%% Insane settings throw an error, often fatal. Sane settings are stored.
%%   During AtBeginDocument, all written and default settings are implemented. If there are
%% incompatible settings, error or warning. Implementation is in stages, because the effects
%% of some settings will depend on what came before.
%%   Note that you cannot choose the margins, font, or font size for main text. These are fixed or
%% automatically calculated, based on other settings. This is a unique feature of Novelette.
%% The fixed/calculated values have been carefully chosen for compatibility with nearly all
%% worldwide print-on-demand services, and for readability in popular fiction books.


%% METADATA:
%%   The \title and \author settings are required. These will be stored in the Info dictionary
%% and (if you use it) XMP metadata.
%%   If your book has a subtitle, you may use \subtitle. It will be written to a custom Info key,
%% and to a Prism tag in XMP (if used). You may disable the key/tag.
%%   If you use \docdate, it locks the metadata creation date to the start of that day GMT.
%% If you use \version, it appears as VersionID in XMP (if used).
%%   The \docdate format is yyyy/mm/dd. The \version may be anything convenient, such as
%% Edition 1.02, build 2394.
%%   Title, author, aubtitle, docdate, and version (even if empty) are hashed for the uniqueID.
%% The instanceID changes at each compile.
%%   Novelette has special requirements for metadata. The characters are limited to a subset
%% of Latin-1. Symbols @ # & must be escaped with backslash. Otherwise, the backslash cannot
%% be used; you cannot write \'E for Eacute, but must paste the actual Unicode character.
%%   The total number of characters in all of title, author, subtitle, docdate, and version,
%% may not exceed ~200. This is far more than you need for popular fiction.
%%   Tech note: The metadata settings are concatenated and detokenized. This string is typeset
%% on a temporary page (discarded). The font has features that convert \@ \# \& to their base
%% characters, and convert all disallowed characters to a narrow bar with excess depth. Then the
%% string is boxed. If the box depth is too much, it means a disallowed character was used. Error.
\def\thetitle{Untitled Document}
\def\title#1{%%
  \edef\nvt@rawtitle{\nvt@expdet{#1}}
  \catcode`\#=12 \catcode`\$=12 \catcode`\%=12 \catcode`\&=12
  \directlua{nvt.parsetitle('\luaescapestring{\nvt@rawtitle}')}
  \catcode`\#=6 \catcode`\$=3 \catcode`\%=14 \catcode`\&=4
  \ifnum\tmpreturn=-1\relax
    \nvt@fatal{Duplicate setting for \string\title.}
  \fi
  \ifnum\tmpreturn=0\relax
    \nvt@fatal{Bad setting for \string\title. Unmatched parentheses ().}%%
  \else
    \def\thetitle{\nvt@expdet{\tmptitle}}
  \fi
}%%
\title{Untitled Document} %% Default.
\directlua{nvt.didtitle=0}
%%
