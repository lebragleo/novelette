%% Novelette avoids flexible vertical glue, wherever possible:
\setlength\columnsep{0pt}
\setlength\columnseprule{0pt}
\setlength\marginparwidth{0pt}
\setlength\marginparsep{0pt}
\setlength\marginparpush{0pt}
\setlength\abovedisplayskip{0pt}
\setlength\belowdisplayskip{0pt}
\setlength\abovedisplayshortskip{0pt}
\setlength\belowdisplayshortskip{0pt}
\setlength\smallskipamount{0pt}
\setlength\medskipamount{0pt}
\setlength\bigskipamount{0pt}
\setlength\topsep{0pt}
\setlength\partopsep{0pt}
\setlength\parsep{0pt}
\setlength\parskip{0pt}
\setlength\floatsep{0pt}
\setlength\textfloatsep{0pt}
\setlength\dbltextfloatsep{0pt}
\setlength\intextsep{0pt}
\setlength\lineskip{0pt} %% Not the same as \baselineskip.
\setlength\normallineskip{0pt}
\setlength\lineskiplimit{0pt}
\def\baselinestretch{1}
%% Novelette does not have flexible line spacing, or flexible glue between paragraphs.
%% Thus, there is no point to heavily penalizing them, as that might affect inter-word spaces.
%% Lua can examine each page, after layout, for widows and orphans. In popular fiction,
%% orphans are common. Widows are considered to be a problem.
\widowpenalty 150\relax %% widow -> Last line of paragraph at start of page.
\clubpenalty 150\relax %% orphan -> First line of paragraph at end of page.
%% The low, med, and high penalties usually apply to situations that are not seen in Novelette:
\@lowpenalty   51\relax
\@medpenalty  151\relax
\@highpenalty 301\relax
%% Hyphenation is discouraged, especially when consecutive, or just prior to paragraph end:
\hyphenpenalty 1000\relax
\exhyphenpenalty 1000\relax
\doublehyphendemerits 10000\relax
\finalhyphendemerits 10000\relax
\setcounter{topnumber}{2} %% Maximum number of floats allowed there.
\setcounter{bottomnumber}{1} %% And there.
\setcounter{totalnumber}{2} %% And all together.
\renewcommand\topfraction{.75} %% Maximum portion of page allowed for top floats.
\renewcommand\bottomfraction{.25} %% Or bottom floats.
\renewcommand\textfraction{.25} %% Minimum portion of page to be occupied by main text.
\renewcommand\floatpagefraction{.5} %% Probably not useful, but must be less than \topfraction.
%% Novelette does not use 2-column layout, so these are generic:
\setcounter{dbltopnumber}{2}
\renewcommand\dbltopfraction{.7}
\renewcommand\dblfloatpagefraction{.5}
%% Novelette controls alignment via command options, not by direct user commands:
\let\nvt@raggedleft\raggedleft\relax\let\nvt@raggedright\raggedright\relax
\def\raggedleft{\nvt@warn{\string\raggedleft\space not available in Novelette. Ignored.}}
\def\raggedright{\nvt@warn{\string\raggedright\space not available in Novelette. Ignored.}}
\def\flushleft{\nvt@warn{Environment flushleft not available in Novelette. Ignored.}}
\def\flushright{\nvt@warn{Environment flushright not available in Novelette. Ignored.}}
\let\endflushleft\relax\let\endflushright\relax
\def\nvt@centering{\let\\\@centercr\rightskip\@flushglue\leftskip\@flushglue\parfillskip\z@skip}
\long\def\nvt@center{\trivlist\nvt@centering\item\relax}
\let\nvt@endcenter\endcenter
\long\def\center{\nvt@warn{%%
  \spii The center environment, and \string\centering, cannot be used in Novelette.^^J%%
  \spii The block environment has [center] option, which serves that purpose.^^J%%
  \spii \string\namestyle, \string\subnamestyle, %%
        and \string\scenestyle\space allow {align=center}.^^J%%
  \spii \string\name, \string\subname, \string\scenetext, \string\sceneimage, %%
        and \string\image\space allow [align=center].}%%
}%%
