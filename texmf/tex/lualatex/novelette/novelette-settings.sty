%% ENABLE:
%%   You may enable some features that are not ordinarily pre-set for you. The setting consists
%% of comma-separated choices. You may use \enable more than once in Preamble (cumulative effect).
%%   britq -> Normally, Novelette resolves ``` and ''' as American-style quotes: double outside,
%%     single inside (ordinary LaTeX does the wrong thing). \enable{britq} resolves triple quotes
%%     British-style: single outsdie, double inside.
%%   xmp -> Adds XMP metadata, only in good final mode.
%%     With or without xmp, the Info dictionary always contains essential metadata.
%%   guide=G -> Marker in left margin at line G, only on first page of component in draft mode.
%%     guide=last places marker at last line per page (not including footer).
\newif\ifnvt@britq
\newif\ifnvt@xmp
\newif\ifnvt@hasguide
\def\nvt@guideline{0}
\DeclareDocumentCommand\enable{m}{%%
  \begingroup
  \def\tmpbritq{0}\def\tmpxmp{0}
  \def\tmphasguide{0}\def\tmpguide{0}
  \directlua{nvt.parseenable('\luaescapestring{#1}')}
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad setting for \string\enable.^^J%%
      \spii Format: \string\enable{comma,separated,choices}.^^J%%
      \spiv Choices: britq xmp guide=G^^J%%
      \spix G is an integer from 0 (no guide) to lines per page.^^J%%
      \spix If you \string\disable{guide}, it over-rides this value.}%%
  \fi
  \ifnum\tmpbritq=1\relax\global\nvt@britqtrue\fi
  \ifnum\tmpxmp=1\relax\global\nvt@xmptrue\fi
  \ifnum\tmphasguide=1\relax\global\nvt@hasguidetrue\xdef\nvt@guideline{\tmpguideline}\fi
  \endgroup
}%%
\@onlypreamble\enable
%%


%% DISABLE:
%%   You may disable some features that are ordinarily pre-set for you. The setting consists
%% of comma-separated choices. You may use \disable more than once in Preamble (cumulative effect).
%%   blankend -> Normally, one or two blank pages are automatically added at end of PDF,
%%     so that final page is blank verso. \disable{blankend} omits adding those pages.
%%   renumber -> PDFpage numbers are continous. Printable book page numbers, where they appear,
%%     are lowercase italic in frontmatter, reset to arabic 1 at mainmatter, no reset at endmatter.
%%     \disable{renumber} sets book page equal to PDF page, continous arabic throughout.
%%   pageflip -> Ignored if not draft mode. Normally, the glue strip shifts from left to right
%%     margin, as required for print. This is distracting when you proofread draft, on screen.
%%     \disable{pageflip}  splits the glue equally, so no shift. Does not affect typesetting.
%%   autodeco -> Transitions frontmatter/mainmatter/backmatter have verso/recto requirements.
%%     If necessary, a generic decorative recto page is inserted for that purpose.
%%     \disable{autodeco} does not insert the page.
%%   metasub -> Normally, non-empty subtitle has custom Info dictionary entry. If using xmp,
%%     it is written there (prism namespace). \disable(metasub) omits these entries.
%%   guide -> Any global or local guide=N setting is ignored.
\newif\ifnvt@noblankend
\newif\ifnvt@norenumber
\newif\ifnvt@nopageflip
\newif\ifnvt@noautodeco
\newif\ifnvt@nometasub
\newif\ifnvt@noguide
\def\disable#1{%%
  \directlua{nvt.parsedisable('\luaescapestring{#1}')}
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad setting for \string\disable.^^J%%
      \spii Format: \string\disable{comma,separated,choices}.^^J%%
      \spiv Choices: blankend renumber pageflip autodeco metasub guide^^J%%
      \spix If you \string\disable{guide}, it over-rides \string\enable{guide=G}.}%%
  \fi
}%%
\@onlypreamble\disable
%%


%% EXAMINE:
%%   The \examine setting uses the power of Lua to inspect each page after it is typeset.
%% It reports "flaws" in a separate text file. This is time-consuming, so do not set \examine
%% until you are near completion. 
\newif\ifnvt@examine
\DeclareDocumentCommand\examine{m}{%% Choice 1 or 0 (on/off).
  \directlua{parseexamine('\luaescapestring{#1}')}
  \ifnum\tmpreturn=-1\relax
    \nvt@warn{Duplicate settings for \string\examine. First obeyed, others ignored.}
  \fi
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad choice for \string\examine{choice}. Either 1 or 0. Default 0.}
  \fi
}%%
\@onlypreamble\examine
%%


%% GENERAL LATEX PARAMETERS:
%%   These set or over-ride a variety of LaTeX built-in defaults. Some of them are irrelevant
%% in Novelette, but nevetheless they are set. Not normally under user control.
\flushbottom
\vbadness 10000\relax %% Silence!
\@twocolumnfalse
\@twosidetrue
%% Novelette avoids flexible vertical glue, wherever possible:
\setlength\columnsep{0pt}
\setlength\columnseprule{0pt}
\setlength\marginparwidth{0pt}
\setlength\marginparsep{0pt}
\setlength\marginparpush{0pt}
\setlength\abovedisplayskip{0pt}
\setlength\belowdisplayskip{0pt}
\setlength\abovedisplayshortskip{0pt}
\setlength\belowdisplayshortskip{0pt}
\setlength\smallskipamount{0pt}
\setlength\medskipamount{0pt}
\setlength\bigskipamount{0pt}
\setlength\topsep{0pt}
\setlength\partopsep{0pt}
\setlength\parsep{0pt}
\setlength\parskip{0pt}
\setlength\floatsep{0pt}
\setlength\textfloatsep{0pt}
\setlength\dbltextfloatsep{0pt}
\setlength\intextsep{0pt}
\setlength\lineskip{0pt} %% Not the same as \baselineskip.
\setlength\normallineskip{0pt}
\setlength\lineskiplimit{0pt}
\def\baselinestretch{1}
%% Novelette does not have flexible line spacing, or flexible glue between paragraphs.
%% Thus, there is no point to heavily penalizing them, as that might affect inter-word spaces.
%% Lua can examine each page, after layout, for widows and orphans. In popular fiction,
%% orphans are common. Widows are considered to be a problem.
\widowpenalty 150\relax %% widow -> Last line of paragraph at start of page.
\clubpenalty 150\relax %% orphan -> First line of paragraph at end of page.
%% The low, med, and high penalties usually apply to situations that are not seen in Novelette:
\@lowpenalty   51\relax
\@medpenalty  151\relax
\@highpenalty 301\relax
%% Hyphenation is discouraged, especially when consecutive, or just prior to paragraph end:
\hyphenpenalty 1000\relax
\exhyphenpenalty 1000\relax
\doublehyphendemerits 10000\relax
\finalhyphendemerits 10000\relax
\setcounter{topnumber}{2} %% Maximum number of floats allowed there.
\setcounter{bottomnumber}{1} %% And there.
\setcounter{totalnumber}{2} %% And all together.
\def\topfraction{.75} %% Maximum portion of page allowed for top floats.
\def\bottomfraction{.25} %% Or bottom floats.
\def\textfraction{.25} %% Minimum portion of page to be occupied by main text.
\def\floatpagefraction{.5} %% Probably not useful, but must be less than \topfraction.
%% Novelette does not use 2-column layout, so these are generic:
\setcounter{dbltopnumber}{2}
\def\dbltopfraction{.7}
\def\dblfloatpagefraction{.5}
%% Novelette controls alignment via command options, not by direct user commands:
\let\nvt@raggedleft\raggedleft\relax\let\nvt@raggedright\raggedright\relax
\def\raggedleft{\nvt@warn{\string\raggedleft\space not available in Novelette. Ignored.}}
\def\raggedright{\nvt@warn{\string\raggedright\space not available in Novelette. Ignored.}}
\def\flushleft{\nvt@warn{Environment flushleft not available in Novelette. Ignored.}}
\def\flushright{\nvt@warn{Environment flushright not available in Novelette. Ignored.}}
\let\endflushleft\relax\let\endflushright\relax
\def\nvt@centering{\let\\\@centercr\rightskip\@flushglue\leftskip\@flushglue\parfillskip\z@skip}
\long\def\nvt@center{\trivlist\nvt@centering\item\relax}
\let\nvt@endcenter\endcenter
\long\def\center{\nvt@warn{%%
  \spii The center environment, and \string\centering, cannot be used in Novelette.^^J%%
  \spii The block environment has [align=center] option, which serves that purpose.^^J%%
  \spii \string\defaultstyleN (N=1,2,3,4), and \string\scenestyle\space allow {align=center}.^^J%%
  \spii \string\styleN, \string\scenetext, \string\sceneimage, %%
        and \string\image\space allow [align=center].}%%
}%%
\let\endcenter\par
\let\centering\par %%%%% Maybe allow ?
\def\underline#1{#1} %% No underline!
%% End general settings.


