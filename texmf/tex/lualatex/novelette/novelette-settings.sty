\def\thesubtitle{} %% Default.
\def\subtitle#1{%%
  \ifnvt@didsubtitle\nvt@duplicatesettingtrue\fi
  \edef\nvt@rawsubtitle{\nvt@expdet{#1}}
  \catcode`\#=12 \catcode`\$=12 \catcode`\%=12 \catcode`\&=12
  \directlua{nvt.parsemeta('\luaescapestring{\nvt@rawsubtitle}', 'subtitle')}
  \catcode`\#=6 \catcode`\$=3 \catcode`\%=14 \catcode`\&=4
  \ifnum\tmpreturn=0\relax
    \nvt@fatal{Bad setting for \string\subtitle. Unmatched parentheses ().}%%
  \else
    \edef\thesubtitle{\tmpsubtitle}
  \fi
  \nvt@didsubtitletrue
