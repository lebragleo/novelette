%% MODE:
%%   The mode determines what the compiler will do, in the event of error or warning.
%% Choices: draft preview final (also dev and usl for developer only).
%%   In draft mode (default), a few inspections are not performed, possibly saving time.
%% PDF/X is disabled, and the metadata title is prefixed by DRAFT.
%%   In preview mode, all inspections are performed. The metadata title is prefixed by PREVIEW.
%% PDF/X is disabled. Use preview mode for final check, and for circulating a copy to editors.
%%   In final mode, all inspections are performed. If success, PDF/X is enabled upon request.
%% Your document is as ready as it can get.
%%   When draft, preview, or final mode fails with error/warning/badbox, the metadata title
%% is prefixed with BAD DRAFT, and PDF/X is disabled. This reduces the likelihood that you will
%% upload a bad result to your print service.
\newif\ifnvt@draft\nvt@drafttrue \def\nvt@titleprefix{DRAFT: } %% Default.
\newif\ifnvt@usl
\newif\ifnvt@dev
\newif\ifnvt@preview
\newif\ifnvt@final
\newif\ifnvt@didmode
\def\mode#1{%%
  \ifnvt@didmode\nvt@duplicatesettingtrue\fi
  \def\tmpmode{draft}
  \directlua{nvt.parsemode('\luaescapestring{#1}')}
  \ifnum\tmpreturn=0\relax
    \typeout{^^JFATAL ERROR: Bad setting for \string\mode.^^J%%
      Choices: draft preview final. Default draft.}%% usl, dev for developer only.
    \batchmode \read-1 to \sorry
  \else
    \def\tmptest{preview}\ifx\tmpmode\tmptest
      \nvt@draftfalse\nvt@previewtrue\def\nvt@titleprefix{PREVIEW: }
    \fi
    \def\tmptest{final}\ifx\tmpmode\tmptest
      \nvt@draftfalse\nvt@finaltrue\def\nvt@titleprefix{}
    \fi
    \def\tmptest{dev}\ifx\tmpmode\tmptest
      \nvt@draftfalse\nvt@devtrue\def\nvt@titleprefix{DEV TEST: }
    \fi
    \def\tmptest{usl}\ifx\tmpmode\tmptest\nvt@draftfalse\nvt@usltrue\fi
  \fi
  \nvt@didmodetrue
}%%
\@onlypreamble\mode
%%


%% TRIM SIZE: \trimsize{width=W,height=H}
%%   W and H must have units, either in (inches) or mm (millimters). Same units for both.
%% Both W and H have upper and lower limits. H must exceed W by a certain amount.
%%   Default width=5.5in,height=8.5in, a common size for print-on-demand un USA. If you set
%% either of width or height, then you must also set the other.
\newlength\nvt@trimwidth \newlength\nvt@trimheight
\setlength\nvt@trimwidth{5.5in} \setlength\nvt@trimheight{8.5in} %% Default.
\newif\ifnvt@metric %% Becomes true if W and H use metric units.
\newif\ifnvt@didtrimsize
\DeclareDocumentCommand\trimsize{m}{%% Ignored when mode=usl.
  \ifnvt@didtrimsize\nvt@duplicatesettingtrue\fi
  \def\tmptw{5.5in}\def\tmpth{8.5in}
  \directlua{nvt.parsetrimsize('\luaescapestring{#1}')}
  \ifnum\tmpreturn=0\relax
    \nvt@fatal{Bad setting for \string\trimsize.^^J%%
      \spii Format: \string\strimsize{width=W,height=H}^^J%%
      \spiv W -> Width of finished pages. Default 5.5in.^^J%%
      \spiv H -> Height of finished pages. Default 8.5in.^^J%%
      \spix W and H require units, in (inches) or mm (millimeters).^^J%%
      \spix Whatever units you use, must be the same for both.^^J%%
      \spix W and H have minimum and maximum values, which accomodate widely-used^^J%%
      \spix British and American book sizes for print-on-demand popular fiction.^^J%%
      \spix But W and H do not accomodate very small, or business paper sizes.^^J%%
      \spix H must exceed W by a certain amount. See Novelette docs for info.}%%
  \else
    \setlength\nvt@trimwidth{\tmptw}
    \setlength\nvt@trimheight{\tmpth}
    \edef\nvt@trimtext{#1}
  \fi
}%%
\trimsize{width=5.5in,height=8.5in} %% Default.
\nvt@didtrimsizefalse
\@onlypreamble\trimsize
%%


%% LAYOUT: \layout{lines=L,pagestyle=P,glue=G,cpl=C}
%%   This sets the page arrangement. Anything omitted uses its default.
\newif\ifnvt@moreglue %% Becomes true if \layout{glue=wide}. 
\def\nvt@lines{35}\def\nvt@charperline{66} %% Defaults.
\def\nvt@pagestyle{marcen} %% Default.
\newif\ifnvt@didlayout
\DeclareDocumentCommand\layout{m}{%%
  \ifnvt@didlayout\nvt@duplicatesettingtrue\fi
  \def\tmplines{35}\def\tmpps{marcen}\def\tmpmoreglue{0}\def\tmpc{66}
  \directlua{nvt.parselayout('\luaescapestring{#1}')}
  \ifnum\tmpreturn=0\relax
    \nvt@fatal{Bad setting for \string\layout.^^J%%
      \spii Format: \string\layout{lines=L,pagestyle=P,glue=G,cpl=C}^^J%%
      \spiv L -> Lines per page (main textblock). Integer 26<=L<=35. Default 35.^^J%%
      \spiv P -> Pagestyle: plain split center margin marcen. Default marcen.^^J%%
      \spix Determines presence/absence and style of header and footer.^^J%%
      \spiv G -> Glue strip at spine. Choices: normal wide. Default normal.^^J%%
      \spiv C -> Characters per line of text (estimated average). Default 66.^^J%%
      \spix Range 62-70. Automatically adjusts em size or textwidth.}%%
  \else
    \edef\nvt@lines{\tmplines}
    \edef\nvt@pagestyle{\tmpps}
    \edef\nvt@layout{#1}
    \ifnum\tmpmoreglue=1\relax\global\nvt@moregluetrue\fi
    \edef\nvt@charperline{\tmpc}
  \fi
  \nvt@didlayouttrue
}%%
\layout{lines=35,pagestyle=margin,glue=normal,cpl=66} %% Default.
\nvt@didlayoutfalse
\@onlypreamble\layout
%%


%% PDF/X: \pdfx{setting}
%%   In final mode, a good compile produces PDF/X-1a:2001. This is the format preferred by most
%% print-on-demand services, because it is the closest to "digital paper".
%%   Althout Output Intent is irrelevant to generic black-ink printing, it must be provided
%% to comply with the format. If you set \lang{en-US} or default \lang{en}, the Output Intent
%% will be CGATS TR 001, better known as "U.S. Web Coated (SWOP) v2". For \lang{en-UK}
%% or any other language, the Ouput Intent will be FOGRA39. No *.icc color profile is attached.
%%   If you prefer, you may use \pdfx{swop} or \pdfx{fogra} to force the specific Output Intent,
%% regardless of \lang setting. Or you may use \pdfx{off} to disable PDF/X-1a:2001.
%%   Novelette does not normally add XMP metadata, becuse PDF/X-1a:2000 does not specify it.
%% But if your print service requests it, use \enable{xmp} to get it.
%%   In draft or preview mode, or if a bad PDF is forced to draft, the PDF will not declare PDF/X,
%% will not declare an Ouput Intent, and will not add XMP, regardless of settings.
\def\nvt@oi{fogra} %% Default Output Intent FOGRA39. Becomes SWOP if \lang{en-US}.
\newif\ifnvt@pdfx\nvt@pdfxtrue %% Default PDF/X-1a:2001.
\newif\ifnvt@didpdfx
\def\pdfx#1{
  \ifnvt@didpdfx\nvt@duplicatesettingtrue\fi
  \def\tmpoi{fogra}
  \directlua{nvt.parsepdfx('\luaescapestring{#1}')}
  \ifnum\tmpreturn=1\relax
    \edef\nvt@oi{\tmpoi}\ifx\tmpoi\@empty\nvt@pdfxfalse\fi
  \else
    \nvt@err{Bad setting for \string\pdfx{choice}.^^J%%
      \spii Choose one of: fogra swop off. Default fogra or swop, depending on \string\lang.}
  \fi
  \nvt@didpdfxtrue
}%%
\@onlypreamble\pdfx
%%


%% CONTENT OF HEADER TEXTS:
%%   If layout uses a header, these settings determine what prints there. Regardless of layout,
%% default behavior does not print headers in frontmatter or backmatter, or above the first page
%% of a component (for this, local over-ride with component option).
%%   The header texts may use commands such as \smcp and \textit, in the usual fashion. They will
%% be applied if the header font has them; otherwise, they will be silently ignored.
%%   Most print-on-demand services insist that the title and author be the same, wherever they
%% are printed. That includes page headers. For most popular fiction novels, this is not an issue.
%% So \versohead and \rectohead are global, and cannot be changed locally (other than empty).
%%   That could be an issue if your book is a collection of short stories, because you cannot
%% locally change headers to match story titles or authors. In this case, choose a book title
%% that generically encompasses all of the stories, such as "Tales From Whereville" or
%% "Twenty Escapes", and perhaps list official author as editor: "Joe Schmo, Ed.".
%%   Traditional publishing allows changing headers, because copies are made in a production run,
%% and persons familiar with the book can inspect the results. P.O.D. does not do it that way.
\def\nvt@versohead{Verso Header Text} %% Default.
\def\nvt@rectohead{Recto Header Text} %% Default.
\newif\ifnvt@didversohead
\newif\ifnvt@didrectohead
\def\versohead#1{%% Ignored when page payout has no header.
  \ifnvt@didversohead\nvt@duplicatesettingtrue\fi
  \nvt@didversoheadtrue
  \def\nvt@versohead{#1}
}%%
\def\rectohead#1{%% Ignored when page payout has no header.
  \ifnvt@didrectohead\nvt@duplicatesettingtrue\fi
  \nvt@didrectoheadtrue
  \def\nvt@rectohead{#1}%%
}%%
%% Hackers: If you comment-out these two \@onlypreamble, then you can re-set the header texts
%% using \versohead and \rectohead between components. Do that at your own risk!
%% Print-on-demand usually insists that page header text must not change.
\@onlypreamble\versohead
\@onlypreamble\rectohead
%%


%% DEFAULT STYLES for \name, \subname, \scene, \footnote, page header/footer: 
%%   The \name, \subname, and \scene commands have global default styles. Each default may be
%% changed in Preamble. Locally, each style may be changed via command option.
%%   You may globally change how the first line of footnotes is indented. But there is no
%% local option. 
%%   The \layout setting determines whether pages have headers and/or footers, and the header
%% (if used) is placed. But it does not set the style of text and page numbers. You may set
%% the default style. There is no local option, although other factors determine whether or not
%% the header/footer actually prints on a particular page.
\newif\ifnvt@didheadstyle
\def\nvt@headfn{main}\def\nvt@headfont{\normalfont}
\def\nvt@headcn{dflt}\def\nvt@headraw{RawFeature={+titl}}
\def\nvt@headscale{.93}\def\nvt@headtrack{2}
\def\nvt@headfeat{\nvt@aff{\nvt@headraw,Scale=\nvt@headscale,LetterSpace=\nvt@headtrack}}
\def\nvt@pnfeat{\nvt@aff{\nvt@headraw,Scale=\nvt@headscale}}
\def\nvt@pndn{bar}\def\nvt@pndeco{}
\DeclareDocumentCommand\headstyle{m}{%%
  \ifnvt@didheadstyle\global\nvt@duplicatesettingtrue\fi
  \begingroup
  \def\tmpfn{-1}\def\tmpcase{-1}\def\tmpdn{-1}
  \def\tmpscale{}\def\tmptrack{}\def\tmpsp{.21}
  \directlua{nvt.parseheadstyle('\luaescapestring{#1}')}
  \ifnum\tmpfn=0\relax\gdef\nvt@headfn{main}\gdef\nvt@headfont{\normalfont}\fi
  \ifnum\tmpfn=1\relax\gdef\nvt@headfn{dark}\gdef\nvt@headfont{\nvt@dark}\fi
  \ifnum\tmpfn=2\relax\gdef\nvt@headfn{thick}\gdef\nvt@headfont{\nvt@thick}\fi
  \ifnum\tmpfn=3\relax\gdef\nvt@headfn{heavy}\gdef\nvt@headfont{\nvt@heavy}\fi
  \ifnum\tmpfn=4\relax\gdef\nvt@headfn{wide}\gdef\nvt@headfont{\nvt@wide}\fi
  \ifnum\tmpfn=5\relax\gdef\nvt@headfn{srir}\gdef\nvt@headfont{\nvt@srir}\fi
  \ifnum\tmpfn=6\relax\gdef\nvt@headfn{gero}\gdef\nvt@headfont{\nvt@gero}\fi
  \ifnum\tmpfn=7\relax\gdef\nvt@headfn{black}\gdef\nvt@headfont{\nvt@black}\fi
  \ifnum\tmpfn=8\relax\gdef\nvt@headfn{thin}\gdef\nvt@headfont{\nvt@thin}\fi
  \ifnum\tmpfn=9\relax\gdef\nvt@headfn{icel}\gdef\nvt@headfont{\nvt@icel}\fi
  \ifnum\tmpfn=10\relax\gdef\nvt@headfn{plas}\gdef\nvt@headfont{\nvt@plas}\fi
  \ifx\tmpscale\@empty\else\xdef\nvt@headscale{\tmpscale}\fi
  \ifx\tmptrack\@empty\else\xdef\nvt@headtrack{\tmptrack}\fi
  \xdef\nvt@headsp{\fpeval{\nvt@headscale*(\tmpsp + .02*\nvt@headtrack)}em}
  \ifnum\tmpcase=0\relax\gdef\nvt@headcn{none}\gdef\nvt@headraw{}\fi
  \ifnum\tmpcase=1\relax\gdef\nvt@headcn{smcp}\gdef\nvt@headraw{RawFeature={+smcp}}\fi
  \ifnum\tmpcase=2\relax\gdef\nvt@headcn{onum}\gdef\nvt@headraw{RawFeature={+onum}}\fi
  \ifnum\tmpcase=3\relax\gdef\nvt@headcn{smon}\gdef\nvt@headraw{RawFeature={+smcp,+onum}}\fi
  \ifnum\tmpcase=4\relax\gdef\nvt@headcn{titl}\gdef\nvt@headraw{RawFeature={+titl}}\fi
  \ifnum\tmpcase=5\relax\gdef\nvt@headcn{dflt}\gdef\nvt@headraw{RawFeature={+titl,+cv22}}\fi
  \ifnum\tmpdn=0\relax\gdef\nvt@pndn{none}\gdef\nvt@pndeco{}\fi
  \ifnum\tmpdn=1\relax\gdef\nvt@pndn{bar}\gdef\nvt@pndeco{|}\fi
  \ifnum\tmpdn=2\relax\gdef\nvt@pndn{bullet}\gdef\nvt@pndeco{\char"2022}\fi
  \ifnum\tmpdn=3\relax\gdef\nvt@pndn{square}\gdef\nvt@pndeco{\char"25AA}\fi
  \ifnum\tmpdn=4\relax\gdef\nvt@pndn{lozenge}\gdef\nvt@pndeco{\char"25CA}\fi
  \ifnum\tmpdn=5\relax\gdef\nvt@pndn{dash}\gdef\nvt@pndeco{{\nvt@headfeat\char"2013}}\fi
  \gdef\nvt@headfeat{\nvt@aff{\nvt@headraw,Scale=\nvt@headscale,LetterSpace=\nvt@headtrack}}
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad setting for \string\headstyle.^^J%%
      \spii Format: \headstyle{font=F,scale=S,track=T,deco=D,case=C}^^J%%
      \spiv F -> main dark thick heavy black thin srir gero icel plas. Default main.^^J%%
      \spiv S -> Decimal number 0.83-1. Default 0.93.^^J%%
      \spiv T -> Integer 0-9. Tracking, from tight to very loose. Default 2.^^J%%
      \spiv D -> bar bullet square lozenge dash none. Default none.^^J%%
      \spix Some layouts over-ride the choice for D.^^J%%
      \spiv C -> head titl smcp onum smon none. Ignored unless font=main.^^J%%
      \spix dflt -> Default. Uppercase/lowercase all become titling size. Best.^^J%%
      \spix titl -> Lowercase letters become titling caps.^^J%%
      \spix smcp -> Lowercase letters become small caps.^^J%%
      \spix onum -> Numerals become oldstyle.^^J%%
      \spix smon -> Combines smcp and onum.^^J%%
      \spix none -> No changes.}%%
  \fi
  \global\nvt@didheadstyletrue
  \endgroup
}%%
%%
\newif\ifnvt@didnamestyle
\DeclareDocumentCommand\namestyle{m}{%%
  \ifnvt@didnamestyle\global\nvt@duplicatesettingtrue\fi
  \begingroup
  \def\tmpfn{-1}\def\tmpcase{-1}\def\tmpalign{-1}\def\tmpauto{-1}
  \def\tmpscale{}\def\tmptrack{}
  \directlua{nvt.parsenamestyle('\luaescapestring{#1}')}
  \ifnum\tmpfn=0\relax\gdef\nvt@namefn{main}\gdef\nvt@namefont{\normalfont}\fi
