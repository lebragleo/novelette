%% LOAD FONT FOR LATER USE:
%%   The Serif fonts are always loaded. A Sans or Deco font is loaded if a setting requests it.
%% But If a local command requests a font that was not already loaded, error. This command
%% loads a font that would not otherwise be loaded, so it can be used later.
%% Use one or more comma-separated font codes, such as \loadfont{dark,heavy}.
\DeclareDocumentCommand\loadfont{m}{%%
  \directlua{nvt.parseloadfont('\luaescapestring{#1}')}
  \ifnum\tmpreturn=0\relax
    \nvt@fatal{Bad setting for \string\loadfont.^^J%%
      \spii Format: \string\loadfont{comma,separated,codes}^^J%%
      \spii Choose codes from among the Novelette 'font codes'.^^J%%
      \spii For all of them: all.}%%
  \fi
}%%
\let\loadfonts\loadfont
\@onlypreamble\loadfont
\@onlypreamble\loadfonts
