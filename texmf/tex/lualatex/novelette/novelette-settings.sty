%% DEVCODE:
%%   For experts only. If you wish to hack Novelette by adding code, you may place your code
%% in an external file with extension '.tex' or '.lua'. No other file extension! The file must be
%% located in folder named 'devcode' relative to main document.
%%   The file is named as a Preamble setting, but not loaded until late in AtBeginDocument,
%% after other settings have been processed and Novelette macros defined. At that moment,
%% the # may still be used as argument number, but @ $ ^ & _ are catcode 12 "other" text.
%%   Only one file may be loaded. It may not chain-load other files (no \input).
\def\devcode#1{%% Name of file (no path), with extension 'tex' or 'lua'.
  \directlua{nvt.parsedevcode('\luaescapestring{#1}')}
  \ifnum\tmpreturn=0
    \nvt@fatal{Bad \string\devcode{file} setting.^^J%%
      \spii The file must have '.tex' or '.lua' file extension.^^J%%
      \spii It must be located in folder 'devcode' relative to main document.^^J%%
      \spii Do not write its path. At this point, only the setting was checked.^^J%%
      \spii The file existence, or its code validity, has not yet been checked.}%%
  \fi
}%%
