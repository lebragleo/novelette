\newif\ifnvt@didversion
\def\theversion{} %% Default.
\def\version#1{%%
  \ifnvt@didversion\nvt@duplicatesettingtrue\fi
  \edef\nvt@rawversion{\nvt@expdet{#1}}
  \catcode`\#=12 \catcode`\$=12 \catcode`\%=12 \catcode`\&=12
  \directlua{nvt.parsemeta('\luaescapestring{\nvt@rawversion}', 'version')}
  \catcode`\#=6 \catcode`\$=3 \catcode`\%=14 \catcode`\&=4
  \ifnum\tmpreturn=0\relax
    \nvt@fatal{Bad setting for \string\version. Unmatched parentheses ().}%%
  \else
    \edef\theversion{\tmpversion}
  \fi
  \nvt@didversiontrue
}%%
\@onlypreamble\subtitle %% \title and \author are already in \@onlypreamble.
\@onlypreamble\docdate
\@onlypreamble\version
