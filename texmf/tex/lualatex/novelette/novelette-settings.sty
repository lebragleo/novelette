  \fi
  \ifnum\tmpreturn=0\relax
    \nvt@fatal{Bad setting for \string\author. Unmatched parentheses ().}%%
  \else
    \edef\theauthor{\tmpauthor}
  \fi
}%%
\author{Anonymous Author} %% Default.
\directlua{nvt.didauthor=0}
