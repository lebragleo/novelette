%% PDF/X: \pdfx{setting}
%%   In final mode, a good compile produces PDF/X-1a:2001. This is the format preferred by most
%% print-on-demand services, because it is the closest to "digital paper".
%%   Althout Output Intent is irrelevant to generic black-ink printing, it must be provided
%% to comply with the format. If you set \lang{en-US} or default \lang{en}, the Output Intent
%% will be CGATS TR 001, better known as "U.S. Web Coated (SWOP) v2". For \lang{en-UK}
%% or any other language, the Ouput Intent will be FOGRA39. No *.icc color profile is attached.
%%   If you prefer, you may use \pdfx{swop} or \pdfx{fogra} to force the specific Output Intent,
%% regardless of \lang setting. Or you may use \pdfx{off} to disable PDF/X-1a:2001.
%%   Novelette does not normally add XMP metadata, becuse PDF/X-1a:2000 does not specify it.
%% But if your print service requests it, use \enable{xmp} to get it.
%%   In draft or preview mode, or if a bad PDF is forced to draft, the PDF will not declare PDF/X,
%% will not declare an Ouput Intent, and will not add XMP, regardless of settings.
\def\nvt@oi{fogra} %% Default Output Intent FOGRA39. Becomes SWOP if \lang{en-US}.
\newif\ifnvt@pdfx\nvt@pdfxtrue %% Default PDF/X-1a:2001.
\def\pdfx#1{
  \def\tmpoi{fogra}
  \directlua{nvt.parsepdfx('\luaescapestring{#1}')}
  \ifnum\tmpreturn=-1\relax
    \nvt@warn{Duplicate setting for \string\pdfx. First obeyed, others ignored.}
  \fi
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad setting for \string\pdfx{choice}.^^J%%
      \spii Choose one of: fogra swop off. Default fogra or swop, depending on \string\lang.}
  \fi
}%%
\@onlypreamble\pdfx
%%


%% CONTENT OF HEADER TEXTS:
%%   If layout uses a header, these settings determine what prints there. Regardless of layout,
%% default behavior does not print headers in frontmatter or backmatter, or above the first page
%% of a component (for this, local over-ride with component option).
%%   The header texts may use commands such as \smcp and \textit, in the usual fashion. They will
%% be applied if the header font has them; otherwise, they will be silently ignored.
%%   Most print-on-demand services insist that the title and author be the same, wherever they
%% are printed. That includes page headers. For most popular fiction novels, this is not an issue.
%% So \versohead and \rectohead are global, and cannot be changed locally (other than empty).
%%   That could be an issue if your book is a collection of short stories, because you cannot
%% locally change headers to match story titles or authors. In this case, choose a book title
%% that generically encompasses all of the stories, such as "Tales From Whereville" or
%% "Twenty Escapes", and perhaps list official author as editor: "Joe Schmo, Ed.".
%%   Traditional publishing allows changing headers, because copies are made in a production run,
%% and persons familiar with the book can inspect the results. P.O.D. does not do it that way.
\def\nvt@versohead{Verso Header Text} %% Default.
\def\nvt@rectohead{Recto Header Text} %% Default.
\newif\ifnvt@didversohead
\newif\ifnvt@didrectohead
\def\versohead#1{%% Ignored when page payout has no header.
  \ifnvt@didversohead
    \nvt@warn{Duplicate setting for \string\versohead. First obeyed, others ignored.}
  \fi
  \nvt@didversoheadtrue
  \def\nvt@versohead{#1}
}%%
\def\rectohead#1{%% Ignored when page payout has no header.
  \ifnvt@didrectohead
    \nvt@warn{Duplicate setting for \string\rectohead. First obeyed, others ignored.}
  \fi
  \nvt@didrectoheadtrue
  \def\nvt@rectohead{#1}%%
}%%
%% Hackers: If you comment-out the following two \@onlypreamble, and you comment-out the above
%% lines \nvt@didversoheadtrue, and \nvt@didrectoheadtrue, then you can re-set the header texts
%% using \versohead and \rectohead between components. Do that at your own risk!
%% Print-on-demand often insists that page header texts must not change.
\@onlypreamble\versohead
\@onlypreamble\rectohead
