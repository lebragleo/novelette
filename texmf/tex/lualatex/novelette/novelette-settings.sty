%% DEFAULT STYLES for \style1, \style2, \style3, \style4: 
%%   These commands have global defaults, which may be locally changed by option. If you do not
%% like the built-in global defaults, you may change them.
\DeclareDocumentCommand\defaultstyle{mm}{%%
  \directlua{nvt.parsedefaultstyle('\luaescapestring{#1}','\luaescapestring{#2}')}
  %%%% get the space
  \ifnum\tmpreturn=-1\relax
    \nvt@warn{One or more duplicate \string\defaultstyle settings. Duplicates ignored.}
  \fi
  \ifnum\tmpreturn=0\relax
    \nvt@err{Bad setting for \string\defaultstyleN.^^J%%
      \spii Format: \string\defaultstyleN{font=F,scale=S,track=T,align=A,case=C}^^J%%
      \spii The N is one of 1 2 3 4. Not the letter N or n.^^J%%
      \spiv F -> One of the Novelette 'font codes'. Default main.^^J%%
      \spiv S -> Decimal number 1-4. Default varies.^^J%%
      \spiv T -> Integer 0-9. Tracking, from tight to very loose. Default 2.^^J%%
      \spiv A -> center left right. Default center.^^J%%
      \spiv C -> none titl smcp onum smon. Default none. Ignored unless font=main.^^J%%
      \spix none -> No changes. Default.^^J%%
      \spix titl -> Lowercase letters become titling caps.^^J%%
      \spix smcp -> Lowercase letters become small caps.^^J%%
      \spix onum -> Numerals become oldstyle.^^J%%
      \spix smon -> Combines smcp and onum.}%%
  \fi
}%%
\defaultstyle1{font=main,scale=2,track=2,align=center,case=none}
\defaultstyle2{font=main,scale=1.4,track=2,align=center,case=none}
\defaultstyle3{font=main,scale=1.2,track=2,align=center,case=none}
\defaultstyle4{font=main,scale=1.1,track=2,align=center,case=none}
\directlua{nvt.didstyle1=0;nvt.didstyle2=0;nvt.didstyle3=0;nvt.didstyle4=0}
