}%%
%% epigraph? thanks? dedication?
\def\quote{\nvt@noquotecmd{quote}}
\def\quotation{\nvt@quotecmd{quotation}}
\def\verse{\nvt@noquotecmd{verse}}
\def\nvt@nographicscmd#1{%%
  \nvt@fatal{You cannot use '#1' command or environment in Novelette.^^J%%
    \spii Novelette has its own method for placing images: the '\string\image' command.^^J%%
