}%%
\def\figure{\nvt@nographicscmd{figure}}
\def\caption{\nvt@nographicscmd{\string\caption}}
\def\includegraphics{\nvt@nographicscmd{\string\includegraphics}}
\def\graphicspath#1{\nvt@nographicscmd{\string\graphicspath}}
