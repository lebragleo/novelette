%% Small text, for footnotes and some block environments:
%%   Novelette does not honor standard LaTeX font size commands, such as \small.
%% Reduced-size text may only be used in footnotes (required there), and in the block environment
%% when the block is in a display zone, and the [small] option is set.
%%   The NoveletteSerif10 fonts are designed to be stylistically compatible with NoveletteSerif12,
%% at Scale=.875. They are loaded that way. This method ensures that variations in main font size,
%% due to different layouts, are proportionately followed at small size.
%%   In usage, vspace and struts are used above and below the small text, to ensure that there
%% is standard clearance to surrounding normal-size text.
\def\nvt@small{\nvt@sffamily\setlength\baselineskip{.875\nvt@bls}}
