%% The \kern macro is hard to read, and unfortunately allows absolute lengths.
%% Typical vertical stem width is about .08em. \sk{number} kerns that number of typical stems.
%% Value of the number is likely to be in the range -.5 to .5 without units.
\DeclareDocumentCommand\sk{m}{%%
  \begingroup%%
  \directlua{nvt.parsesk('\luaescapestring{#1}')}%% also do the math
  \ifnum\tmpreturn=1\relax%%
    \kern\tmpkern em%%
  \else%%
    \nvt@warn{Bad value for \string\sk{value}. Must be number, without units.^^J%%
      \spii Braces are required. See Novelette docs.}%%
  \fi%%
