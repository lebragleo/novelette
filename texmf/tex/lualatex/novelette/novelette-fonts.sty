%% Novelette re-defines some spacing macros, so that the actual character is inserted.
%% This allows fonts to internally kern against these characters. They are still glue,
%% but only stretch as characters stretch, not as spaces stretch.
\protected\def~{%%
  \ifincsname%%
    \expandafter~%%
  \else%%
    \ifnvt@real%%
      \detokenize{~}%%
    \else%%
      \leavevmode\nobreak\hspace{.12em plus .06em minus .1em}%%
    \fi%%
  \fi%%
}%%
\def\,{\leavevmode\nobreak\hspace{.12em plus .06em minus .1em}}
\def\:{\leavevmode\nobreak\hspace{.12em plus .06em minus .1em}}
\def\;{\leavevmode\nobreak\hspace{.12em plus .06em minus .1em}}
