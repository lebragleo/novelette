%% UNICODE SYMBOLS:
%%   Since Novelette has no math, and limited choice of language, many standard LaTeX symbols
%% cannot be used. This code provides human-friendly error messages.
\def\DeclareUnicodeSymbol#1#2{%%
  \iffontchar\font #2\relax%%
    \DeclareTextSymbol{#1}{TU}{#2}%%
  \else%%
    \def#1{%%
      \nvt@warn{\string#1\space not defined in Novelette. Character is not in the fonts.}%%
      \char"FFFD\relax%%
    }%%
  \fi%%
}%%
