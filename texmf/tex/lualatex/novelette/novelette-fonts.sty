%% REPLACEMENTS FOR 'tlig' FEATURE:
%%   Unfortunately, the built-in 'tlig' feature always converts " to right curly quotes.
%% That is, there are no "smart quotes". Although there have been coding attempts, "smart quotes"
%% are likely to fail, due to language-specific and writer-specific usage. Even word processors
%% will sometimes get them wrong.
%%   Novelette does not use the 'tlig' font feature. Its fonts have the 'tlig' substitutions and
%% ligatures built-in, with the exception of substituting quotedblright for quotedbl.
%%   After a page is typeset, Lua inspects it for the presence of " characters. If any are seen,
%% that is a problem. This does not affect code such as \char"2010 because the " is not typeset.
%%   If you need the actual " character, \real{"} does the job. It typesets a character that
%% looks and behaves like ordinary ", but is at a Unicode location where the Lua inspection
%% does not see it as the " character. \real{`} and \real{'} are also available. This behavior
%% relies on properties of the custom fonts.
%%   Also, the fonts interpret ``` and ''' as (single nested within double) at both ends,
%% but \enable{britq} changes the interpretation to (double nested within single). This does not
%% switch single/double, but only affects how the triple symbols are interpreted.
%%   Alas, many word processors interpet -- as emdash, instead of --- in TeX. To reduce the
%% likelihood of error when files are exchanged, (emdash hyphen) is reduced to emdash. 



%% Define the fonts, with default features:
%% 'ccmp' breaks single-character IJ and ij into their two characters.
%% 'ccmp' breaks single-character ff fi fl ffi ffi st into their two characters.
%% 'liga' corrects possible problems with hyphens/dashes. It does not apply ff-style ligatures.
%% 'ss03' changes whether ``` and ''' and ,,, are interpreted as American or British outer quotes.
\adjustspacing=2 \protrudechars=2
\emergencystretch=.5em
%% LaTeX protrusion is supposed to make the margins appear straighter, by leaking glyphs into
%% the margins. Bah! Never seen in popular fiction. Instead, the goal of Novelette is to prevent
%% glyphs from leaking into the margins. Thus, negative protrusion for a few glyphs.
\ifnvt@britq
  \def\tmpfeat{RawFeature={ccmp,rlig,calt,dlig,ss03}}
\else
