%% Only NoveletteSerif12-Regular and NoveletteSerif10-Regular have small caps. Numerals default
%% to lining, but these fonts (also Italic) have oldstyle feature.
%%   Setting \disable{oldstyle} neutralizes \onum (its text is printed, but not oldstyle).
%% Then, if you use \onum repeatedly, but change your mind, you do not have to edit-out
%% all of the \onum commands.
\long\def\onum#1{\ifnvt@nooldstyle{#1}\else{\nvt@aff{RawFeature={+onum}}#1}\fi}
%% \SMCP converts uppercase and lowercase to small caps. May also use \onum.
\long\def\SMCP#1{{\nvt@aff{RawFeature={+c2sc,+smcp}}#1}}%%
\let\Smcp\SMCP %% Convenience.
%% \smcp converts only lowercase to small caps. Also numerals to oldstyle (even if disabled).
\long\def\smcp#1{{\nvt@aff{RawFeature={+smcp}}#1}}
%% Some combinations, such as 3-7 or M-H, automatically raise the hyphen to uppercase height.
%% This also applies to dashes and some symbols. But if the automatic change is wrong,
%% you may manually fix it, using \up{char} or \dn{char}, like this: P\up{-}Q, 2\dn{+}2.
\long\def\up#1{{\nvt@aff{RawFeature={+case}}#1}}
\let\case\up %% Alias.
\long\def\dn#1{{\nvt@aff{RawFeature={-case}}#1}}
\let\down\dn %% Alias.
\newif\ifnvt@initalic %% True within \textit. %%%%%
\let\nvt@origtextit\textit
\long\def\textit#1{\nvt@origtextit{#1\nvt@initalictrue}}
\let\it\textit %% Alias.
