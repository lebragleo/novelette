\cs_new:Nn \__nvt_main_setmainfont:nn
  {
    \DeclareFontSeriesDefault[rm]{bf}{\bfdefault}
    \nvt_set_family:Nnn \l__nvt_rmfamily_family_tl {#1} {#2}
    \tl_set_eq:NN \rmdefault \l__nvt_rmfamily_family_tl
    \str_if_eq:eeT {\familydefault} {\rmdefault}
      { \tl_set:Nn \encodingdefault {TU} }
    \__nvt_setmainfont_hook:nn {#1} {#2}
    \normalfont
  }
\cs_new:Nn \__nvt_main_setsansfont:nn
  {
    \DeclareFontSeriesDefault[sf]{bf}{\bfdefault}
    \nvt_set_family:Nnn \l__nvt_sffamily_family_tl {#1} {#2}
    \tl_set_eq:NN \sfdefault \l__nvt_sffamily_family_tl
    \str_if_eq:eeT {\familydefault} {\sfdefault}
      { \tl_set:Nn \encodingdefault {TU} }
    \__nvt_setsansfont_hook:nn {#1} {#2}
    \normalfont
  }
\cs_new:Nn \__nvt_main_setmonofont:nn
  {
    \DeclareFontSeriesDefault[tt]{bf}{\bfdefault}
    \nvt_set_family:Nnn \l__nvt_ttfamily_family_tl {#1} {#2}
    \tl_set_eq:NN \ttdefault \l__nvt_ttfamily_family_tl
    \str_if_eq:eeT {\familydefault} {\ttdefault}
      { \tl_set:Nn \encodingdefault {TU} }
    \__nvt_setmonofont_hook:nn {#1} {#2}
    \normalfont
  }
\cs_set_eq:NN \__nvt_setmainfont_hook:nn   \use_none:nn
\cs_set_eq:NN \__nvt_setsansfont_hook:nn   \use_none:nn
\cs_set_eq:NN \__nvt_setmonofont_hook:nn   \use_none:nn
\cs_new:Nn \__nvt_main_newfontfamily:NnnN
  {
    \nvt_set_family:cnn { l__nvt_ \cs_to_str:N #1 _family_tl } {#2} {#3}
    \use:x
      {
        \exp_not:N #4 \exp_not:N #1 {}
          {
            \exp_not:N \fontfamily { \use:c { l__nvt_ \cs_to_str:N #1 _family_tl } }
            \exp_not:N \fontencoding { \g__nvt_nfss_enc_tl }
            \exp_not:N \selectfont
          }
      }
  }
\cs_new:Nn \__nvt_main_newfontface:NnnN
  {
    \bool_set_true:N \l__nvt_noit_bool
    \__nvt_main_newfontfamily:NnnN #1 {#2} {#3} #4
    \bool_set_false:N \l__nvt_noit_bool
  }
\cs_new:Nn \__nvt_set_default_features:nn
  {
    \IfBooleanTF {#1} \clist_gput_right:Nn \clist_gset:Nn
      \g__nvt_default_fontopts_clist {#2}
  }
\cs_new:Nn \__nvt_set_font_default_features:nnn
  {
    \clist_map_inline:nn {#2}
      {
        \tl_if_single:nTF {##1}
          {
            \tl_set:No \l__nvt_tmp_tl
              { \cs:w l__nvt_ \cs_to_str:N ##1 _family_tl\cs_end: }
          }
          { \__nvt_sanitise_fontname:Nn \l__nvt_tmp_tl {##1} }
        \IfBooleanTF {#1}
          {
            \prop_get:NVNF \g__nvt_fontopts_prop \l__nvt_tmp_tl \l__nvt_tmpb_tl
              { \tl_clear:N \l__nvt_tmpb_tl }
            \tl_put_right:Nn \l__nvt_tmpb_tl {#3,}
            \prop_gput:NVV   \g__nvt_fontopts_prop \l__nvt_tmp_tl \l__nvt_tmpb_tl
          }
          {
            \tl_if_empty:nTF {#3}
              { \prop_gremove:NV \g__nvt_fontopts_prop \l__nvt_tmp_tl }
              { \prop_gput:NVn    \g__nvt_fontopts_prop \l__nvt_tmp_tl {#3,} }
          }
      }
  }
\cs_new:Nn \__nvt_main_addfontfeatures:n
  {
    \group_begin:
      \keys_set_known:nnN {nvt-addfeatures} {#1} \l__nvt_tmp_tl
      \prop_get:cnN {g__nvt_fontinfo_ \f@family _prop} {options}  \l__nvt_options_tl
      \prop_get:cnN {g__nvt_fontinfo_ \f@family _prop} {fontname} \l__nvt_fontname_tl
      \bool_set_true:N \l__nvt_disable_defaults_bool
      \use:x
        {
          \__nvt_select_font_family:nn
            { \l__nvt_options_tl , #1 } {\l__nvt_fontname_tl}
        }
    \group_end:
    \fontfamily \g__nvt_nfss_family_tl \selectfont
    \ignorespaces
  }
\cs_new:Nn \__nvt_strip_plus_minus:n { \__nvt_strip_plus_minus_aux:Nq #1 \q_nil }
\cs_new:Npn \__nvt_strip_plus_minus_aux:Nq #1#2 \q_nil
  { \str_case:nnF {#1} { {+} {#2} {-} {#2} } {#1#2} }
\cs_new:Nn \__nvt_main_IfFontFeatureActiveTF:nnn
  { \__nvt_if_font_feature:nTF {#1} {#2} {#3} }
\prg_new_conditional:Nnn \__nvt_if_font_feature:n {TF}
  {
    \tl_gclear:N \g__nvt_single_feat_tl
    \group_begin:
      \__nvt_font_suppress_not_found_error:
      \__nvt_init:
      \bool_set_false:N \l__nvt_firsttime_bool
      \clist_clear:N \l__nvt_fontfeat_clist
      \__nvt_get_features:n {#1}
    \group_end:
    \tl_if_empty:NTF \g__nvt_single_feat_tl { \prg_return_false: }
      {
        \exp_args:NV \nvt_if_current_feature:nTF \g__nvt_single_feat_tl
          { \prg_return_true: } { \prg_return_false: }
      }
  }
\prg_new_conditional:Nnn \nvt_if_nvt_font: {TF,T,F}
  { \cs_if_exist:cTF {g__nvt_fontinfo_ \f@family _prop} \prg_return_true: \prg_return_false: }
\prg_new_conditional:Nnn \nvt_if_opentype: {TF,T,F}
  {
    \nvt_if_nvt_font:TF
      { \prg_return_true: } { \prg_return_false: }
  }
\prg_new_conditional:Nnn \nvt_if_feature:n {TF,T,F}
  {
    \nvt_if_nvt_font:TF
      {
        \prop_get:cnN {g__nvt_fontinfo_ \f@family _prop} {script-num} \l__nvt_tmp_tl
        \int_set:Nn \l__nvt_script_int {\l__nvt_tmp_tl}
        \prop_get:cnN {g__nvt_fontinfo_ \f@family _prop} {lang-num} \l__nvt_tmp_tl
        \int_set:Nn \l__nvt_language_int {\l__nvt_tmp_tl}
        \prop_get:cnN {g__nvt_fontinfo_ \f@family _prop} {script-tag}
        \l__nvt_script_tl
        \prop_get:cnN {g__nvt_fontinfo_ \f@family _prop} {lang-tag}
        \l__nvt_lang_tl
        \__nvt_check_ot_feat:NnnnTF \font {#1} {\l__nvt_lang_tl}
          {\l__nvt_script_tl} {\prg_return_true:} {\prg_return_false:}
      }
      { \prg_return_false: }
  }
\prg_new_conditional:Nnn \nvt_if_feature:nnn {TF,T,F}
  {
    \nvt_if_nvt_font:TF
      {
        \__nvt_check_ot_feat:NnnnTF \font {#3} {#2} {#1} \prg_return_true: \prg_return_false:
      }
      { \prg_return_false: }
  }
\prg_new_conditional:Nnn \nvt_if_script:n {TF,T,F}
  {
    \nvt_if_nvt_font:TF
      {
        \__nvt_check_script:NnTF \font {#1} \prg_return_true: \prg_return_false:
      }
      { \prg_return_false: }
  }
\prg_new_conditional:Nnn \nvt_if_language:n {TF,T,F}
  {
    \nvt_if_nvt_font:TF
      {
        \prop_get:cnN {g__nvt_fontinfo_ \f@family _prop} {script-num}
        \l__nvt_tmp_tl
        \int_set:Nn \l__nvt_script_int {\l__nvt_tmp_tl}
        \prop_get:cnN {g__nvt_fontinfo_\f@family _prop} {script-tag}
        \l__nvt_script_tl
        \__nvt_check_lang:NnTF \font {#1} \prg_return_true: \prg_return_false:
      }
      { \prg_return_false: }
  }
\prg_new_conditional:Nnn \nvt_if_language:nn {TF,T,F}
  {
    \nvt_if_nvt_font:TF
      {
        \__nvt_check_lang:NnnTF \font {#2} {#1} \prg_return_true: \prg_return_false:
      }
      { \prg_return_false: }
  }
\prg_new_conditional:Nnn \nvt_if_current_script:n {TF,T,F}
  {
    \nvt_if_nvt_font:TF
      {
        \prop_get:cnN {g__nvt_fontinfo_ \f@family _prop} {script-tag}  \l__nvt_tmp_tl
        \str_if_eq:nVTF {#1}  \l__nvt_tmp_tl
          {\prg_return_true:} {\prg_return_false:}
      }
      { \prg_return_false: }
  }
