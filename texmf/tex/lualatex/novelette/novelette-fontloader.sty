%% Commands such as \setmainfont and \addfontfeature are not available in Novelette.
%% The fonts are pre-set, with specific default features.
%% User-available features are manipulated by commands such as \smcp{text} for small caps.
%% Internal commands such as \nvt@setmainfont and \nvt@aff do the work.
%% This forces the user to do it "the Novelette way" instead of "the LaTeX way".
\NewDocumentCommand \nvt@setmainfont { O{} m O{} }
  { \__nvt_main_setmainfont:nn {#1,#3} {#2} \ignorespaces }
\NewDocumentCommand \nvt@setsansfont { O{} m O{} }
  { \__nvt_main_setsansfont:nn {#1,#3} {#2} \ignorespaces }
\NewDocumentCommand \nvt@setmonofont { O{} m O{} }
  { \__nvt_main_setmonofont:nn {#1,#3} {#2} \ignorespaces }
\NewDocumentCommand \nvt@newfontfamily { m O{} m O{} }
  { \__nvt_main_newfontfamily:NnnN #1 {#2,#4} {#3} \NewDocumentCommand }
\NewDocumentCommand \nvt@newfontface { m O{} m O{} }
  { \__nvt_main_newfontface:NnnN #1 {#2,#4} {#3} \NewDocumentCommand }
\ifnvt@imagedoc
  \NewDocumentCommand \nvt@newfontfamily { m O{} m O{} }
    { \__nvt_main_newfontfamily:NnnN #1 {#2,#4} {#3} \NewDocumentCommand }
  \NewDocumentCommand \nvt@newfontface { m O{} m O{} }
    { \__nvt_main_newfontface:NnnN #1 {#2,#4} {#3} \NewDocumentCommand }
\fi
\NewDocumentCommand \nvt@defaultfontfeatures { t+ o m }
  {
    \IfNoValueTF {#2}
      { \__nvt_set_default_features:nn {#1} {#3} }
      { \__nvt_set_font_default_features:nnn {#1} {#2} {#3} }
    \ignorespaces
  }
\NewDocumentCommand \nvt@aff {m}
  { \__nvt_main_addfontfeatures:n {#1} }
\ifnvt@imagedoc
  \NewDocumentCommand \addfontfeature {m}
  { \__nvt_main_addfontfeatures:n {#1} }
  \NewDocumentCommand \addfontfeatures {m}
  { \__nvt_main_addfontfeatures:n {#1} }
\fi
\NewDocumentCommand \IfFontFeatureActiveTF {mmm}
  { \__nvt_main_IfFontFeatureActiveTF:nnn {#1} {#2} {#3} }
