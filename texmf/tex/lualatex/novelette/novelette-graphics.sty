%% GRAPHICS:
%%   Novelette does not use standard LaTeX graphics commands, such as \includegraphics. You cannot
%% create vector (TiKz) drawings, or include eps/pdf files.
%%   The \image command places a raster png image. It must either be monochrome at 1-bit/pixel,
%% or single-channel grayscale at 8-bits/pixel. It must state its resolution (density).
%% In preview and final modes, it must also pass validation: no color profile, curves, or
%% private metadata. Novelette provides shell scripts, using ImageMagick, to ensure validation:
%% They are in the documentation utilities folder.
%%   Within a \styleN or \scene command, \image is inline, and has no options. Its height
%% is limited, to prevent adjacent lines from being pushed away. Its width is limited to
%% the textwidth less the width of any other material contained in the \styleN or \scene.
%% Its vertical middle aligns with half the scaled text uppercase Xheight.
%%   Otherwise, \image sits in its own paragraph. It is never inline with running text or
%% footnotes. An option controls how much space (number of lines) must be reserved for the image,
%% whether it floats, how it aligns horizontally, and whether its vertical position is tweaked.
%%   The command has unstarred \image and starred \image*. In preview and final modes, they are
%% the same: The file must exist, fit, and pass conformance validation. In draft mode,
%% starred \image* tests for existence and fit, but not validation; unstarred \image does
%% not look for the file, but prints a gray placeholder rectangle.
%%   If a file is too wide or tall for its area, it is not printed. Instead, a placeholder
%% rectangle prints where the file would print, and the document is demoted to draft mode.
%% Unlike standard LaTeX, an over-size image is not pushed to a later catch-all page.
%%   Full-page float is not available. Instead, place one or more images, possibly with text,
%% in their own component between chapters.
\def\ftype@figure{1} %% Standard.
\def\fps@figure{} %% No float unless requested and allowed.
\newif\ifnvt@headimagelecture %% Prevents repeated messages when image in page header.
\newlength\nvt@imagerulewd %% In dev mode, makes rule visible.
\DeclareDocumentCommand\image{sO{}m}{%%
  \begingroup\def\tmplabel{}\def\tmptweak{0}\def\tmplines{0}%%
  \def\tmpimgalign{0}\def\tmpimgleft{}\def\tmpimgright{}%%
  \def\tmpcheck{0}\def\tmpvalidate{0}\def\tmprealimage{0}\def\tmpimagefile{NONE}%%
  \ifnvt@dev\setlength\nvt@imagerulewd{2pt}\fi%%
  \ifnvt@instyle\def\tmpwhere{1}\else\def\tmpwhere{2}\fi%% 1=inline, 2=own paragraph.
  \ifnvt@inscene\def\tmpwhere{1}\fi%%
  \ifnvt@infootnote\def\tmpwhere{0}\fi%% 0=forbidden
  \ifnvt@inblock\def\tmpwhere{0}\fi%%
  \ifnvt@inheader%%
    \ifnvt@headimagelecture\else%%
      \nvt@err{Cannot place \string\image\space in page headers.^^J%%
        \spii This message is only sent once, even though it applies to many pages.}%%
      \directlua{nvt.adderr('\\image in page header.')}%%
      \global\nvt@headimagelecturetrue{\upshape\nvt@mainfont\char"2327}%%
    \fi%%
  \fi%%
  \ifnum\tmpwhere=0\relax%%
    \nvt@err{Cannot place \string\image\space in footnote, or in block environment.}%%
    {\upshape\nvt@mainfont\char"2327}%%
    \directlua{nvt.adderr('Cannot place \\image in footnote or block environment.')}%%
  \fi%%
  \IfBooleanTF{#1}{\def\tmpcheck{1}}{}%%
  \ifnvt@preview\def\tmpcheck{1}\def\tmpvalidate{1}\fi%%
  \ifnvt@final\def\tmpcheck{1}\def\tmpvalidate{1}\fi%%
  \ifnum\tmpcheck=1\relax%%
    \catcode`\~=12\relax\def\tmppath{#3}%% Otherwise, ~ in file path would be undetected here.
    \directlua{nvt.imagepath('\luaescapestring{#3}')}%%
    \ifnum\tmpimagepath=1\relax%%
      \IfFileExists{#3}{%%
        \def\tmprealimage{1}\def\tmpimagefile{#3}%%
        \@ifundefined{#3 image:I}{%%
          \saveimageresource attr{/Interpolate true}{#3}%%
          \sbox1{\useimageresource\lastsavedimageresourceindex}%%
          \expandafter\xdef\csname #3 image:I\endcsname%%
            {\useimageresource\the\lastsavedimageresourceindex}%%
          \wlog{<#3, id=\the\lastsavedimageresourceindex, interpolate=true>}%%
          \ifnum\tmpvalidate=1\relax\nvt@validateimage{#3}\fi%%
        }{%%
          \sbox1{\csname #3 image:I\endcsname}%%
        }%%
      }{%%
        \nvt@err{Missing \string\image\space file #3.^^J%%
          \spii The path and filename have correct format, but the file is not there.^^J%%
          \spii Either you mis-spelled the path or filename, or no such file.}%%
        \directlua{nvt.adderr('Missing \\image file.')}%%
        \def\tmprealimage{0}%%
      }%%
    \else%%
      \nvt@err{Bad \string\image\space path/file #3.^^J%%
        \spii There are several possibilities:^^J%%
        \spiv 1. Image filename does not have .png file extension.^^J%%
        \spiv 2. Path to image file is not relative to main document.^^J%%
        \spix Do not use path relative to sub-documents.^^J%%
        \spix Do not use absolute path, or symlink (softlink).^^J%%
        \spiv 3. Image file is not in same folder as main document,^^J%%
        \spix or in subfolder from main document (max 5 levels).^^J%%
        \spiv 4. Path or filename has forbidden characters. Among them:^^J%%
        \spix You may use hyphen or underscore, but not space or tilde.}%%
      \directlua{nvt.adderr('Bad \\image path or filename.')}%%
      \def\tmprealimage{0}%%
    \fi%%
  \fi%%
  \ifnum\tmpwhere=1\relax%% Inline, within \styleN or \scene.
    \edef\tmptwo{#2}%%
    \ifx\tmptwo\@empty\else\typeout{Alert: Ignored [option] for inline \string\image.}\fi%%
    \nvt@inlineimage{#3}%%
  \fi%%
  \ifnum\tmpwhere=2\relax\nvt@imagepar{#2}{#3}\fi%%
  \endgroup%%
}%%
%%


%% When the image is inline, inside \styleN or \scene.
\DeclareDocumentCommand\nvt@inlineimage{m}{%%
  \ifnvt@inscene%%
    \def\tmpimagemaxht{.32in}%% Allowed because blank lines above/below.
  \else%%
    \edef\tmpimagemaxht{\fpeval{.16in * \tmpscale}pt}%% \tmpscale provided by \styleN.
  \fi%%
  \ifnum\tmprealimage=1\relax%% check height and width, maybe validate
    \nvt@realimage{#1}%% Creates box1.
  \else%%
    \sbox1{{\nvt@gray{8}\rule{\tmpimagemaxht}{\tmpimagemaxht}}}%% Placeholder wd=ht.
  \fi%%
  \nvt@printimage%%
}%%
%%


%% When the image is in a paragraph by itself, it has [option]:
\DeclareDocumentCommand\nvt@imagepar{mm}{%% option, path/file.
  \ifnvt@indisplay\def\tmpfloat{0}\else\def\tmpfloat{1}\fi%%
  \ifnvt@infrontmatter\def\tmpfloat{0}\fi%%
  \ifnvt@inbackmatter\def\tmpfloat{0}\fi%%
  \par\vspace*{-\nvt@bls}\null\setlength\parindent{0pt}%% Begin paragraph.
  \catcode`\~=12\relax\def\tmpopt{#1}%% Otherwise, ~ in file path would be undetected here.
  \directlua{nvt.imageoption('\luaescapestring{\tmpopt}')}%%
  \ifnum\tmpreturn=0\relax%%
    \nvt@err{Bad \string\image\space option.^^J%%
      \spii Format: [lines=L,align=A,float=F,tweak=T]^^J%%
      \spiv L -> Integer 1<=L<=(lines per page). Must be set.^^J%%
      \spiv A -> left right center. Default center.^^J%%
      \spiv F -> none here top bottom. Choose only one.^^J%%
      \spix If here, then top is automatic backup.^^J%%
      \spix In frontmatter, backmatter, displays: default none. No other allowed.^^J%%
      \spix Elsewhere: default here.^^J%%
      \spix No page floats. Instead use single page component. Not mid-chapter.^^J%%
      \spiv T -> down up mid. Default mid.^^J%%
      \spix down ->  Bottom of image at baseline of lowest displaced line.^^J%%
      \spix up -> Top at accented uppercase height of highest displaced line.^^J%%
      \spix mid -> Splits padding above/below image.}%%
    \directlua{nvt.adderr('Bad \\image option.')}%%
  \fi%%
  \ifnum\tmpimgalign=0\relax\def\tmpimgleft{\hfill}\def\tmpimgright{\hfill}\fi%%
  \ifnum\tmpimgalign=1\relax\def\tmpimgleft{}\def\tmpimgright{\hfill}\fi%%
  \ifnum\tmpimgalign=2\relax\def\tmpimgleft{\hfill}\def\tmpimgright{}\fi%%
  \ifnum\tmplines=0\relax%%
    \nvt@err{\string\image\space requires [lines=L] option, integer 1<=L<=(lines per page).}%%
    \def\tmplines{3}%% Placeholder backup. Almost always an incorrect value.
    \directlua{nvt.adderr('\\image requires option [lines=L].')}%%
  \fi%%
  \ifnum\tmpfloat=1\relax\def\fps@figure{!ht}\fi%%
  \ifnum\tmpfloat=2\relax\def\fps@figure{!t}\fi%%
  \ifnum\tmpfloat=3\relax\def\fps@figure{!b}\fi%%
  \ifnvt@indisplay%%
    \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
    \def\fps@figure{}%%
  \fi%%
  \ifnvt@infrontmatter%%
    \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
    \def\fps@figure{}%%
  \fi%%
  \ifnvt@inbackmatter%%
    \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
    \def\fps@figure{}%%
  \fi%%
  \ifnum\tmprealimage=1\relax%%
    \nvt@realimage{#2}%%
  \else%%
    \edef\tmpimagewd{\fpeval{0.6*\textwidth}pt}%%
    \edef\tmpimageht{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls}pt}%%
    \sbox1{{\nvt@gray{8}\rule{\tmpimagewd}{\tmpimageht}}}%%
  \fi%%
  \nvt@printimage%%
  \par\vspace*{-\nvt@bls}\null%%
}%%
%%


%% Real image (if bad, defaults to placeholder):
\def\nvt@realimage#1{%%
  \def\tmpvalid{1}%%
  \ifnum\tmpvalidate=1\relax\nvt@validateimage{#1}\fi%%
  \ifnum\tmpvalid=0\relax%%
    \nvt@warn{Image file failed validation. See Novelette docs for how to fix.^^J%%
      \spii File: #1}%%
    \ifnum\tmpwhere=2\relax\def\tmplabel{failed validation}\fi%%
    \edef\tmpimagewd{\fpeval{0.6*\textwidth}pt}%%
    \edef\tmpimageht{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls}pt}%%
    \sbox1{{\nvt@gray{8}\rule{\tmpimagewd}{\tmpimageht}}}%%
  \fi%%
  \ifnum\tmpwhere=1\relax%%
    \ifnvt@inscene%%
      \edef\tmpfit{\fpeval{(\ht0 > .324in) + (\wd0 > \textwidth)}}%% .004in fuzz h.
      \ifnum\tmpfit>0\relax%%
        \nvt@warn{\string\image\space is too large. Max height=0.3in, max width=textwidth.^^J%%
          \spii File: #1}%%
        {\upshape\nvt@mainfont\char"2327}%%
      \fi%%
    \else%%
      \edef\tmpmaxfit{\fpeval{max(1.1em,0.164in)}pt}%%
      \edef\tmpfit{\fpeval{(\ht0 > \tmpmaxfit) + (\wd0 > \textwidth)}}%%
      \ifnum\tmpfit>0\relax%%
        \nvt@warn{\string\image\space is too large. Max height=0.3in, max width=textwidth.^^J%%
          \spii File: #1}%%
        {\upshape\nvt@mainfont\char"2327}%%
      \fi%%
    \fi%%
  \else%%
    \edef\tmpht{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls + .004in}pt}%% .004in fuzz
    \edef\tmpfit{\fpeval{(\ht0 > \tmpht) + (\wd0 > \textwidth)}}%% no width fuzz
    \ifnum\tmpfit>0\relax%%
      \nvt@warn{\string\image\space is too large.^^J%%
        \spii File: #1^^J%%
        \spii Reduce image width and/or height, or increase [lines=L] option.}%%
      \ifnum\tmpwhere=2\relax\def\tmplabel{oversize image}\fi%%
      \edef\tmpimagewd{\fpeval{0.6*\textwidth}pt}%%
      \edef\tmpimageht{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls}pt}%%
      \sbox1{{\nvt@gray{8}\rule{\tmpimagewd}{\tmpimageht}}}%%
    \fi%%
  \fi%%
}%%
%%


%% Print the real image or placeholder:
\def\nvt@printimage{%%
  \ifnum\tmpwhere=1\relax%%
    \edef\imgruleht{\fpeval{\nvt@bls}pt}%%
    \edef\tmppad{\fpeval{(.325*\tmpscale*\nvt@em) - (.5*\ht1)}pt}%% Mid-image at mid-Xheight.
    \def\tmplabel{}%%
  \else%%
    \edef\imgruleht{\fpeval{\tmplines*\nvt@bls}pt}%%
    \ifnum\tmptweak=0\relax\edef\tmppad{%%
      \fpeval{.5*(.84*\nvt@em+(\tmplines-1)*\nvt@bls-\ht1)}pt}%%
    \fi%%
  \fi%%
  \ifnum\tmptweak=1\relax\edef\tmppad{\fpeval{.84*\nvt@em+(\tmplines-1)*\nvt@bls-\ht1}pt}\fi%%
  \ifnum\tmptweak=2\relax\def\tmppad{0pt}\fi%%
  \ifx\fps@figure\@empty\else\@float{figure}\fi%%
  \nvt@zrule\tmpimgleft\rule{\nvt@imagerulewd}{\imgruleht}%%
  \smash{\raisebox{\tmppad}{\usebox1}}%%
  \ifx\tmplabel\@empty\else%%
    \def\tmpimagelabel{{\nvt@gray{4}\nvt@aff{RawFeature={+titl},Scale=.75}\tmplabel}}%%
    \llap{\smash{\raisebox{\tmppad}{\tmpimagelabel}}}%%
  \fi%%
  \ifnvt@instyle\else%%
    \ifnvt@inscene\else%%
      \tmpimgright\nvt@zrule\par%%
    \fi%%
  \fi%%
  \ifx\fps@figure\@empty\else\end@float\fi%%
}%%
%%


%% Image file validation:
\def\nvt@validateimage#1{%%
  \directlua{nvt.validateimage('\luaescapestring{#1}')}%%
}%%
%%



%% GRAY DEFINITIONS:
%%   Novelette does not allow grayscale text, just grayscale images. No color anywhere.
%% This code allows the developer to apply background shades of gray, for showing certain areas.
%% It also creates gray rectangles, for image placeholders. It is not used in a good final PDF.
\chardef\main@pdfcolorstack=0\relax
\@ifundefined{@pdfcolorstack}{\def\@pdfcolorstack{\main@pdfcolorstack}}{}
\def\current@color{0 g 0 G}
\def\set@color{%%
  \pdfextension colorstack\@pdfcolorstack push{\current@color}\aftergroup\reset@color%%
}%%
\def\reset@color{\pdfextension colorstack\@pdfcolorstack pop\relax}
\def\color@gray#1#2{\edef#1{#2 g #2 G}}
\long\def\nvt@gray#1{%% #1 is unbraced integer 1-9 (1=darkest, 9=lightest).
  \csname color@gray\endcsname\current@color{.#1}\set@color\ignorespaces%%
}%%
\def\nvt@luagray{%% When \enable{examine}.
  \newattribute\LuaGray@Attribute
  \let\LuaGray@setattribute\setattribute
  \directlua{nvt.setattribute(\number\allocationnumber)}
  \protected\def\set@color{%
    \LuaGray@setattribute\LuaGray@Attribute{%
      \directlua{nvt.get("\luaescapestring{\current@color}")}%
    }%
   \aftergroup\reset@color
  }
  \def\reset@color{}
  \set@color
}%%
%%


%% DEV MODE SHADING (developer only, unrelated to images):
%%   In dev mode, the margins and baselines are shaded. This helps the developer write code
%% for the size and placement of images, and for grid alignment after display.
%%   The darkest gray vertical stripe, at left of verso and right of recto, is the glue area.
%% On all sides, dark gray defines the minimum margins, where nothing may print. The top margin
%% is the minimum. The bottom margin may be minimum; but if higher, it is medium gray.
%%   Depending on trimsize and layout, the actual side margins may be wider than minimum.
%% Medium gray stripes (if present) show where the actual side margins differ from minimum.
%% Nothing may print in the actual side margins.
%%   If the layout has header and/or footer, medium gray stripes show the gaps between them
%% and the main text area. Nothing may print in those gaps.
%%   Light gray stripes show the standard baseline for each line of text, and header/footer text.
%% The top of the stripe is at baseline. Text may (and usually will) descend into the stripes.
%%   The remaining white stripes are where text (other than descenders) prints. No text may
%% rise above its area, into the descender stripe above it. In practice, it will not get close.
%%   Off-grid elements (images, and anything within display) do not obey the shaded baselines.
%% However, the following ordinary text will be restored to grid baselines.
%%   In addition, the width of image struts is changed, so the struts become visible.
\newcounter{nvt@shadecount} %% Used below.
\def\nvt@shade#1#2#3#4#5{%% #1=integer gray value, #2=LLX, #3=LLY, #4=Width, #5=Height.
  \put(1in+#2,-1in-\pageheight+#3){{\nvt@gray#1\rule{#4}{#5}}}%%
}%%
\def\nvt@devshade{%%
  \AddToHook{shipout/background}{%%
    \edef\tmptop{\fpeval{\pageheight-\topmargin}pt}%%
    \nvt@shade7{0pt}{\tmptop}{\pagewidth}{\topmargin}%% actual top margin
    \edef\tmprl{\fpeval{\tmptop-\headheight-\headsep-\nvt@bls}pt}%%
    \ifnvt@hasheader%%
      \edef\tmphs{\fpeval{\headsep-\nvt@bld}pt}%%
      \edef\tmphb{\fpeval{\tmprl+\nvt@bls}pt}%%
      \edef\tmphl{\fpeval{\tmphb+\tmphs}pt}%%
      \edef\tmphd{\fpeval{\tmphb-\nvt@bld}pt}%%
      \nvt@shade9{0pt}{\tmphl}{\pagewidth}{\nvt@bld}%% header baseline
      \nvt@shade7{0pt}{\tmphb}{\pagewidth}{\tmphs}%% headsep, gap between header and main text
      \nvt@shade9{0pt}{\tmphd}{\pagewidth}{\nvt@bld}%% virtual descender of line zero.
    \fi%%
    \setcounter{nvt@shadecount}{0}%%
    \loop%%
      \edef\tmpsl{\fpeval{\tmprl-\nvt@bld-\value{nvt@shadecount}*\nvt@bls}pt}%%
      \nvt@shade9{0pt}{\tmpsl}{\pagewidth}{\nvt@bld}%% main text baselines
      \stepcounter{nvt@shadecount}%%
    \ifnum\value{nvt@shadecount}<\nvt@lines\relax%%
    \repeat%%
    \edef\tmpbot{\fpeval{\tmptop-\headheight-\headsep-\textheight-\footskip-\nvt@bld}pt}%%
    \nvt@shade7{0pt}{0pt}{\pagewidth}{\tmpbot}%% actual bottom margin
    \ifnvt@hasfooter%%
      \edef\tmpfpm{\fpeval{\tmpsl-\footskip+\nvt@bls}pt}%%
      \edef\tmpfmm{\fpeval{\footskip-\nvt@bld-\nvt@blh}pt}%%
      \nvt@shade7{0pt}{\tmpfpm}{\pagewidth}{\tmpfmm}%% gap between main text and footer
      \edef\tmpfdp{\fpeval{\tmpfpm-\nvt@bls}pt}%%
      \nvt@shade9{0pt}{\tmpfdp}{\pagewidth}{\nvt@bld}%% footer baseline
    \fi%%
    %% minimum and actual side margins:
    \ifodd\c@page%%
      \nvt@shade7{0pt}{0pt}{\oddsidemargin}{\pageheight}%%
      \nvt@shade7{\oddsidemargin+\textwidth}{0pt}{\evensidemargin}{\pageheight}%%
      \nvt@shade3{0pt}{0pt}{\nvt@minspinemargin}{\pageheight}%%
      \nvt@shade3{\pagewidth-\nvt@minmargin}{0pt}{\nvt@minmargin}{\pageheight}%%
    \else%%
      \nvt@shade7{0pt}{0pt}{\evensidemargin}{\pageheight}%%
      \nvt@shade7{\evensidemargin+\textwidth}{0pt}{\oddsidemargin}{\pageheight}%%
      \nvt@shade3{0pt}{0pt}{\nvt@minmargin}{\pageheight}%%
      \nvt@shade3{\pagewidth-\nvt@minspinemargin}{0pt}{\nvt@minspinemargin}{\pageheight}%%
    \fi%%
    \nvt@shade3{0pt}{\pageheight-\nvt@minmargin}{\pagewidth}{\nvt@minmargin}%% minimum top margin
    \nvt@shade3{0pt}{0pt}{\pagewidth}{\nvt@minmargin}%% minimum bottom margin
    %% glue strips:
    \ifodd\c@page%%
      \nvt@shade2{0pt}{0pt}{\nvt@glue}{\pageheight}%%
    \else%%
      \nvt@shade2{\pagewidth-\nvt@glue}{0pt}{\nvt@glue}{\pageheight}%%
    \fi%%
  }%%
}%%
