%% SCENEIMAGE: \sceneimage[option]{content}  also starred command.
%%   When a scene break is an image, you can use \image. But in many cases, that will not provide
%% the vertical spacing that you need.
%%   The \sceneimage command behaves like \scenetext, in terms of its vertical space. However,
%% the content is interpreted the way that \image interprets its content. That is, in draft mode
%% it prints a gray placeholder rectangle; in preview or final mode, the content is used as
%% path/to/filename.png. You do not write the \image command. \sceneimage* uses \image*.
%%   The only option is [align=A] where A is one of left, right, center. Default center.
%% Unlike \image, you have no choice for number of lines, or tweak. The image never floats.
%% Width of image cannot exceed 3.5in. Height of image cannot exceed 0.24in. These values are
%% regardless of page layout. The image will be auto-tweaked for best results.
%%   As with \scenetext, the first line of the scene gap is omitted at the top of a page, and the
%% following paragraph is not indented.
\newif\ifnvt@sistar
\newif\ifnvt@insceneimage
\DeclareDocumentCommand\sceneimage{sO{}m}{%%
  \par\edef\tmppgtot{\fpeval{\pagetotal = 0pt}}%%
  \ifnum\tmppgtot>0\relax\strut\par\vspace*{-2\nvt@bls}\fi%%
  \vspace{\nvt@bls}\vspace*{-\nvt@bls}\blankline\nopagebreak%%
  \begingroup\setlength\parindent{0pt}%%
  \ifnvt@instyle\def\tmpok{0}\else\def\tmpok{1}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@inscenetext\def\tmpok{0}\fi%%
  \ifnvt@insceneimage\def\tmpok{0}\fi%%
  %% test content for macros, ~ etc.
  \ifnum\tmpok=0\relax%%
    \nvt@err{Command \string\sceneimage\space cannot be nested in itself,^^J%%
      \spii or used in \string\scenetext, \string\name, \string\subname, or block environment.}%%
    \char"FFFD\nvt@par%%
  \else%%
    \nvt@insceneimagetrue%%
    \directlua{nvt.parsescenestyle('\luaescapestring{#2}','scene')}%%
    \ifnum\tmpscreturn=1\relax%%
      \ifnum\tmpscalign=0\relax\def\tmpscleft{\strut\hfill}\def\tmpscright{\hfill\strut}\fi%%
      \ifnum\tmpscalign=1\relax\def\tmpscleft{}\def\tmpscright{\hfill\strut}\fi%%
      \ifnum\tmpscalign=2\relax\def\tmpscleft{\strut\hfill}\def\tmpscright{}\fi%%
      \IfBooleanTF{#1}{\nvt@sistartrue}{\nvt@sistarfalse}%%
      \ifnvt@sistar\image*[type=scene]{#3}\else\image[type=scene]{#3}\fi%%
    \else%%
      \nvt@err{Bad \string\sceneimage[option]{content} command.^^J%%
      \spii Option: [align=A]^^J%%
      \spiv A -> left right center. Default \nvt@scalign.}%%
      \char"FFFD\nvt@par%%
    \fi%%
  \fi%%
  \endgroup\nopagebreak\blankline%%
}%%
