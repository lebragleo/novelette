%% DEV MODE SHADING (developer only, unrelated to images):
%%   In dev mode, the margins and baselines are shaded. This helps the developer write code
%% for the size and placement of images, and for grid alignment after display.
%%   The darkest gray vertical stripe, at left of verso and right of recto, is the glue area.
%% On all sides, dark gray defines the minimum margins, where nothing may print. The top margin
%% is the minimum. The bottom margin may be minimum; but if higher, it is medium gray.
%%   Depending on trimsize and layout, the actual side margins may be wider than minimum.
%% Medium gray stripes (if present) show where the actual side margins differ from minimum.
%% Nothing may print in the actual side margins.
%%   If the layout has header and/or footer, medium gray stripes show the gaps between them
%% and the main text area. Nothing may print in those gaps.
%%   Light gray stripes show the standard baseline for each line of text, and header/footer text.
%% The top of the stripe is at baseline. Text may (and usually will) descend into the stripes.
%%   The remaining white stripes are where text (other than descenders) prints. No text may
%% rise above its area, into the descender stripe above it. In practice, it will not get close.
%%   Off-grid elements (images, and anything within display) do not obey the shaded baselines.
%% However, the following ordinary text will be restored to grid baselines.
%%   In addition, the width of image struts is changed, so the struts become visible.
\newcounter{nvt@shadecount} %% Used below.
\def\nvt@shade#1#2#3#4#5{%% #1=integer gray value, #2=LLX, #3=LLY, #4=Width, #5=Height.
  \put(1in+#2,-1in-\pageheight+#3){{\nvt@gray#1\rule{#4}{#5}}}%%
}%%
\def\nvt@devshade{%%
  \AddToHook{shipout/background}{%%
    \edef\tmptop{\fpeval{\pageheight-\topmargin}pt}%%
    \nvt@shade7{0pt}{\tmptop}{\pagewidth}{\topmargin}%% actual top margin
    \edef\tmprl{\fpeval{\tmptop-\headheight-\headsep-\nvt@bls}pt}%%
    \ifnvt@hasheader%%
      \edef\tmphs{\fpeval{\headsep-\nvt@bld}pt}%%
      \edef\tmphb{\fpeval{\tmprl+\nvt@bls}pt}%%
      \edef\tmphl{\fpeval{\tmphb+\tmphs}pt}%%
      \edef\tmphd{\fpeval{\tmphb-\nvt@bld}pt}%%
      \nvt@shade9{0pt}{\tmphl}{\pagewidth}{\nvt@bld}%% header baseline
      \nvt@shade7{0pt}{\tmphb}{\pagewidth}{\tmphs}%% headsep, gap between header and main text
      \nvt@shade9{0pt}{\tmphd}{\pagewidth}{\nvt@bld}%% virtual descender of line zero.
    \fi%%
    \setcounter{nvt@shadecount}{0}%%
    \loop%%
      \edef\tmpsl{\fpeval{\tmprl-\nvt@bld-\value{nvt@shadecount}*\nvt@bls}pt}%%
      \nvt@shade9{0pt}{\tmpsl}{\pagewidth}{\nvt@bld}%% main text baselines
      \stepcounter{nvt@shadecount}%%
    \ifnum\value{nvt@shadecount}<\nvt@lines\relax%%
    \repeat%%
    \edef\tmpbot{\fpeval{\tmptop-\headheight-\headsep-\textheight-\footskip-\nvt@bld}pt}%%
    \nvt@shade7{0pt}{0pt}{\pagewidth}{\tmpbot}%% actual bottom margin
    \ifnvt@hasfooter%%
      \edef\tmpfpm{\fpeval{\tmpsl-\footskip+\nvt@bls}pt}%%
      \edef\tmpfmm{\fpeval{\footskip-\nvt@bld-\nvt@blh}pt}%%
      \nvt@shade7{0pt}{\tmpfpm}{\pagewidth}{\tmpfmm}%% gap between main text and footer
      \edef\tmpfdp{\fpeval{\tmpfpm-\nvt@bls}pt}%%
      \nvt@shade9{0pt}{\tmpfdp}{\pagewidth}{\nvt@bld}%% footer baseline
    \fi%%
    %% minimum and actual side margins:
    \ifodd\c@page%%
      \nvt@shade7{0pt}{0pt}{\oddsidemargin}{\pageheight}%%
      \nvt@shade7{\oddsidemargin+\textwidth}{0pt}{\evensidemargin}{\pageheight}%%
      \nvt@shade3{0pt}{0pt}{\nvt@minspinemargin}{\pageheight}%%
      \nvt@shade3{\pagewidth-\nvt@minmargin}{0pt}{\nvt@minmargin}{\pageheight}%%
    \else%%
      \nvt@shade7{0pt}{0pt}{\evensidemargin}{\pageheight}%%
      \nvt@shade7{\evensidemargin+\textwidth}{0pt}{\oddsidemargin}{\pageheight}%%
      \nvt@shade3{0pt}{0pt}{\nvt@minmargin}{\pageheight}%%
      \nvt@shade3{\pagewidth-\nvt@minspinemargin}{0pt}{\nvt@minspinemargin}{\pageheight}%%
    \fi%%
    \nvt@shade3{0pt}{\pageheight-\nvt@minmargin}{\pagewidth}{\nvt@minmargin}%% minimum top margin
    \nvt@shade3{0pt}{0pt}{\pagewidth}{\nvt@minmargin}%% minimum bottom margin
    %% glue strips:
    \ifodd\c@page%%
      \nvt@shade2{0pt}{0pt}{\nvt@glue}{\pageheight}%%
    \else%%
      \nvt@shade2{\pagewidth-\nvt@glue}{0pt}{\nvt@glue}{\pageheight}%%
    \fi%%
  }%%
}%%
