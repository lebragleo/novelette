%% LOGO: \logo{PathTo/filename.png}  also starred version.
%%   A logo is a small image that sits inline with surrounding text. Its purpose is publisher's
%% logo on the title or copyright page, but Novelette does not know or care why you use it.
%%   You may only use \logo within a \styleN with option [logo]. The logo width and height
%% may not exceed 0.32in. It will be vertically positioned so that its lower 1/4 is below
%% text baseline, and its upper 3/4 is above baseline. It will be horizontally padded to occupy
%% 3em (unscaled). Regardless of its scale, the \styleN will occupy 3 at least 3 normal lines.
%%   The starred \logo* and unstarred \logo behave the same as the related \image* and \image.
\DeclareDocumentCommand\logo{sm}{%%
  \begingroup%%
  \ifnvt@dev\def\nvt@imgrulewd{2pt}\fi%%
  \ifnvt@instyle\def\tmpok{1}\else\def\tmpok{0}\fi%%
  \ifnum\tmpok=1\relax%%
    \def\fps@figure{}\def\tmpvalidate{0}%%
    \catcode`\~=12\relax\def\tmpopt{#2}%% Otherwise, ~ in file path would be undetected here.
    \IfBooleanTF{#1}%%
      {\directlua{nvt.parselogo('star','\luaescapestring{#2}')}}%%
      {\directlua{nvt.parselogo('','\luaescapestring{#2}')}}%%
      \ifnum\tmpisfile<1\relax\def\logofake{1}\else\def\logofake{0}\fi%%
      \ifnum\tmpisfile=1\relax%%
        \IfFileExists{#2}{%%
          \def\logofake{0}%%
        }{%%
          \nvt@err{Missing \string\logo\space file #2.^^J%%
            \spii The path and filename have correct format, but the file is not there.^^J%%
            \spii Either you mis-spelled the path or filename, or no such file.}%%
          \def\logofake{1}%%
        }%%
      \fi%%
      \ifnum\tmpisfile=-1\relax%%
        \nvt@err{Bad \string\logo\space argument: {#2}.^^J%%
        \spii There are several possibilities:^^J%%
        \spiv 1. Image filename does not have .png file extension.^^J%%
        \spiv 2. Path to image file is not relative to main document.^^J%%
        \spix Do not use path relative to sub-documents.^^J%%
        \spix Do not use absolute path, or symlink (softlink).^^J%%
        \spiv 3. Image file is not in same folder as main document,^^J%%
        \spix or in subfolder from main document (max 5 levels).^^J%%
        \spiv 4. Path or filename has forbidden characters. Among them:^^J%%
        \spix You may use hyphen or underscore, but not space or tilde.}%%
      \def\logofake{1}%%
    \fi%%
  \fi%%
  \ifnum\tmplogo=1\relax%% \tmplogo is provided by \styleN.
    \ifnum\tmpisfile=-1\relax%%
      \nvt@err{Bad logo argument: {#2}.^^J%%
        \spii There are several possibilities:^^J%%
        \spiv 1. The filename does not have .png file extension.^^J%%
        \spiv 2. Path to logo file is not relative to main document.^^J%%
        \spix Do not use path relative to sub-documents.^^J%%
        \spix Do not use absolute path, or symlink (softlink).^^J%%
        \spiv 3. File is not in same folder as main document,^^J%%
        \spix or in subfolder from main document (max 5 levels).^^J%%
        \spiv 4. Path or filename has forbidden characters. Among them:^^J%%
        \spix You may use hyphen or underscore, but not space or tilde.}%%
      \def\logofake{1}%%
    \fi%%
    \ifnum\logofake=0\relax%%
      \nvt@reallogo{#2}%%
    \else%%
      \sbox0{{\nvt@gray{8}\rule{.32in}{.32in}}}%%
    \fi%%
    \edef\tmplogodrop{\fpeval{.25*\ht0}pt}%%
    \strut\makebox[3\nvt@em]{\hfill\smash{\raisebox{-\tmplogodrop}{\usebox0}}\hfill}%%
  \else%%
    \nvt@err{\string\logow\space may only be placed within \string\styleN, with [logo] option.}%%
    \strut\makebox[3\nvt@em]{\hfill\char"FFFD\hfill}%%
  \fi%%
  \endgroup%%
}%%
%%


%% Real logo (if bad, defaults to fake):
\def\nvt@reallogo#1{%%
  \def\tmpvalid{1}%%
  \ifnum\tmpvalidate=1\relax\nvt@validateimage{#1}\fi%%
  \ifnum\tmpvalid=0\relax%%
    \nvt@warn{File #1 failed validation.^^J%%
      See Novelette docs for how to fix this problem.^^J%%
      Cannot produce preview or final mode, if not valid.}%%
    \sbox0{{\nvt@gray{8}\rule[-.06in]{.24in}{.18in}}}%%
  \else%%
    \@ifundefined{#1 image:I}{%%
      \saveimageresource attr{/Interpolate true}{#1}%%
      \sbox0{\useimageresource\lastsavedimageresourceindex}%%
      \expandafter\xdef\csname #1 image:I\endcsname
        {\useimageresource\the\lastsavedimageresourceindex}%%
      \wlog{<#1, id=\the\lastsavedimageresourceindex, interpolate=true>}%%
    }{%%
      \sbox0{\csname #1 image:I\endcsname}%%
    }%%
  \fi%%
  \edef\tmpfit{\fpeval{(\ht0 > .324in) + (\wd0 > .324in)}}%% .004in fuzz h,w
  \ifnum\tmpfit>0\relax%%
    \nvt@warn{File #1 is too large for \string\logo.^^J%%
      \spii Max width 0.32in, height 0.32in.}%%
  \fi%%
}%%
%%


%% Image or Logo file validation:
\def\nvt@validateimage#1{%%
  \directlua{nvt.validateimage('\luaescapestring{#1}')}%%
}%%
