%% Fake image, placeholder rectangle:
\def\nvt@fakeimage{%%
  \ifnvt@insceneimage%%
    \def\imgwd{3.4in}\def\imght{.32in}%%
  \else%%
    \edef\imgwd{\fpeval{0.6*\textwidth}pt}%%
    \edef\imght{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls}pt}%%
  \fi%%
  \sbox0{{\nvt@gray{8}\rule{\imgwd}{\imght}}}%%
  \ifnvt@insceneimage%%
    \def\imglabel{{\nvt@gray{4}\nvt@aff{RawFeature={+titl},Scale=.75}scene\tmplabel}}%%
  \else%%
    \def\imglabel{{\nvt@gray{4}\nvt@aff{RawFeature={+titl},Scale=.75}\tmplabel}}%%
  \fi%%
}%%
%%


%% Real image (if bad, defaults to fake):
\def\nvt@realimage#1{%%
  \def\imglabel{}%%
  \def\tmpvalid{1}%%
  \ifnum\tmpvalidate=1\relax\nvt@validateimage{#1}\fi%%
  \ifnum\tmpvalid=0\relax%%
    \nvt@warn{Image file #1 failed validation.^^J%%
      See Novelette docs for how to fix this problem.^^J%%
      Cannot produce preview or final mode, if not valid.}%%
    \def\tmplabel{failed validation}\nvt@fakeimage%%
  \else%%
    \@ifundefined{#1 image:I}{%%
      \saveimageresource attr{/Interpolate true}{#1}%%
      \sbox0{\useimageresource\lastsavedimageresourceindex}%%
      \expandafter\xdef\csname #1 image:I\endcsname
        {\useimageresource\the\lastsavedimageresourceindex}%%
      \wlog{<#1, id=\the\lastsavedimageresourceindex, interpolate=true>}%%
    }{%%
      \sbox0{\csname #1 image:I\endcsname}%%
    }%%
  \fi%%
  \ifnvt@insceneimage%%
    \edef\tmpfit{\fpeval{(\ht0 > .324in) + (\wd0 > 3.44in)}}%% .004in fuzz h,w.
    \ifnum\tmpfit>0\relax%%
      \nvt@warn{\string\sceneimage\space #1 is too large.^^J%%
        \spii Maximum width 3.4in, maximum height 0.32in.}%%
      \def\tmplabel{oversize image}\nvt@fakeimage%%
    \fi%%
  \else%%
    \edef\tmpht{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls + .004in}pt}%% .004in fuzz
    \edef\tmpfit{\fpeval{(\ht0 > \tmpht) + (\wd0 > \textwidth)}}%% no width fuzz
    \ifnum\tmpfit>0\relax%%
      \nvt@warn{\string\image\space #1 is too large.^^J%%
        \spii Reduce image width and/or height, or increase [lines=L] option.}%%
      \def\tmplabel{oversize image}\nvt@fakeimage%%
    \fi%%
  \fi%%
}%%
%%


%% Print the real or fake image:
\def\nvt@printimage{%%
  \ifnvt@insceneimage%%
    \edef\imgruleht{\fpeval{\nvt@bls}pt}%%
    \edef\tmppad{\fpeval{-.5*\ht0}pt}%% %%%%%
  \else%%
    \edef\imgruleht{\fpeval{\tmplines*\nvt@bls}pt}%%
    \ifnum\tmptweak=0\relax\edef\tmppad{%%
      \fpeval{.5*(.84*\nvt@em+(\tmplines-1)*\nvt@bls-\ht0)}pt}%%
    \fi%%
    \ifnum\tmptweak=1\relax\edef\tmppad{\fpeval{.84*\nvt@em+(\tmplines-1)*\nvt@bls-\ht0}pt}\fi%%
    \ifnum\tmptweak=2\relax\def\tmppad{0pt}\fi%%
  \fi%%
  \ifx\fps@figure\@empty\else\@float{figure}\fi%%
  \nvt@zrule\imgleft\rule{\nvt@imgrulewd}{\imgruleht}%%
  \smash{\raisebox{\tmppad}{\usebox0}}%%
  \ifx\imglabel\@empty\else%%
    \llap{\smash{\raisebox{\tmppad}{\imglabel}}}%%
  \fi%%
  \imgright\nvt@zrule\par%%
  \ifx\fps@figure\@empty\else\end@float\fi%%
}%%
