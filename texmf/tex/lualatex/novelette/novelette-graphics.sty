%% Real image (if bad, defaults to fake):
\def\nvt@realimage#1{%%
  \sbox0{#1}\def\imglabel{}%%
  \edef\tmpht{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls}pt}%%
  \edef\tmpfit{\fpeval{(\ht0 > \tmpht) + (\wd0 > \textwidth)}}%%
  \ifnum\tmpfit>0\relax%%
    \nvt@warn{Image #1 is too large.^^J%%
      \spii Reduce image width and/or height, or increase [lines=L] option.}%% %%%% \sceneimage ?
    \def\tmplabel{oversize image}\nvt@fakeimage%%
  \else%%
    \def\tmpvalid{1}%%
    \ifnum\tmpvalidate=1\relax\nvt@validateimage{#1}\fi%%
    \ifnum\tmpvalid=0\relax%%
      \nvt@warn{Image file #1 failed validation.^^J%%
        See Novelette docs for how to fix this problem.^^J%%
        Cannot produce preview or final mode, if any image is not valid.}%%
      \def\tmplabel{failed validation}\nvt@fakeimage%%
    \else%%
      \@ifundefined{#1 image:I}{%%
        \saveimageresource attr{/Interpolate true}{#1}%%
        \sbox0{\useimageresource\lastsavedimageresourceindex}%%
        \expandafter\xdef\csname #1 image:I\endcsname
          {\useimageresource\the\lastsavedimageresourceindex}%%
        \wlog{<#1, id=\the\lastsavedimageresourceindex, interpolate=true>}%%
      }{%%
        \sbox0{\csname #1 image:I\endcsname}%%
      }%%
    \fi%%
  \fi%%
}%%
%%


%% Print the real or fake image:
\def\nvt@printimage{%%
  \ifnvt@insceneimage%% %%%%%
    \edef\imgruleht{\fpeval{\nvt@bls}pt}%%
  \else%%
    \edef\imgruleht{\fpeval{\tmplines*\nvt@bls}pt}%%
  \fi%%
  \ifnum\tmptweak=0\relax\edef\tmppad{\fpeval{.5*(.84*\nvt@em+(\tmplines-1)*\nvt@bls-\ht0)}pt}\fi%%
  \ifnum\tmptweak=1\relax\edef\tmppad{\fpeval{.84*\nvt@em+(\tmplines-1)*\nvt@bls-\ht0}pt}\fi%%
  \ifnum\tmptweak=2\relax\def\tmppad{0pt}\fi%%
  \ifnvt@insceneimage\edef\tmppad{\fpeval{.117in - \ht0}pt}\fi%% %%%%%
  \ifx\fps@figure\@empty\else\@float{figure}\fi%%
  \nvt@zrule\imgleft\rule{\nvt@imgrulewd}{\imgruleht}%%
  \smash{\raisebox{\tmppad}{\usebox0}}%%
  \ifx\imglabel\@empty\else\llap{\smash{\raisebox{\tmppad}{\imglabel}}}\fi%%
  \imgright\nvt@zrule\par%%
  \ifx\fps@figure\@empty\else\end@float\fi%%
}%%
%%


%% Image file validation:
\def\nvt@validateimage#1{%%
  \directlua{nvt.validateimage('\luaescapestring{#1}')}%%
}%%
