%% GRAPHICS:
%%   Novelette does not use standard LaTeX graphics commands, such as \includegraphics. You cannot
%% create vector (TiKz) drawings, or include eps/pdf files.
%%   There are two graphics commands: \image and \logo. In all cases, the graphics file must be
%% png raster format, monochrome or true grayscale. It must state its resolution (density).
%%   In preview and final modes, the file must also pass conformance tests. Novelette provides
%% shell scripts, using ImageMagick, that process files to ensure conformance. These scripts
%% are in the documentation utilities folder.
%%   Files must be located in the same folder as the main document, or (better) in a subfolder
%% relative to the main document. File paths are always relative to the main document, even if
%% the file is called by a sub-document.
%%   You may never place graphics in footnotes or page headers. Only \logo may be used inline
%% with text; \image and \sceneimage create their own paragraphs.
%%   All three graphics commands have starred and unstarred versions. In preview and final modes,
%% there is no difference: each file is carefully inspected.
%%   In draft mode, an unstarred command does not look for its file. Instead, it prints a gray
%% placeholder rectangle. If starred, it prints the file if it fits its area.
%%   If a file is too wide or tall for its area, it is not printed. Instead, a placeholder
%% rectangle prints where the file would print, and the document is demoted to draft mode.


%% IMAGE: \image[option]{path/to/filename.png}  also starred version.
%%   The optional argument is not truly optional, because it must at least set the number of lines
%% that the image will displace. The default (3 lines) is a placeholder, and is an error.
%%   Note that Novelette handles floats using its own syntax. You may provide at most one
%% of the float choices. Some areas disallow floats. There are no "float pages" that accumulate
%% several floats. A full-page float is discouraged (better to use a single-page component),
%% but if you use it, the image appears alone on its page.
\def\ftype@figure{1} %% Standard.
\def\nvt@imgrulewd{0pt} %% Nonzero in dev mode. Applies to strut that enforces lines=L.
\newif\ifnvt@inimage %% True within the \image mandatory argument.
\DeclareDocumentCommand\image{sO{}m}{%%
  \begingroup%%
  \ifnvt@infootnote\def\tmpok{0}\else\def\tmpok{1}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%%
  \ifnvt@instyle\def\tmpok{0}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnum\tmpok=0\relax%%
    \nvt@err{Cannot place graphics in footnote or page header,^^J%%
      \spii or in \string\styleN\space (N=0-9), \string\scene, or block environment.}%%
    {\char"FFFD}%%
  \fi%%
  \ifnvt@inimage%%
    \nvt@err{Do not write \string\image\space within \string\sceneimage.^^J%%
      \spii The \string\sceneimage\space command already knows that its argument is an image.}%%
    {\char"FFFD}\def\tmpok{0}%%
  \fi%%
  \nvt@inimagetrue%%
  \ifnum\tmpok=1\relax%%
    \ifnvt@dev\def\nvt@imgrulewd{2pt}\fi%%
    \def\tmpalign{0}\def\tmptweak{0}\def\tmplines{0}\def\tmpvalidate{0}%%
    \ifnvt@indisplay\def\tmpfloat{0}\else\def\tmpfloat{1}\fi%%
    \ifnvt@infrontmatter\def\tmpfloat{0}\fi%%
    \ifnvt@inbackmatter\def\tmpfloat{0}\fi%%
    \par\vspace*{-\nvt@bls}\null\setlength\parindent{0pt}%% Begin paragraph. %%%%% \null ?
    \catcode`\~=12\relax\def\tmpopt{#2}%% Otherwise, ~ in file path would be undetected here.
    \IfBooleanTF{#1}%%
      {\directlua{nvt.parseimage('star','\luaescapestring{\tmpopt}','\luaescapestring{#3}')}}%%
      {\directlua{nvt.parseimage('','\luaescapestring{\tmpopt}','\luaescapestring{#3}')}}%%
    \ifnum\tmpreturn=0\relax%%
      \nvt@err{Bad \string\image\space option.^^J%%
        \spii Format: [lines=L,align=A,float=F,tweak=T]^^J%%
        \spiv L -> Integer 1<=L<=(lines per page). Must be set.^^J%%
        \spiv A -> left right center. Default center.^^J%%
        \spiv F -> none here top bottom. Choose only one.^^J%%
        \spix If here, then top is automatic backup.^^J%%
        \spix In frontmatter, backmatter, displays: default none. No other allowed.^^J%%
        \spix Elsewhere: default here.^^J%%
        \spiv T -> down up mid. Default mid.^^J%%
        \spix down ->  Bottom of image at baseline of lowest displaced line.^^J%%
        \spix up -> Top at accented uppercase height of highest displaced line.^^J%%
        \spix mid -> Splits padding above/below image.}%%
    \fi%%
    \ifnum\tmpalign=-1\relax\def\imgleft{\nvt@sceneleft}\def\imgright{\nvt@sceneright}\fi%%
    \ifnum\tmpalign=0\relax\def\imgleft{\hfill}\def\imgright{\hfill}\fi%%
    \ifnum\tmpalign=1\relax\def\imgleft{}\def\imgright{\hfill}\fi%%
    \ifnum\tmpalign=2\relax\def\imgleft{\hfill}\def\imgright{}\fi%%
    \ifnum\tmplines=0\relax%%
      \nvt@err{\string\image\space requires [lines=L] option, integer 1<=L<=(lines per page).}%%
      \def\tmplines{3}%% Placeholder backup. Almost always an incorrect value.
    \fi%%
    \ifnum\tmpisfile<1\relax\def\imgfake{1}\else\def\imgfake{0}\fi%%
    \ifnum\tmpisfile=1\relax%%
      \IfFileExists{#3}{%%
        \def\imgfake{0}%%
      }{%%
        \nvt@err{Missing \string\image\space file #3.^^J%%
          \spii The path and filename have correct format, but the file is not there.^^J%%
          \spii Either you mis-spelled the path or filename, or no such file.}%%
        \def\imgfake{1}%%
      }%%
    \fi%%
    \ifnum\tmpisfile=-1\relax%%
      \nvt@err{Bad \string\image\space argument: {#3}.^^J%%
        \spii There are several possibilities:^^J%%
        \spiv 1. Image filename does not have .png file extension.^^J%%
        \spiv 2. Path to image file is not relative to main document.^^J%%
        \spix Do not use path relative to sub-documents.^^J%%
        \spix Do not use absolute path, or symlink (softlink).^^J%%
        \spiv 3. Image file is not in same folder as main document,^^J%%
        \spix or in subfolder from main document (max 5 levels).^^J%%
        \spiv 4. Path or filename has forbidden characters. Among them:^^J%%
        \spix You may use hyphen or underscore, but not space or tilde.}%%
      \def\imgfake{1}%%
    \fi%%
    \ifnum\tmpfloat=0\relax\def\fps@figure{}\fi%%
    \ifnum\tmpfloat=1\relax\def\fps@figure{!ht}\fi%%
    \ifnum\tmpfloat=2\relax\def\fps@figure{!t}\fi%%
    \ifnum\tmpfloat=3\relax\def\fps@figure{!b}\fi%%
    \ifnvt@indisplay%%
      \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
      \def\fps@figure{}%%
    \fi%%
    \ifnvt@infrontmatter%%
      \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
      \def\fps@figure{}%%
    \fi%%
    \ifnvt@inbackmatter%%
      \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
      \def\fps@figure{}%%
    \fi%%
    \ifnum\imgfake=0\relax\nvt@realimage{#3}\else\nvt@fakeimage\fi%%
    \nvt@printimage%%
    \par\vspace*{-\nvt@bls}\null%%
  \fi%%
  \endgroup%%
}%%
%%


%% SCENEIMAGE: \sceneimage[align=A]{PathTo/filename.png}  also starred version.
%%   This is a hybid of \scene and \image. Like \scene, it creates a 3-line gap between
%% paragraphs, with the following paragraph unindented. Also, it defaults to \scenestyle.
%% But unlike \scene, this command does not print text.
%%   Like \image, the mandatory argument is a png raster image file. \sceneimage and \sceneimage*
%% have the same bahavior as \image and \image*, and may print a placeholder. But unlike
%% \image, the \sceneimage file can never float or tweak. It has a fixed maximum size, and does
%% not use lines=L to reserve the space.
%%   The lower half of the image sits below the middle baseline.
\newif\ifnvt@insceneimage %% True within \sceneimage.
\DeclareDocumentCommand\sceneimage{sO{}m}{%%
  \begingroup%%
  \ifnvt@infootnote\def\tmpok{0}\else\def\tmpok{1}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%%
  \ifnvt@instyle\def\tmpok{0}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@inscene\def\tmpok{0}\fi%%
  \ifnum\tmpok=0\relax%%
    \nvt@err{Cannot place graphics in footnote or page header,^^J%%
      \spii or in \string\styleN\space (N=0-9), or \string\scene, or block environment.}%%
    {\char"FFFD}%%
  \fi%%
  \ifnvt@insceneimage%%
    \nvt@err{Do not write \string\image\space within \string\sceneimage.^^J%%
      \spii The \string\sceneimage\space command already knows that its argument is an image.}%%
    {\char"FFFD}\def\tmpok{0}%%
  \fi%%
  \nvt@insceneimagetrue%%
  \ifnum\tmpok=1\relax%%
    \ifnvt@dev\def\nvt@imgrulewd{2pt}\fi%%
    \def\tmpalign{0}\def\tmpvalidate{0}%%
    \par\vspace*{-\nvt@bls}\null\setlength\parindent{0pt}%% Begin paragraph. %%%%% \null ?
    \catcode`\~=12\relax\def\tmpopt{lines=2,#2}%% Else ~ in file path would be undetected here.
    \IfBooleanTF{#1}%%
      {\directlua{nvt.parseimage('star','\luaescapestring{\tmpopt}','\luaescapestring{#3}')}}%%
      {\directlua{nvt.parseimage('','\luaescapestring{\tmpopt}','\luaescapestring{#3}')}}%%
    \ifnum\tmpreturn=0\relax%%
      \nvt@err{Bad \string\sceneimage\space option.^^J%%
        \spii Format: [align=A]^^J%%
        \spiv A -> left right center. Default from \string\scenestyle, or center.^^J%%
        \spiv \string\sceneimage\space does not have [lines=L] or other options.}%%
    \fi%%
    \ifnum\tmpalign=-1\relax\def\imgleft{\nvt@sceneleft}\def\imgright{\nvt@sceneright}\fi%%
    \ifnum\tmpalign=0\relax\def\imgleft{\hfill}\def\imgright{\hfill}\fi%%
    \ifnum\tmpalign=1\relax\def\imgleft{}\def\imgright{\hfill}\fi%%
    \ifnum\tmpalign=2\relax\def\imgleft{\hfill}\def\imgright{}\fi%%
    \ifnum\tmpisfile<1\relax\def\imgfake{1}\else\def\imgfake{0}\fi%%
    \ifnum\tmpisfile=1\relax%%
      \IfFileExists{#3}{%%
        \def\imgfake{0}%%
      }{%%
        \nvt@err{Missing \string\sceneimage\space file #3.^^J%%
          \spii The path and filename have correct format, but the file is not there.^^J%%
          \spii Either you mis-spelled the path or filename, or no such file.}%%
        \def\imgfake{1}%%
      }%%
    \fi%%
    \ifnum\tmpisfile=-1\relax%%
      \nvt@err{Bad \string\sceneimage\space argument: {#3}.^^J%%
        \spii There are several possibilities:^^J%%
        \spiv 1. Image filename does not have .png file extension.^^J%%
        \spiv 2. Path to image file is not relative to main document.^^J%%
        \spix Do not use path relative to sub-documents.^^J%%
        \spix Do not use absolute path, or symlink (softlink).^^J%%
        \spiv 3. Image file is not in same folder as main document,^^J%%
        \spix or in subfolder from main document (max 5 levels).^^J%%
        \spiv 4. Path or filename has forbidden characters. Among them:^^J%%
        \spix You may use hyphen or underscore, but not space or tilde.}%%
      \def\imgfake{1}%%
    \fi%%
    \vspace{\nvt@bls}%%
    \def\fps@figure{}%%
    \ifnum\imgfake=0\relax\nvt@realimage{#3}\else\nvt@fakeimage\fi%%
    \nvt@printimage%%
    \par\vspace*{-\nvt@bls}\null%%
  \fi%%
  \endgroup%%
  \blankline%%
}%%
