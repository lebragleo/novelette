%% GRAY DEFINITIONS:
%%   Novelette does not allow grayscale text, just grayscale images. No color anywhere.
%% This code allows the developer to apply background shades of gray, for showing certain areas.
%% It also creates gray rectangles, for image placeholders. It is not used in a good final PDF.
\chardef\main@pdfcolorstack=0\relax
\@ifundefined{@pdfcolorstack}{\def\@pdfcolorstack{\main@pdfcolorstack}}{}
\def\current@color{0 g 0 G}
\def\set@color{%%
  \pdfextension colorstack\@pdfcolorstack push{\current@color}\aftergroup\reset@color%%
}%%
\def\reset@color{\pdfextension colorstack\@pdfcolorstack pop\relax}
\def\color@gray#1#2{\edef#1{#2 g #2 G}}
\long\def\nvt@gray#1{%% #1 is unbraced integer 1-9 (1=darkest, 9=lightest).
  \csname color@gray\endcsname\current@color{.#1}\set@color\ignorespaces%%
}%%
\def\nvt@luagray{%% When \enable{examine}.
  \newattribute\LuaGray@Attribute
  \let\LuaGray@setattribute\setattribute
  \directlua{nvt.setattribute(\number\allocationnumber)}
  \protected\def\set@color{%
    \LuaGray@setattribute\LuaGray@Attribute{%
      \directlua{nvt.get("\luaescapestring{\current@color}")}%
    }%
   \aftergroup\reset@color
  }
  \def\reset@color{}
  \set@color
}%%
