%% GRAPHICS:
%%   Novelette does not use standard LaTeX graphics commands, such as \includegraphics. You cannot
%% create vector (TiKz) drawings, or include eps/pdf files.
%%   There are two graphics commands: \image and \icon. In all cases, the graphics file must be
%% png raster format, monochrome or true grayscale. It must state its resolution (density).
%%   In preview and final modes, the file must also pass conformance tests. Novelette provides
%% shell scripts, using ImageMagick, that process files to ensure conformance. These scripts
%% are in the documentation utilities folder.
%%   Files must be located in the same folder as the main document, or (better) in a subfolder
%% relative to the main document. File paths are always relative to the main document, even if
%% the file is called by a sub-document.
%%   You may never place graphics in footnotes or page headers. Only \icon may be used inline
%% with text; \image and \sceneimage create their own paragraphs.
%%   All three graphics commands have starred and unstarred versions. In preview and final modes,
%% there is no difference: each file is carefully inspected.
%%   In draft mode, an unstarred command does not look for its file. Instead, it prints a gray
%% placeholder rectangle. If starred, it prints the file if it fits its area.
%%   If a file is too wide or tall for its area, it is not printed. Instead, a placeholder
%% rectangle prints where the file would print, and the document is demoted to draft mode.


%% IMAGE: \image[option]{path/to/filename.png}  also starred version.
%%   The optional argument is not truly optional, because it must at least set the number of lines
%% that the image will displace. The default (3 lines) is a placeholder, and is an error.
%%   Note that Novelette handles floats using its own syntax. You may provide at most one
%% of the float choices. Some areas disallow floats. There are no "float pages" that accumulate
%% several floats. A full-page float is discouraged (better to use a single-page component),
%% but if you use it, the image appears alone on its page.
\def\ftype@figure{1} %% Standard.
\def\nvt@imgrulewd{0pt} %% Nonzero in dev mode. Applies to strut that enforces lines=L.
\DeclareDocumentCommand\image{sO{}m}{%%
  \begingroup%%
  \ifnvt@infootnote\def\tmpok{0}\else\def\tmpok{1}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%%
  \ifnvt@instyle\def\tmpok{0}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnum\tmpok=0\relax%%
    \nvt@err{Cannot place \string\image\space in footnote or page header.^^J%%
      Cannot place \string\image\space in \string\styleN (N=0-9) %%
      or \string\scene, or block environment.}%%
    {\char"FFFD}%%
  \fi%%
  \ifnum\tmpok=1\relax%%
    \ifnvt@dev\def\nvt@imgrulewd{2pt}\fi%%
    \def\tmpalign{0}\def\tmptweak{0}\def\tmplines{0}\def\tmpvalidate{0}%%
    \ifnvt@indisplay\def\tmpfloat{0}\else\def\tmpfloat{1}\fi%%
    \ifnvt@infrontmatter\def\tmpfloat{0}\fi%%
    \ifnvt@inbackmatter\def\tmpfloat{0}\fi%%
    \par\vspace*{-\nvt@bls}\null\setlength\parindent{0pt}%% Begin paragraph. %%%%% \null ?
    \catcode`\~=12\relax\def\tmpopt{#2}%% Otherwise, ~ in file path would be undetected here.
    \IfBooleanTF{#1}%%
      {\directlua{nvt.parseimage('star','\luaescapestring{\tmpopt}','\luaescapestring{#3}')}}%%
      {\directlua{nvt.parseimage('','\luaescapestring{\tmpopt}','\luaescapestring{#3}')}}%%
    \ifnum\tmpreturn=0\relax%%
      \nvt@err{Bad \string\image\space option.^^J%%
        \spii Format: [lines=L,align=A,float=F,tweak=T] or [scene,align=A]^^J%%
        \spiv L -> Integer 1<=L<=(lines per page). Must be set.^^J%%
        \spiv A -> left right center. Default center.^^J%%
        \spiv F -> none here top bottom. Choose only one.^^J%%
        \spix If here, then top is automatic backup.^^J%%
        \spix In frontmatter, backmatter, displays: default none. No other allowed.^^J%%
        \spix Elsewhere: default here.^^J%%
        \spiv T -> down up mid. Default mid.^^J%%
        \spix down ->  Bottom of image at baseline of lowest displaced line.^^J%%
        \spix up -> Top at accented uppercase height of highest displaced line.^^J%%
        \spix mid -> Splits padding above/below image.^^J%%
        \spii If [scene] option:^^J%%
        \spiv You may also use align=A, but no other options.^^J%%
        \spiv Default alignment is set by \string\defaultscene, or center if unset.^^J%%
        \spiv No float. Special values are used for lines and tweak.}%%
    \fi%%
    \ifnum\tmpscene=1\relax\blankline\fi%%
    \ifnum\tmpalign=-1\relax\def\imgleft{\nvt@sceneleft}\def\imgright{\nvt@sceneright}\fi%%
    \ifnum\tmpalign=0\relax\def\imgleft{\hfill}\def\imgright{\hfill}\fi%%
    \ifnum\tmpalign=1\relax\def\imgleft{}\def\imgright{\hfill}\fi%%
    \ifnum\tmpalign=2\relax\def\imgleft{\hfill}\def\imgright{}\fi%%
    \ifnum\tmpscene=0\relax%%
      \ifnum\tmplines=0\relax%%
        \nvt@err{\string\image\space requires [lines=L] option, integer 1<=L<=(lines per page).}%%
        \def\tmplines{3}%% Placeholder default. Almost always an incorrect value.
      \fi%%
    \fi%%
    \ifnum\tmpisfile=0\relax\def\imgfake{1}\else\def\imgfake{0}\fi%%
    \ifnum\tmpisfile=1\relax%%
      \IfFileExists{#3}{%%
        \def\imgfake{0}%%
      }{%%
        \nvt@err{Missing image file #3.^^J%%
          \spii The path and filename have correct format, but the file is not there.^^J%%
          \spii Either you mis-spelled the path or filename, or no such file.}%%
        \def\imgfake{1}%%
      }%%
    \fi%%
    \ifnum\tmpisfile=2\relax%%
      \nvt@err{Bad image argument: {#3}.^^J%%
        \spii There are several possibilities:^^J%%
        \spiv 1. Image filename does not have .png file extension.^^J%%
        \spiv 2. Path to image file is not relative to main document.^^J%%
        \spix Do not use path relative to sub-documents.^^J%%
        \spix Do not use absolute path, or symlink (softlink).^^J%%
        \spiv 3. Image file is not in same folder as main document,^^J%%
        \spix or in subfolder from main document (max 5 levels).^^J%%
        \spiv 4. Path or filename has forbidden characters. Among them:^^J%%
        \spix You may use hyphen or underscore, but not space or tilde.}%%
      \def\imgfake{1}%%
    \fi%%
    \ifnum\tmpscene=1\relax%%
      \def\fps@figure{}%%
    \else%%
      \ifnum\tmpfloat=0\relax\def\fps@figure{}\fi%%
      \ifnum\tmpfloat=1\relax\def\fps@figure{!ht}\fi%%
      \ifnum\tmpfloat=2\relax\def\fps@figure{!t}\fi%%
      \ifnum\tmpfloat=3\relax\def\fps@figure{!b}\fi%%
      \ifnvt@indisplay%%
        \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
        \def\fps@figure{}%%
      \fi%%
      \ifnvt@infrontmatter%%
        \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
        \def\fps@figure{}%%
      \fi%%
      \ifnvt@inbackmatter%%
        \ifnum\tmpfloat>0\relax\nvt@warn{Ignored request for float in no-float location.}\fi%%
        \def\fps@figure{}%%
      \fi%%
    \fi%%
    \ifnum\imgfake=0\relax\nvt@realimage{#3}\else\nvt@fakeimage\fi%%
    \nvt@printimage%%
    \par\vspace*{-\nvt@bls}\null%%
  \fi%%
  \ifnum\tmpscene=1\relax\gdef\tmpaddblank{1}\else\gdef\tmpaddblank{0}\fi%%
  \endgroup%%
  \ifnum\tmpaddblank=1\relax\blankline\fi\gdef\tmpaddblank{0}%%
}%%
%%


%% Fake image, placeholder rectangle:
\def\nvt@fakeimage{%%
  \ifnum\tmpscene=1\relax%%
    \def\imgwd{3.5in}\def\imght{.24in}%%
  \else%%
    \edef\imgwd{\fpeval{0.6*\textwidth}pt}%%
    \edef\imght{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls}pt}%%
  \fi%%
  \sbox0{{\nvt@gray{8}\rule{\imgwd}{\imght}}}%%
  \def\imglabel{{\nvt@gray{4}\nvt@aff{RawFeature={+titl},Scale=.75}\tmplabel}}%%
}%%
%%


%% Real image (if bad, defaults to fake):
\def\nvt@realimage#1{%%
  \def\imglabel{}%%
  \def\tmpvalid{1}%%
  \ifnum\tmpvalidate=1\relax\nvt@validateimage{#1}\fi%%
  \ifnum\tmpvalid=0\relax%%
    \nvt@warn{Image file #1 failed validation.^^J%%
      See Novelette docs for how to fix this problem.^^J%%
      Cannot produce preview or final mode, if not valid.}%%
    \def\tmplabel{failed validation}\nvt@fakeimage%%
  \else%%
    \@ifundefined{#1 image:I}{%%
      \saveimageresource attr{/Interpolate true}{#1}%%
      \sbox0{\useimageresource\lastsavedimageresourceindex}%%
      \expandafter\xdef\csname #1 image:I\endcsname
        {\useimageresource\the\lastsavedimageresourceindex}%%
      \wlog{<#1, id=\the\lastsavedimageresourceindex, interpolate=true>}%%
    }{%%
      \sbox0{\csname #1 image:I\endcsname}%%
    }%%
  \fi%%
  \edef\tmpht{\fpeval{0.84*\nvt@em + (\tmplines-1)*\nvt@bls + .004}pt}%%
  \edef\tmpfit{\fpeval{(\ht0 > \tmpht) + (\wd0 > \textwidth)}}%%
  \ifnum\tmpfit>0\relax%%
    \nvt@warn{Image #1 is too large.^^J%%
      \spii Reduce image width and/or height, or increase [lines=L] option.}%% %%%% \tmpscene ?
    \def\tmplabel{oversize image}\nvt@fakeimage%%
  \fi%%
}%%
%%


%% Print the real or fake image:
\def\nvt@printimage{%%
  \ifnum\tmpscene=1\relax%% %%%%%
    \edef\imgruleht{\fpeval{\nvt@bls}pt}%%
    \edef\tmppad{\fpeval{.117in - \ht0}pt}%% %%%%%
  \else%%
    \edef\imgruleht{\fpeval{\tmplines*\nvt@bls}pt}%%
    \ifnum\tmptweak=0\relax\edef\tmppad{%%
      \fpeval{.5*(.84*\nvt@em+(\tmplines-1)*\nvt@bls-\ht0)}pt}%%
    \fi%%
    \ifnum\tmptweak=1\relax\edef\tmppad{\fpeval{.84*\nvt@em+(\tmplines-1)*\nvt@bls-\ht0}pt}\fi%%
    \ifnum\tmptweak=2\relax\def\tmppad{0pt}\fi%%
  \fi%%
  \ifx\fps@figure\@empty\else\@float{figure}\fi%%
  \nvt@zrule\imgleft\rule{\nvt@imgrulewd}{\imgruleht}%%
  \smash{\raisebox{\tmppad}{\usebox0}}%%
  \ifx\imglabel\@empty\else\llap{\smash{\raisebox{\tmppad}{\imglabel}}}\fi%%
  \imgright\nvt@zrule\par%%
  \ifx\fps@figure\@empty\else\end@float\fi%%
}%%
%%


%% ICON: \icon{path/to/filename.png}
%%   An icon occupies exactly 0.24in width, 0.18in height. Its upper two-thirds will print
%% above the surrounding text baseline; lower one-third below baseline.
%%   You must design the file so that it fits within that area. If smaller, it is automatically
%% padded to the full area.
%%   The \icon command may only be used in a display zone. It may be used within a \styleN,
%% but will not be scaled. It may be used in a block environment, but only if the block does not
%% use small text.
\DeclareDocumentCommand\icon{sm}{%%
  \begingroup%%
  \ifnvt@infootnote\def\tmpok{0}\else\def\tmpok{1}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%%
  \ifnvt@indisplay\else\def\tmpok{0}\fi%%
  \ifnvt@smallblock\def\tmpok{0}\fi%%
  \ifnum\tmpok=0\relax%%
    \nvt@err{Cannot place \string\icon\space in footnote, page header, or \string\scene.^^J%%
      Cannot place \string\icon\space in block environment with small text.}%%
    {\char"FFFD}%%
  \fi%%
  \ifnum\tmpok=1\relax%%
    \def\fps@figure{}\def\tmpvalidate{0}%%
    \catcode`\~=12\relax\def\tmpopt{#2}%% Otherwise, ~ in file path would be undetected here.
    \IfBooleanTF{#1}%%
      {\directlua{nvt.parseicon('star','\luaescapestring{#2}')}}%%
      {\directlua{nvt.parseicon('','\luaescapestring{#2}')}}%%
    \ifnum\tmpisfile=0\relax\def\iconfake{1}\else\def\iconfake{0}\fi%%
    \ifnum\tmpisfile=1\relax%%
      \IfFileExists{#2}{%%
        \def\iconfake{0}%%
      }{%%
        \nvt@err{Missing icon file #2.^^J%%
          \spii The path and filename have correct format, but the file is not there.^^J%%
          \spii Either you mis-spelled the path or filename, or no such file.}%%
        \def\iconfake{1}%%
      }%%
    \fi%%
    \ifnum\tmpisfile=2\relax%%
      \nvt@err{Bad icon argument: {#2}.^^J%%
        \spii There are several possibilities:^^J%%
        \spiv 1. Icon filename does not have .png file extension.^^J%%
        \spiv 2. Path to icon file is not relative to main document.^^J%%
        \spix Do not use path relative to sub-documents.^^J%%
        \spix Do not use absolute path, or symlink (softlink).^^J%%
        \spiv 3. Icon file is not in same folder as main document,^^J%%
        \spix or in subfolder from main document (max 5 levels).^^J%%
        \spiv 4. Path or filename has forbidden characters. Among them:^^J%%
        \spix You may use hyphen or underscore, but not space or tilde.}%%
      \def\iconfake{1}%%
    \fi%%
    \ifnum\iconfake=0\relax%%
      \nvt@realicon{#2}%%
    \else%%
      \sbox0{{\nvt@gray{8}\rule{.24in}{.18in}}}%%
    \fi%%
    \edef\tmpdesc{\fpeval{.33333*\ht0}pt}%%
    \strut\smash{\raisebox{-\tmpdesc}{\usebox0}}%%
  \fi%%
  \endgroup%%
}%%
%%


%% Real icon (if bad, defaults to fake):
\def\nvt@realicon#1{%%
  \def\tmpvalid{1}%%
  \ifnum\tmpvalidate=1\relax\nvt@validateimage{#1}\fi%%
  \ifnum\tmpvalid=0\relax%%
    \nvt@warn{Icon file #1 failed validation.^^J%%
      See Novelette docs for how to fix this problem.^^J%%
      Cannot produce preview or final mode, if not valid.}%%
    \sbox0{{\nvt@gray{8}\rule[-.06in]{.24in}{.18in}}}%%
  \else%%
    \@ifundefined{#1 image:I}{%%
      \saveimageresource attr{/Interpolate true}{#1}%%
      \sbox0{\useimageresource\lastsavedimageresourceindex}%%
      \expandafter\xdef\csname #1 image:I\endcsname
        {\useimageresource\the\lastsavedimageresourceindex}%%
      \wlog{<#1, id=\the\lastsavedimageresourceindex, interpolate=true>}%%
    }{%%
      \sbox0{\csname #1 image:I\endcsname}%%
    }%%
  \fi%%
  \edef\tmpfit{\fpeval{(\ht0 > .184in) + (\wd0 > .244in)}}%%
  \ifnum\tmpfit>0\relax%%
    \nvt@warn{Icon #1 is too large.^^J%%
      \spii Max width 0.24in, height 0.18in.}%%
  \fi%%
}%%
%%


%% Image or Icon file validation:
\def\nvt@validateimage#1{%%
  \directlua{nvt.validateimage('\luaescapestring{#1}')}%%
}%%
