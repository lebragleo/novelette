%% UNAVAILABLE COMMANDS:
%%   Novelette does not use many standard LaTeX commands, but instead uses other methods.
\def\nvt@nocmd#1{%%
  \nvt@warn{Novelette has no command #1.^^J%%
    \spii See these commands: \string\namedefault, \string\subnamedefault,^^J%%
    \spii\string\headstyle, and options for block environment.}
}%%
\def\footnotesize{\nvt@nocmd{\string\footnotesize}}
\def\tiny{\nvt@nocmd{\string\tiny}}
\def\scriptsize{\nvt@nocmd{\string\scriptsize}}
\def\small{\nvt@nocmd{\string\small}}
\def\large{\nvt@nocmd{\string\large}}
\def\Large{\nvt@nocmd{\string\Large}}
\def\LARGE{\nvt@nocmd{\string\LARGE}}
\def\huge{\nvt@nocmd{\string\huge}}
\def\Huge{\nvt@nocmd{\string\Huge}}
\def\HUGE{\nvt@nocmd{\string\HUGE}}
\DeclareDocumentCommand\textls{O{}+m}{\nvt@nocommand{\string\textls}#2}
