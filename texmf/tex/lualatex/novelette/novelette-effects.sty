%% PLACEHOLDER \next for chapter/scene numbers:
%%   Novelette does not have automatic chapter/scene numbers. Do it yourself. In draft mode,
%% the \next command prints ## there, as a reminder that you must later change it to whichever
%% number is necessary. If any \next remains, you cannot move to preview or final mode.
\newif\ifnvt@didnext %% Become true if 1 or more \next used.
\newcommand\next{%%
  \#\#%% Two ## placed at this Unicode slot.
  \global\nvt@didnexttrue\directlua{nvt.countnext=nvt.countnext+1}%%
  \obeyspaces%%
}%%
