%% NAME: \name[option]{one line of content}
%% SUBNAME: \subname[option{one line of content}
%%   These commands may only be used in display zones. There is no particular meaning to either
%% \name or \subname. They are merely convenient commands for styling non-main text. You may use
%% either command repeatedly, in any order, in the same display zone. Whether or not you set
%% \name to be more or less prominent than \subname, is your design choice. Although these
%% commands are intended for such purposes as chapter titles, Novelette does not care why you
%% use them. There is no automatic chapter numbering (see \next command, for placeholder).
%%   If you do not like the built-in defaults, you may change the default styles by setting
%% \namestyle and \subnamestyle in Preamble. In any case, you may locally change the style
%% via command option. Anything not set by option will retain its gloal default value.
%%   The scale will necessarily affect the vertical space, which will usually be a non-integer
%% number of lines. No problem, since line grid is restored at \maintext. You will need to add
%% or subtract lines from the bottom of the display zone, if you wish to have \maintext start
%% at a particular line.
\def\nvt@noparthere{%%
  \nvt@err{Cannot use \string\par, \noexpand\\, or \string\linebreak^^J%%
    \spii inside \string\name, \string\subname, or \string\scenetext.}%%
}%%
\newif\ifnvt@instyle %% True within \name, \subname, and \scenetext commands.
\DeclareDocumentCommand\name{O{}+m}{%% +m will be re-parsed as m.
  \ifnvt@indisplay\def\tmpok{1}\else\def\tmpok{0}\fi%%
  \ifnvt@instyle\def\tmpok{0}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \begingroup\nvt@instyletrue%%
  \ifnum\tmpok=1\relax%%
    \par\vspace*{-\nvt@bls}\strut\par%%
    \setlength\parindent{0pt}%%
    \def\tmpfn{-1}\def\tmpcase{-1}\def\tmpalign{-1}\def\tmpauto{-1}%%
    \def\tmpscale{}\def\tmptrack{}\def\tmpnofont{}%%
    \directlua{nvt.parsenamestyle('\luaescapestring{#1}')}%%
    \ifnum\tmpreturn=1\relax%%
      \ifnum\tmpfn=-1\relax\def\tmpfont{\nvt@namefont}\def\tmpsp{\nvt@namesp}\fi%%
      \ifnum\tmpfn=0\relax\def\tmpfont{\normalfont}\fi%%
      \ifnum\tmpfn=1\relax\def\tmpfont{\nvt@dark}\fi%%
      \ifnum\tmpfn=2\relax\def\tmpfont{\nvt@thick}\fi%%
      \ifnum\tmpfn=3\relax\def\tmpfont{\nvt@heavy}\fi%%
      \ifnum\tmpfn=4\relax\def\tmpfont{\nvt@wide}\fi%%
      \ifnum\tmpfn=5\relax\def\tmpfont{\nvt@srir}\fi%%
      \ifnum\tmpfn=6\relax\def\tmpfont{\nvt@gero}\fi%%
      \ifnum\tmpfn=7\relax\def\tmpfont{\nvt@black}\fi%%
      \ifnum\tmpfn=8\relax\def\tmpfont{\nvt@thin}\fi%%
      \ifnum\tmpfn=9\relax\def\tmpfont{\nvt@icel}\fi%%
      \ifnum\tmpfn=10\relax\def\tmpfont{\nvt@plas}\fi%%
      \ifx\tmptrack\@empty\edef\tmptrack{\nvt@nametrack}\fi%%
      \ifnum\tmpalign=-1\relax\def\tmpleft{\nvt@namel}\def\tmpright{\nvt@namer}\fi%%
      \ifnum\tmpalign=0\relax\def\tmpleft{1}\def\tmpright{1}\fi%%
      \ifnum\tmpalign=1\relax\def\tmpleft{0}\def\tmpright{1}\fi%%
      \ifnum\tmpalign=2\relax\def\tmpleft{1}\def\tmpright{0}\fi%%
      \ifnum\tmpcase=-1\relax\def\tmpraw{\nvt@nameraw}\fi%%
      \ifnum\tmpcase=0\relax\def\tmpraw{RawFeature={+ss17}}\fi%%
      \ifnum\tmpcase=1\relax\def\tmpraw{RawFeature={+smcp,+ss17}}\fi%%
      \ifnum\tmpcase=2\relax\def\tmpraw{RawFeature={+onum,+ss17}}\fi%%
      \ifnum\tmpcase=3\relax\def\tmpraw{RawFeature={+smcp,+onum,+ss17}}\fi%%
      \ifnum\tmpcase=4\relax\def\tmpraw{RawFeature={+titl,+lnum,+ss17}}\fi%%
\def\tmpraw{}%% 
      \ifx\tmpscale\@empty\edef\tmpscale{\nvt@namescale}\fi%%
      \ifnum\tmpauto=-1\relax\edef\tmpauto{\nvt@nameauto}\fi%%
      \edef\tmpd{\fpeval{(0.23*\tmpscale*\nvt@em)+\nvt@linegap}pt}%%
      \edef\tmph{\fpeval{(0.84*\tmpscale*\nvt@em)+\tmpd}pt}%%
      \edef\tmpws{\fpeval{\tmpscale < 1.01}}%%
%%      \ifnum\tmpws=1\relax\def\tmpstrut{\strut}\else
\def\tmpstrut{\rule[-\tmpd]{0pt}{\tmph}}%%\fi%%
      \edef\tmpspace{\fpeval{(\tmpscale*\tmpsp + .02*\tmptrack)*\nvt@em}pt}%%
      \def\tmpfeat{\nvt@aff{\tmpraw,Scale=\tmpscale,LetterSpace=\tmptrack}}%%
    \else%%
      \nvt@err{Bad option for \string\name.^^J%%
        \spii Format: \string\name[font=F,scale=S,track=T,align=A,case=C]{content}^^J%%
        \spiv F -> main dark thick heavy black wide thin icel gero plas. Default \nvt@namefn.^^J%%
        \spiv S -> Number 1<=S<=4. May be decimal. Default \nvt@namescale.^^J%%
        \spix If followed by a, will auto-adjust slightly over-wide content.^^J%%
        \spiv T -> Integer 0-9. Tracking, tight to very loose. Default \nvt@nametrack.^^J%%
        \spiv A -> center left right. Default \nvt@namealign.^^J%%
        \spiv C -> none titl smcp onum smon. Ignored unless font=main. Default \nvt@namecn.^^J%%
        \spix none -> No changes.^^J%%
        \spix titl -> Lowercase letters become titling caps.^^J%%
        \spix smcp -> Lowercase letters become small caps.^^J%%
        \spix onum -> Numerals become oldstyle.^^J%%
        \spix smon -> Combines smcp and onum.}%%
    \fi%%
    \ifx\tmpnofont\@empty\else%%
      \nvt@err{Requested font '\tmpnofont' but did not load it.^^J%%
      \spii Fix: In Preamble, write \string\loadfont{\tmpnofont}.}%%
      \def\tmpfont{\nvt@namefont}\def\tmpsp{\nvt@namesp}%%
    \fi%%
    \def\par{\nvt@noparthere}\def\\{\nvt@noparthere}\def\linebreak{\nvt@noparthere}%%
    \sbox0{{\tmpfont\tmpfeat\spaceskip=\tmpspace\char"200D{#2}\char"200D}}%%
    \edef\tmpwdz{\the\wd0}%%
    \edef\tmpwide{\fpeval{\wd0 > \textwidth}}%%
    \ifnum\tmpwide=1\relax%%
      \ifnum\tmpauto=1\relax%%
        \edef\tmpnewscale{\fpeval{0.999*\tmpscale*\textwidth/\wd0}}%%
        \edef\tmpd{\fpeval{(0.23*\tmpnewscale*\nvt@em)+\nvt@linegap}pt}%%
        \edef\tmph{\fpeval{(0.84*\tmpnewscale*\nvt@em)+\tmpd}pt}%%
        \edef\tmpws{\fpeval{\tmpscale < 1.01}}%%
        \ifnum\tmpws=1\relax\def\tmpstrut{\strut}\else\def\tmpstrut{\rule[-\tmpd]{0pt}{\tmph}}\fi%%
        \edef\tmpnewspace{\fpeval{(\tmpnewscale*\tmpsp + .02*\tmptrack)*\nvt@em}pt}%%
        \def\tmpnewfeat{\nvt@aff{\tmpraw,Scale=\tmpnewscale,LetterSpace=\tmptrack}}%%
        \sbox0{{\tmpfont\tmpnewfeat\spaceskip=\tmpnewspace\char"200D{#2}\char"200D}}%%
        \edef\tmpnewwide{%%
          \fpeval{(\wd0 > \textwidth) + (\tmpnewscale < 1) + (\tmpnewscale/\tmpscale < 0.88)}%%
        }%%
        \ifnum\tmpnewwide=0\relax%%
          \edef\tmpnewscaletrunc{\fpeval{trunc(\tmpnewscale,3)}}%%
          \typeout{Alert: Auto-adjusted \string\name\space scale from \tmpscale\space %%
            to \tmpnewscaletrunc.}%%
        \else%%
          \edef\tmphowmuch{\fpeval{ceil(100*\wd0/\textwidth,2)}}%%
          \nvt@err{Content of \string\name\space is too wide. Must fit on one line.^^J%%
            \spii Measured content width is \tmphowmuch\@percentchar\space of max textwidth.^^J%%
            \spii Unable to auto-adjust. Reduce content or reduce scale.}%%
          \sbox0{\tmpfont\tmpfeat\spaceskip=\tmpspace{\char"FFFD}}%%
        \fi%%
      \else%%
        \edef\tmphowmuch{\fpeval{ceil(100*\wd0/\textwidth,2)}}%%
        \nvt@err{Content of \string\name\space is too wide. Must fit on one line.^^J%%
          \spii Measured content width is \tmphowmuch\@percentchar\space of max textwidth.^^J%%
          \spii Reduce content or reduce scale.}%%
        \sbox0{\tmpfont\tmpfeat\spaceskip=\tmpspace{\char"FFFD}}%%
      \fi%%
    \fi%%
    \ifnum\tmpleft=1\relax\tmpstrut\hfill\fi%%
    \smash{\usebox0}%%
    \ifnum\tmpright=1\relax\hfill\tmpstrut\fi\nvt@par%%
    \vspace{-\nvt@bls}\strut\nvt@par%%
  \else%%
    \nvt@err{Command \string\name\space may only be used within display zones.^^J%%
      \spii It may not be nested, or used within block environment.}%%
    \char"FFFD\obeyspaces%%
  \fi%%
  \endgroup%%
}%%
