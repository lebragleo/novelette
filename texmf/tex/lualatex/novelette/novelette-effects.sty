%% Decorative Lines::
\DeclareDocumentCommand\surf{}{%% wavy swung dash
  \par\vspace*{\nvt@bls}\strut\par%%
  \strut\hfill%%
  \smash{{\normalfont\upshape\nvt@aff{Scale=2,RawFeature={+cv59}}\char"2053}}%%
  \hfill\strut\par%%
}%%
\DeclareDocumentCommand\squid{}{%% inverted X with sidecars
  \par\vspace*{\nvt@bls}\strut\par%%
  \strut\hfill%%
  \smash{{\normalfont\upshape\nvt@aff{Scale=2,RawFeature={+cv59}}\char"2756}}%%
  \hfill\strut\par%%
}%%
