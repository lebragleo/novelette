%% INITIAL LETTER(S): \init{character} also starred \init*
%%   The \init command scales its character to larger than normal size. It may be used immediately
%% beneath \maintext. Typically, this is at the start of a chapter.
%%   You cannot use \init anywhere other than the above-mentioned places. If you do that,
%% the character prints at normal size, and a warning results.
%%   The {character} may include preceding punctuation, such as quotes, guillemet, or Spanish
%% inverted marks. Except for Dutch IJ, use only a single alphabetic character. Do not use
%% \init for creating a numbered list. You may choose to place the following few words in
%% small caps, for an interesting effect.
%%   A blank line is inserted above \init, to prevent the enlarged character from crashing into
%% whatever is above it. The descender on characters such as Ccedilla will not crash into
%% the line below.
%%   The enlarged character kerns against its surrounding U+2060 control characters. At left,
%% that absorbs excess bearing. At right, it lets T hang above the following text. Feature ss20
%% adjusts some characters for proper appearance at scale.
%%   If the following text is too close for your taste, use \init*{character}. That inserts
%% a tiny amount of space between the initial character and whatever follows.
\DeclareDocumentCommand\init{sm}{%%
  \ifvmode\def\tmpok{1}\else\def\tmpok{0}\fi%%
  \def\tmptest{1}\ifx\nvt@initscale\tmptest\relax\def\tmpok{0}\fi%%
  \ifnvt@infootnote\def\tmpok{0}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%%
  \ifnvt@indisplay\def\tmpok{0}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@instyle\def\tmpok{0}\fi%%
  \begingroup\let\itshape\relax%%
  \def~{\hspace{.2\nvt@em}}%%
  \ifnum\tmpok=1\relax%%
    \sbox1{%%
      \nvt@aff{RawFeature={-smcp,-c2sc,+ss20},Scale=\nvt@initscale,FakeStretch=.94}%%
        \char"2060{#2}\char"2060%%
    }%%
    {\strut\smash{\usebox1}}%%
    \IfBooleanTF{#1}{\hspace{.04em}}{}%%
  \else
    \nvt@warn{\string\init only allowed at start of paragraph following ^^J%%
      \spii \string\maintext. Do not use \string\indent, or \string\noindent\space there.}%%
    {#2}%%
  \fi%%
  \endgroup%%
  \obeyspaces%%
}%%
