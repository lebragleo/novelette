%% SCENE: \scenetext[option]{content}  see also \sceneimage in graphics file.
%%   The simplest scene breaks are one or more \blankline, possible with \dinkus where needed.
%% You may also use ordinary text, perhaps aligned via the block environment. Or you may use
%% an ordinary image.
%%   But if a chapter of your story has distinct sub-chapters, each with its own name, then the
%% \scenetext command may be useful. This creates a three-line gap between paragraphs. The first
%% line is always blank, and is omitted if the \scenetext happens to fall at the top of a page.
%% If you prefer a larger gap, use \blankline before or after \scenetext.
%%   The \scenetext content must fit on one line, maximum width 4in regardless of layout. The text
%% sits slightly below the middle of the other two lines. Its is styled to be slightly different
%% than normal text. The first paragraph following \scenetext is not indented.
%%   Scenes have no automatic numbering. Do it yourself. See the \next command.
\newif\ifnvt@inscenetext %% True within \scenetext.
\DeclareDocumentCommand\scenetext{O{}+m}{%% +m will be re-parsed as m.
  \ifnvt@instyle\def\tmpok{0}\else\def\tmpok{1}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@inscenetext\def\tmpok{0}\fi%%
  \ifnvt@insceneimage\def\tmpok{0}\fi%%
  \begingroup\nvt@inscenetexttrue%%
  \ifnum\tmpok=1\relax%%
    \par\edef\tmppgtot{\fpeval{\pagetotal = 0pt}}%%
    \ifnum\tmppgtot>0\relax\strut\par\vspace*{-2\nvt@bls}\fi%%
    \vspace{\nvt@bls}\vspace*{-\nvt@bls}\blankline\nopagebreak%%
    \setlength\parindent{0pt}%%
    \def\tmpscalign{-1}\def\tmpscleft{\nvt@scleft}\def\tmpscright{\nvt@scright}\def\tmpfont{}%%
    \def\textit##1{##1}\def\it##1{##1}%%
    \def\smcp##1{##1}\def\SMCP##1{##1}\def\Smcp##1{##1}\def\onum##1{##1}%%
    \directlua{nvt.parsescenestyle('\luaescapestring{#1}','scene')}%%
    \ifnum\tmpscreturn=1\relax%%
      \ifnum\tmpscalign=0\relax\def\tmpscleft{\strut\hfill}\def\tmpscright{\hfill\strut}\fi%%
      \ifnum\tmpscalign=1\relax\def\tmpscleft{}\def\tmpscright{\hfill\strut}\fi%%
      \ifnum\tmpscalign=2\relax\def\tmpscleft{\strut\hfill}\def\tmpscright{}\fi%%
      \sbox0{\nvt@aff{RawFeature={+titl,+case},Scale=1.08,FakeStretch=.96,LetterSpace=4}%%
        \char"200D{#2}\char"200D}%%
      \edef\tmpfit{\fpeval{\wd0 > 4in}}%%
      \ifnum\tmpfit=1\relax%%
        \nvt@warn{\string\scenetext\space content width exceeds 4in. Too wide.}%%
        \sbox0{\char"FFFD\space \string\scenetext\space content is too wide.}%%
      \fi%%
      \strut\tmpscleft\smash{\raisebox{-.108\nvt@em}{\usebox0}}\tmpscright\strut\par%%
    \else%%
      \nvt@err{Bad \string\scenetext[option]{content} command.^^J%%
      \spii Option: [align=A]^^J%%
      \spiv A -> left right center. Default \nvt@scalign.^^J%%
      \spii Content must fit on one line, max width 4in.^^J%%
      \spii Text is specially styled for this purpose. Ignores other styling.}%%
      {\char"FFFD}%%
    \fi%%
  \else%%
    \nvt@err{Command \string\scenetext\space cannot be nested in itself,^^J%%
      \spii or used in \string\sceneimage, \string\name, \string\subname, or block environment.}%%
    \char"FFFD\obeyspaces%%
  \fi%%
  \endgroup\nopagebreak\blankline%%
}%%
