%% RE-DEFINE \line:
%%   The standard LaTeX \line is not needed, so it is re-defined. Novelette \line is an \hrule
%% with minimum and maximum dimensions, vertically padded to always occupy half-baselineskip.
%%   To track possible layout changes, the width must be measured in normal em. The thickness
%% is a number without units (requesting units would likely cause user confusion).
\def\line#1{%%
  \def\tmpshow{1}\def\tmpleft{\hfill}\def\tmpright{\hfill}%%
  \def\tmpwidth{10em}\def\tmpthick{.76pt}%%
  \ifnvt@indisplay\def\tmpok{1}\else\def\tmpok{0}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@infootnote\def\tmpok{0}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%
  \ifnum\tmpok=1\relax%%
    \par\vspace*{-\nvt@bls}\strut\par%%
    \directlua{nvt.parseline('\luaescapestring{#1}')}%%
    \ifnum\tmpreturn=1\relax%%
      \ifnum\tmpshow=1\relax%%
        \vspace*{-.25\nvt@bls}%%
        \strut\tmpleft\smash{\rule[-\tmpdrop]{\tmpwidth}{\tmpthick}}\tmpright\strut\par%%
        \vspace{-.25\nvt@bls}%%
      \else%%
        \vspace*{-.25\nvt@bls}\strut\par\vspace*{-.25\nvt@bls}%%
      \fi%%
    \else%%
      \nvt@err{Bad \string\line{align=A,width=W,thick=T}.^^J%%
        \spii Novelette re-defines standard LaTeX \string\line. Format:^^J%%
        \spiv A -> left right center. Default center.^^J%%
        \spiv W -> must have units 'em', not 'pt' or any other. Default 10em.^^J%%
        \spix Good: width=5.63em. Bad: width=14pt.^^J%%
        \spix Recommended minimum width 4em.^^J%%
        \spix If too wide, W is silently truncated to textwidth.^^J%%
        \spix W=100em produces full-width line.^^J%%
        \spiv T -> number 1-9, without units. May be decimal. Default 1.^^J%%
        \spix Produces line thickness at multiples 0.75pt.}%%
      \def\tmpbadline{%%
        {\nvt@aff{Scale=.6}\char"2327 bad \textbackslash line \char"2327}%%
      }%%
      \vspace*{-.25\nvt@bls}%%
      \strut\tmpleft\smash{\tmpbadline}\tmpright\strut\par%%
      \vspace{-.25\nvt@bls}%%
    \fi%%
  \else%%
    \nvt@err{Cannot use \string\line\space outside display zone, or within block}%%
  \fi%%
}%%
