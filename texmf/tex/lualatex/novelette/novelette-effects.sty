%% OVERVIEW:
%%   This file defines several environments and commands that are used for special text effects.
%% Some of them may only be used in certain locations. Inappropriate usage will throw an error
%% or warning, and the effect will be ignored.


%% TABLE OF CONTENTS:
%%   Most popular fiction does not have a table of contents. But if your book is a collection
%% of short stories, or a novel with distinctive chapter names, then it might have the table.
%%   Novelette cannot generate a table of contents. If you need one, you must design it yourself,
%% and must manually write the page numbers after you know them (when almost finished).
%%   The \next command is a placeholder. It prints ## there. Later, you will replace each \next
%% with actual page numbers. If you request preview or final mode, any \next is an error.
%%   To create the table, use a component, with option [toc]. The table name, and possibly other
%% material, must precede \maintext. Then use a block environment to hold the table entries.
%% The block may be [center] or symmetric side offsets. If using offsets, you will needto
%% decide how much to use, depending on the length of entry texts.
%%   Use the \entry{name}{page} command to create nice-looking entries. If the block is [center]
%% then 6 spaced dots will separate the name from the page number (temporarily \next).
%% If the block uses offsets, then the number of dots will be whatever is needed per-line.
%% When an entry requires a short description, write it beneath its \entry.
%%   Command \padentry{number} may be used, prior to the first \entry. The number is decimal
%% from 0 to 1. This addes that amount of baselinekip above each \entry. For example,
%% \padentry{0.5} adds half a baselineskip gap above each \entry. This is useful if you wish to
%% stretch the table. for better visual balance.
%%   You may use \image, but not within a block environment, so place any \image before or after
%% the block of entries.
%%   If your book has both a dedication and a table of contents, the table is second. However,
%% if the decidation is short, you may cheat: Write it between the table name and the entries,
%% instead of using a separate dedication page.
%%   The table may extend to a second page (or more).
\def\nvt@entrypad{0pt} %% Default.
\DeclareDocumentCommand\padentry{m}{%% Argument is a decimal 0-2, multiple of baselineskip.
  \ifnvt@indisplay%%
    \directlua{nvt.parseentry('\luaescapestring{#1}')}%%
    \ifnum\tmpreturn=0\relax%%
      \nvt@warn{Bad \string\padentry. Ignored. ^^J%%
        Syntax: \string\padentry{decimal number from 0 to 2}.}%%
    \fi%%
  \else%%
    \nvt@warn{Cannot use \string\padentry\space outside display zone. Ignored.}%%
  \fi%%
}%%
\DeclareDocumentCommand\entry{mmm}{%% \entry{integer}{name}{page} -> 24. Revenge . . . 228
  \ifnvt@indisplay%%
    \sbox0{0#1.#2 . . . 00#3}\edef\tmpl{\fpeval{\wd0>\linewidth}}%%
    \ifnum\tmpl=1\relax\nvt@warn{\string\entry{#1}{#2} too long for one line.}\fi%%
    \par\vspace*{\nvt@entrypad}\strut#1 \dotfill\space#2\strut\par%%
  \else%%
    \nvt@warn{Cannot use \string\entry\space outside display zone.}%%
    \par\strut\sbox1{\char"FFFD\relax entry}%%
    \char"FFFD\relax entry\hspace{-\wd1}\smash{\rule[-.25em]{\wd1}{1pt}}%%
    \space cannot be used here.\par%%
  \fi%%
}%%
%%


%% BLANK PAGE: Never inserted automatically. For your own use, but only if necessary.
\newcommand\blankpage{%%
  \clearpage\nvt@thispagestyle{empty}\null\clearpage\stepcounter{nvt@expectpage}%%
}%%
%%


%% BLANK VERSO: Automatically inserted where necessary. Not a user command.
\def\nvt@blankverso{%%
  \clearpage%%
  \ifodd\c@page\else%%
    \nvt@thispagestyle{empty}\null\clearpage\stepcounter{nvt@expectpage}%%
  \fi%%
}%%
%%


%% BLANK LINE: \blankline
%%   The simplest scene break is a blank line, although this may be used for other purposes.
%% May repeat for more lines. The first line of text, following a \blankline, is not indented.
%%   Also use \blankline in a display zone, to change where the first line of \maintext prints.
\newcommand\blankline{\par\null\@afterindentfalse\@afterheading}%%
%%


%% DINKUS:
%%   This is the traditional typesetter term for a non-empty line, used as a scene break.
%% A \dinkus is used instead of \blankline when the gap would be first or last on a page,
%% where the blank line might not be noticed. It consists of three widely-spaced low asterisks.
%% The following line is not indented.
\newcommand\dinkus{%%
  \par\noindent%%
  \nvt@center%%
  \strut\upshape\char"204E\hspace{2em}\char"204E\hspace{2em}\char"204E\par%%
  \nvt@endcenter%%
  \@afterindentfalse\@afterheading%%
}%%
%%


%% KEY TEXT: Optional use with block environment.
%%   Sometimes, a poem or epigraph will look best when the position of its block is determined
%% by the width of a sample line of text, which may or may not be in the block itself.
%%   Set \key{line of text} before the block that needs it. The key remains effective for
%% additional blocks, until changed by another \key. To use it, choose the related block options.
%%   The key text may use Italics, small caps, and other features allowed in ordinary main text.
%% Limits: The key width must not exceed the textwidth, and may not be narrower than four normal
%% paragraph indents.
%%   The key width is measured within the block, taking size=normal|small into account,
%% but without paragraph indent. If the key must be measured with paragraph indent,
%% write \key{\indent line of text}.
%%   The key text does not print. Its only purpose is to provide a measurement. Typically, the
%% key text will also be the first line of the block text (for an epigraph), or some average-width
%% line (for a poem). But this is not required; the key text is not necessarily in the block.
\edef\nvt@halfkeydiff{0pt} %% Placeholder.
\newif\ifnvt@goodkey %% True when key width is at least 4*\nvt@parindent, but less than textwidth.
\def\nvt@keyerr{%%
  \nvt@err{Bad \string\key. Only one line: no wrap or \noexpand\\ or \string\par.}%%
  \nvt@goodkeyfalse%%
}%%
\DeclareDocumentCommand\key{+m}{%% +m converted to m within definition.
  \ifnvt@instyle\def\tmpok{0}\else\def\tmpok{1}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@infootnote\def\tmpok{0}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%%
  \ifnum\tmpok=1\relax%%
    \begingroup\def\par{\nvt@keyerr}\def\\{\nvt@keyerr}%%
    \sbox0{#1}%%
    \edef\tmpbad{\fpeval{(\wd0 < 4*\nvt@parindent) + (\wd0 > \textwidth)}}%%
    \ifnum\tmpbad=1\relax%%
      \global\nvt@goodkeyfalse\xdef\nvt@halfkeydiff{\fpeval{2*\nvt@parindent}pt}%%
    \else%%
      \global\nvt@goodkeytrue\xdef\nvt@halfkeydiff{\fpeval{(\textwidth-\wd0)/2}pt}%%
    \fi%%
    \endgroup%%
  \else%%
    \nvt@err{Cannot set \string\key\space there. The setting cannot be within a block,^^J%%
      \spii or within any type of styling command.}%%
    \global\nvt@goodkeyfalse%%
  \fi%%
}%%
%%


%% BLOCK ENVIRONMENT:  \begin{block}[L/R,align=A,size=S] ... \end{block}
%%   The block environment may be used for block quotes, epigraphs, poems, and other situations
%% where the text is distinctive. The block may contain one or more paragraphs, and may span pages
%% You may not place images within the block, or nest one block within another.
%%   If a block is within a display zone, you may choose size=normal or size=small. Elsewhere,
%% only size=normal (default) may be used.
%%   The sides of the block are offset from the margins by L/R. When L and/or R is a number,
%% docimals are allowed, but integers are strongly preferred. The number is the multiple of
%% normal paragraph indents, by which that side of the block is offset from the margin.
%% Default is [2/0], which is typical for ordinary block quotes.
%%   Alternatively, L and/or R may be the letter k. Novelette calculates the value of k,
%% based on prior \key{text} setting. The value is half the difference between the full textwidth
%% and the width of typeset key text (although it is not printed). See the \key command.
%% Setting [k/k] is particularly useful for prose epigraphs; [k/0] is useful for poetry.
%%   Limits: 0<=L<=8, 0<=R<=8. This also applies when a calculated k is used for
%% either or both sides of the block.
%%   Within the block, align=A sets text justification. If not set, text is justified and
%% hyphenated as usual, and each paragraph is indented (you may use \noindent). If A is one of
%% left, right, center, then no hyphenation and no indent.
\newif\ifnvt@inblock %% True within block environment.
\DeclareDocumentEnvironment{block}{O{}}{%%
  \par\strut\par\vspace{-\nvt@bls}%% Ensure fresh line.
  \ifnvt@infootnote\nvt@fatal{Cannot place block environment in a footnote, page \thepage.}\fi%%
  \ifnvt@inheader\nvt@fatal{Cannot place block environment in page headers.}\fi%%
  \def\tmpblockalign{0}%%
  \ifnvt@inblock%%
    \nvt@err{Cannot nest a block environment within another block.^^J%%
    \spii How to fix: Use separate blocks, each with its own options.}%%
    \strut\char"FFFD \smcp{bad nested block environment} \char"FFFD\par%%
  \else%%
    \begingroup\def\tmpblockleft{2}\def\tmpblockright{0}%%
    \ifnvt@indisplay%%
      \directlua{nvt.parseblock('\luaescapestring{#1}','D')}%%
    \else%%
      \directlua{nvt.parseblock('\luaescapestring{#1}','M')}%%
    \fi%%
    \ifnum\tmpblocksize=-2\relax%%
      \nvt@warn{Block option [size=small] ignored outside display zone.}%%
      \def\tmpblocksize{0}%% normal size
    \fi%%
    \ifnum\tmpreturn=0\relax%%
      \nvt@err{Bad option for block. Unknown settings or bad side margins.^^J%%
        \spii Note: If block content begins with [ character, use \string\[ there.^^J%%]]
        \spii Option format: [L/R,align=A,size=S]^^J%%
        \spiv L and/or R -> left/right block side offsets, relative to margins.^^J%%
        \spix Numerical values may be decimal, but integers strongly preferred.^^J%%
        \spxi Value is multiple of normal paragraph indent.^^J%%
        \spxi Limits: 0<=L<=8, 0<=R<=8, (L+R)<=12.^^J%%
        \spix Alternative: The letter k may be used for L and/or R.^^J%%
        \spxi The value of k is calculated, based on prior \string\key{text}.^^J%%
        \spxi Limits: Width of key text must be^^J%%
        \spxi\spiv (4*parindent)<=keywidth<=textwidth.^^J%%
        \spiv A -> center left right justify. Default justify.^^J%%
        \spix Text alignment within block, relative to block offsets.^^J%%
        \spix If justify (or not set), normal hyphenation and paragraph indent.^^J%%
        \spix If not justify, hyphenation disabled and no paragraph indent.^^J%%
        \spiv S -> normal small. Default normal. Text size and baselineskip.^^J%%
        \spix Only display zone allows size=small.}%%
      \strut\char"FFFD \smcp{bad option for block environment} \char"FFFD\par%%
    \else%%
      \ifnum\tmpblocksize=1\relax\nvt@small\vspace{\tmpsmtop}\fi%% headroom
      \ifnum\tmpblockleft=-99\relax%% key at left
        \edef\tmpblockoffsetleft{\nvt@halfkeydiff}%%
        \ifx\nvt@goodkey\else%%
          \nvt@err{Width of \string\key{text} is greater than textwidth,^^J%%
            \spii or less than 4 normal paragraph indents,^^J%%
            \spii or key text was not set before using key in block option.}%%
        \fi%%
      \else%% numerical value at left
        \edef\tmpblockoffsetleft{\fpeval{\tmpblockleft*\nvt@parindent}pt}%%
      \fi%%
      \ifnum\tmpblockright=-99\relax%% key at right
        \edef\tmpblockoffsetright{\nvt@halfkeydiff}%%
        \ifx\nvt@goodkey\else%%
          \nvt@err{Width of \string\key{text} is greater than textwidth,^^J%%
            \spii or less than 4 normal paragraph indents,^^J%%
            \spii or key text was not set before using key in block option.}%%
        \fi%%
      \else%% numerical value at right
        \edef\tmpblockoffsetright{\fpeval{\tmpblockright*\nvt@parindent}pt}%%
      \fi%%
      \nvt@inblocktrue%%
      \setlength{\leftmargin}{\tmpblockoffsetleft}%%
      \setlength{\rightmargin}{\tmpblockoffsetright}%%
      \advance\linewidth -\leftmargin%%
      \advance\linewidth -\rightmargin%%
      \advance\@totalleftmargin\leftmargin%%
      \@setpar{{\@@par}}%%
      \parshape 1 \@totalleftmargin \linewidth%%
      \ifnum\tmpblockalign>0\relax%%
        \setlength\parindent{0pt}\hyphenpenalty 10000\relax\exhyphenpenalty 10000\relax%%
      \fi%%
      \ifnum\tmpblockalign=1\relax\nvt@center\fi%%
      \ifnum\tmpblockalign=2\relax\nvt@raggedright\fi%%
      \ifnum\tmpblockalign=3\relax\nvt@raggedleft\fi%%
      \ignorespaces%%
    \fi%%
  \fi%%
}{%%
  \ifnvt@inblock%%
    \par\ifnum\tmpblockalign=1\relax\nvt@endcenter\fi%%
    \endgroup%%
    \vspace*{-\nvt@bls}\strut\par%% Ensure enough space beneath small block.
  \fi%%
}%%
%%


%% STYLES: \styleN[option]{one line of content} where N is integer 1-9. (0 for developer test)
%%   These commands may only be used in display zones. There is no particular meaning; they are
%% merely commands for styling non-main text. You may use them repeatedly, in any order, in the
%% same display zone. Although these commands are intended for such purposes as chapter titles,
%% Novelette does not care why you use them.
%%   Each \styleN has its font, scale, track, align, and case set by \setstyleN commands
%% in preamble, or the built-in defaults (if unset by user). These are fixed. The local
%% \styleN[option] only affects whether info is written to Terminal (console).
%%   There is no automatic chapter numbering (see \next command, for placeholder).
\def\nvt@noparthere{%%
  \nvt@err{Cannot use \string\par, \noexpand\\, or \string\linebreak^^J%%
    \spii inside \string\styleN (N=1-9), or \string\scene.}%%
}%%
\def\nvt@badstyle#1{%%
  \nvt@err{Do not write \string\style{N}[option]{text}.^^J%%
    \spii Write \string\styleN[option]{text} with N=1-9.}%%
    \char"FFFD\space%%
}%%
\def\style{\@ifnextchar\bgroup\nvt@badstyle\nvt@stylecmd}
\newif\ifnvt@instyle %% True within \styleN and \scene commands.
\DeclareDocumentCommand\nvt@stylecmd{mO{}+m}{%% +m will be re-parsed as m.
  \begingroup%%
  \directlua{nvt.parsestyle('\luaescapestring{#1}','\luaescapestring{#2}')}%%
  \ifnum\tmpreturn=-99\relax%%
    \nvt@fatal{Cannot use \string\styleN\space in preamble.^^J%%
      Did you mean \string\setstyleN\space instead (N=1-9) ?}%%
  \fi%%
  \ifnum\tmpreturn=-1\relax%%
    \nvt@err{Commands \string\styleN\space (N=1-9) may only be used within display zones.^^J%%
      \spii They may not be nested, or used within block environment.}%%
    \strut\char"FFFD\par%%
  \fi%%
  \ifnum\tmpreturn=0\relax%%
    \nvt@err{Bad \string\styleN[option]{text}.^^J%%
      \spii N must be integer 1-9. Not the letter N or n.^^J%%
      \spii Choices for font, scale, track, align, and case^^J%%
      \spiv are globally fixed by \string\setstyle[N]{choices} in preamble.^^J%%
      \spii Option [info] is the only local possibility:^^J%%
      \spiv It writes the typeset text width to Terminal (console).^^J%%
      \spiv That might be useful for your own design purposes.}%%
      \strut\char"FFFD\par%%
  \fi%%
  \ifnum\tmpreturn=1\relax%%
    \par\vspace*{-\nvt@bls}\strut\par%%
    \setlength\parindent{0pt}%%
    \def\tmpstrut{\rule[-\tmpd]{0pt}{\tmph}}%% %%%%%
    \edef\tmpsp{\fpeval{(\tmpscale*\tmpspace + .02*\tmptrack)*\nvt@em}pt}%% %%%%%
    \def\tmpfeat{\nvt@aff{\tmpraw,Scale=\tmpscale,LetterSpace=\tmptrack}}%% %%%%%
    \def\par{\nvt@noparthere}\def\\{\nvt@noparthere}\def\linebreak{\nvt@noparthere}%%
    \sbox0{{\tmpfont\tmpfeat\spaceskip=\tmpsp\char"200D{#3}\char"200D}}%% %%%%%
    \edef\tmpboxdp{\fpeval{\dp0 > .235*\tmpscale*\nvt@em}}%%
    \ifnum\tmpboxdp=1\relax%%
      \nvt@warn{\string\styleN\space content has disallowed characters.}%%
    \fi%%
    \edef\tmpwdz{\the\wd0}%%
    \edef\tmpwide{\fpeval{\wd0 > \textwidth}}%%
    \ifnum\tmpwide=1\relax%%
      \edef\tmphowmuch{\fpeval{ceil(100*\wd0/\textwidth,2)}}%%
      \nvt@err{Content of \string\styleN\space is too wide. Must fit on one line.^^J%%
        \spii Measured content width is \tmphowmuch\@percentchar\space of max textwidth.^^J%%
        \spii You must reduce content or reduce scale.}%%
      \sbox0{\tmpfont\tmpfeat\spaceskip=\tmpsp{\char"FFFD}}%%
    \fi
    \ifnum\tmpinfo=1\relax%%
      \edef\tmpwdz{\fpeval{round(\wd0/\nvt@em,2)}em}%%
      \typeout{Info: PDFpage \thepage, \string\style#1\space width \tmpwdz.}%%
    \fi%%
    \tmpstrut\tmpleft\smash{\usebox0}\tmpright\tmpstrut\nvt@par%%
    \vspace{-\nvt@bls}\strut\nvt@par%%
  \fi%%
  \endgroup%%
}%%
