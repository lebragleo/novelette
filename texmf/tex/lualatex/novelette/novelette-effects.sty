%% OVERVIEW:
%%   This file defines several environments and commands that are used for special text effects.
%% Some of them may only be used in certain locations. Inappropriate usage will throw an error
%% or warning, and the effect will be ignored.


%% TABLE OF CONTENTS:
%%   Most popular fiction does not have a table of contents. But if your book is a collection
%% of short stories, or a novel with distinctive chapter names, then it might have the table.
%%   Novelette cannot generate a table of contents. If you need one, you must design it yourself,
%% and must manually write the page numbers after you know them (when almost finished).
%%   The \next command is a placeholder. It prints ## there. Later, you will replace each \next
%% with actual page numbers. If you request preview or final mode, any \next is an error.
%%   To create the table, use a component, with option [toc]. The table name, and possibly other
%% material, must precede \maintext. Then use a block environment to hold the table entries.
%% The block may be [center] or symmetric side offsets. If using offsets, you will needto
%% decide how much to use, depending on the length of entry texts.
%%   Use the \entry{name}{page} command to create nice-looking entries. If the block is [center]
%% then 6 spaced dots will separate the name from the page number (temporarily \next).
%% If the block uses offsets, then the number of dots will be whatever is needed per-line.
%% When an entry requires a short description, write it beneath its \entry.
%%   Command \padentry{number} may be used, prior to the first \entry. The number is decimal
%% from 0 to 1. This addes that amount of baselinekip above each \entry. For example,
%% \padentry{0.5} adds half a baselineskip gap above each \entry. This is useful if you wish to
%% stretch the table. for better visual balance.
%%   You may use \image, but not within a block environment, so place any \image before or after
%% the block of entries.
%%   If your book has both a dedication and a table of contents, the table is second. However,
%% if the decidation is short, you may cheat: Write it between the table name and the entries,
%% instead of using a separate dedication page.
%%   The table may extend to a second page (or more).
\def\nvt@entrypad{0pt} %% Default.
\DeclareDocumentCommand\padentry{m}{%% Argument is a decimal 0-2, multiple of baselineskip.
  \ifnvt@indisplay%%
    \directlua{nvt.parseentry('\luaescapestring{#1}')}%%
    \ifnum\tmppad=-1\relax%%
      \nvt@warn{Bad \string\padentry. Syntax: \string\padentry{decimal number from 0 to 2}.}%%
    \else%%
      \edef\nvt@entrypad{\fpeval{\tmppad*\nvt@bls}pt}%%
    \fi%%
  \else%%
    \nvt@warn{Cannot use \string\padentry\space outside component environment.}%%
  \fi%%
}%%
\DeclareDocumentCommand\entry{mm}{%% {name}{page}
  \ifnvt@indisplay%%
    \sbox0{#1 . . . #2}\edef\tmpl{\fpeval{\wd0>\linewidth}}%%
    \ifnum\tmpl=1\relax\nvt@warn{\string\entry{#1}{#2} too long for one line.}\fi%%
    \par\vspace*{\nvt@entrypad}\strut#1 \dotfill\space#2\strut\par%%
  \else%%
    \nvt@warn{Cannot use \string\entry\space outside display environment.}%%
    \par\strut\sbox1{\char"FFFD\relax entry}%%
    \char"FFFD\relax entry\hspace{-\wd1}\smash{\rule[-.25em]{\wd1}{1pt}}%%
    \space cannot be used here.\par%%
  \fi%%
}%%
%%


%% BLANK PAGE: Never inserted automatically. For your own use, but only if necessary.
\def\blankpage{%%
  \clearpage\nvt@thispagestyle{empty}\null\clearpage\stepcounter{nvt@expectpage}%%
}%%
%%


%% BLANK VERSO: Automatically inserted where necessary.
\def\nvt@blankverso{%%
  \clearpage%%
  \ifodd\c@page\else%%
    \nvt@thispagestyle{empty}\null\clearpage\stepcounter{nvt@expectpage}%%
  \fi%%
}%%
%%


%% BLANK LINE: \blankline
%%   The simplest scene break is a blank line, although this may be used for other purposes.
%% May repeat for more lines. The first line of text, following a \blankline, is not indented.
%%   Also use \blankline in a display zone, to change where the first line of \maintext prints.
\def\blankline{\par\null\@afterindentfalse\@afterheading}%%
%%


%% DINKUS:
%%   This is the traditional typesetter term for a non-empty line, used as a scene break.
%% A \dinkus is used instead of \blankline when the gap would be first or last on a page,
%% where the blank line might not be noticed. It consists of three widely-spaced low asterisks.
%% The following line is not indented.
\def\dinkus{%%
  \par\noindent%%
  \nvt@center\strut\upshape\char"204E\hspace{2em}\char"204E\hspace{2em}\char"204E\par\nvt@endcenter%%
  \@afterindentfalse\@afterheading%%
}%%
%%


%% BLOCKLINE TEXT: Optional use with block environment.
%%   Sometimes, a poem or epigraph will look best when the position of its block is determined
%% by the width of a sample line of text, which may or may not be in the block itself.
%%   You may set \blockline{line of text} before the block to which it applies. It remains
%% effective until changed by another \blockline.
%%   You may use Italics, small caps, and other features allowed in ordinary main text. However,
%% the blockline width must not exceed the textwidth less two normal paragraph indents.
%%   The blockline width is measured with beginning paragraph indent. If you need to use it with
%% paragraph indent, write \blockline{\indent line of text} there.
%%   The blockline text does not print. If you write that text in the block (the usual situation),
%% it will not necessarily appear on a single line, unless it is the first line.
\def\nvt@blockline{} %% Default empty.
\def\nvt@sterr{%%
  \nvt@err{Bad \string\blockline. Only one line: no wrap or \noexpand\\ or \string\par.}%%
  \def\tmpok{no}%%
}%%
\long\def\blockline#1{%%
  \begingroup\def\par{\nvt@sterr}\def\\{\nvt@sterr}\def\tmpok{}%%
  \sbox0{#1}\ifx\tmpok\@empty\gdef\nvt@blockline{#1}\fi%%
  \endgroup%%
}%%
%%


%% BLOCK ENVIRONMENT:  \begin{block}[offset=L/R,align=A,text=T,indent=I] ... \end{block}
%%   The block environment may be used for block quotes, epigraphs, poems, and other situations
%% where the text is distinctive. The block may contain one or more paragraphs, and may span pages
%% You may not place images within the block.
%%   You may not nest a block within another. If a block is within a display, it is not affected
%% by any size, font, or alignment commands outside the block.
%%   You may nest the center environment within a block. The centered text will obey the sides
%% set by the block.
%%   Without options, the left side of the block is offset at twice the normal paragraph indent,
%% and not offset at its right side. This is typical of block quotes. Text is normal font,
%% normal size. Paragraphs are indented as usual.
\newif\ifnvt@inblock %% True within block environment.
\DeclareDocumentEnvironment{block}{O{}}{%%
  \par\null\vspace{-\nvt@bls}\begingroup%%
  \ifnvt@infootnote\nvt@fatal{Cannot place block within a footnote, page \thepage.}\fi%%
  \ifnvt@inblock\nvt@fatal{Cannot nest a block within another, page \thepage.}\fi%%
  \ifnvt@inheader\nvt@fatal{Cannot place block within page headers.}\fi%%
  \nvt@inblocktrue%%
  \def\tmpl{2}\def\tmpr{0}\def\tmpt{0}\def\tmpblockalign{0}%%
  \ifnvt@indisplay%%
    \directlua{nvt.parseblock('\luaescapestring{#1}','D')}%%
  \else%%
    \directlua{nvt.parseblock('\luaescapestring{#1}','M')}%%
  \fi%%
  \vspace*{-\nvt@bls}\strut\par\rule{0pt}{\nvt@blh}%%
  \ifnum\tmpt=1\relax\def\nvt@tmpt{1}\nvt@small\else\def\nvt@tmpt{0}\fi%%
  \ifnum\tmpt=2\relax%%
    \nvt@warn{Block option [small] cannot be used outside display zone. Ignored.}%%
  \fi%%
  \def\tmptest{s}\ifx\tmpl\tmptest%%
    \sbox0{\nvt@blockline}%%
    \edef\tmpz{\fpeval{((\textwidth-\wd0)<(2*\nvt@parindent))+(\wd0<4*\nvt@parindent)}}%%
    \ifnum\tmpz>0\relax%%
      \nvt@err{The \string\blockline\space is too wide or too narrow for the block.}%%
      \edef\tmplind{\fpeval{2*\nvt@parindent}pt}\def\tmprind{0pt}%%
    \else%%
      \edef\tmplind{\fpeval{(\textwidth-\wd0)/2}pt}%%
      \def\tmptest{s}\ifx\tmpr\tmptest\def\tmprind{\tmplind}\else\def\tmprind{0pt}\fi%%
    \fi%%
  \else%%
    \edef\tmplind{\fpeval{\tmpl*\nvt@parindent}pt}%%
    \edef\tmprind{\fpeval{\tmpr*\nvt@parindent}pt}%%
  \fi%%
%%    tex.sprint('\\setlength\\parindent{0pt}')
%%    tex.sprint('\\hyphenpenalty 1000\\relax\\exhyphenpenalty 1000\\relax')
%%    tex.sprint('\\doublehyphendemerits 10000\\relax\\finalhyphendemerits 10000\\relax{}')
  \ifnum\tmpreturn=0\relax%%
    \nvt@err{Bad option for block. Unknown settings or bad side margins.^^J%%
      \spii Format: [offset=L/R,align=A,text=T,indent=I]^^J%%
      \spiv L/R may both be numbers (prefer integers), or s/s, or s/0. Default 2/0.^^J%%
      \spix Numbers -> left/right offsets. Multiples of normal paragraph indent.^^J%%
      \spix\spii Limits 0<=L<8, 0<=R<=8, (L+R)<=12.^^J%%
      \spiv s/s and s/0 require prior \string\blockline{text}. See Novelette docs.^^J%%
      \spix s/s -> Block width is width of blockline. Symmetrical offsets.^^J%%
      \spix s/0 -> Block width is width of blockline. All ofset at left.^^J%%
      \spix There is no 0/s. For that effect, manually break lines.^^J%%
      \spiv T -> normal small. Default normal.^^J%%
      \spix If small, reduced text size and baselineskip.^^J%%
      \spix Only display zone allows choice of small or normal.^^J%%
      \spiv A -> center left right justify. Default justify.^^J%%
      \spix Text alignment relative to block offsets.^^J%%
      \spix If not justify, hyphenation disabled.^^J%%
      \spiv I -> 0 or 1. Default 1, normal paragraph indent. 0 means no indent.}%%
  \fi%%
  \setlength{\leftmargin}{\tmplind}%%
  \setlength{\rightmargin}{\tmprind}%%
  \advance\linewidth -\leftmargin%%
  \advance\linewidth -\rightmargin%%
  \advance\@totalleftmargin\leftmargin%%
  \@setpar{{\@@par}}%%
  \parshape 1 \@totalleftmargin \linewidth%%
  \ifnum\tmpblockalign>0\relax\setlength\parindent{0pt}\fi%%
  \ifnum\tmpblockalign=1\relax\nvt@center\fi%%
  \ifnum\tmpblockalign=2\relax\nvt@raggedright\fi%%
  \ifnum\tmpblockalign=3\relax\nvt@raggedleft\fi%%
  \ignorespaces%%
}{%%
  \par\ifnum\tmpblockalign=1\relax\nvt@endcenter\fi%%
%%%%%  \ifnum\nvt@tmpt=1\relax\vspace*{.125\nvt@bld}\fi%%
  \endgroup\vspace*{-\nvt@bls}\strut\par%%
}%%
