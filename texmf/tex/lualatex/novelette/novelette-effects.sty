%% SCENE: \scene[option]{text}  see also \image[scene,option]{filename} in graphics.
%%   The simplest scene breaks are one or more \blankline, possible with \dinkus where needed.
%% You may also use ordinary text, perhaps aligned via the block environment. Or you may use
%% an image.
%%   But if a chapter of your story has distinct sub-chapters, each with its own name, then the
%% \scene command may be useful. This creates a three-line gap between paragraphs. The first
%% line is always blank, and is omitted if the \scene happens to fall at the top of a page.
%% If you prefer a larger gap, use \blankline before or after \scene.
%%   The \scene text must fit on one line, maximum width 3.5in regardless of layout. The text
%% sits slightly below the middle of the other two lines. Its is styled to be slightly different
%% than normal text. The first paragraph following \scene is not indented.
%%   The default \scene alignment is set in preamble by \defaultscene, or center if unset.
%% Option [align=A] is for local over-ride (A = left right center).
%%   Scenes have no automatic numbering. Do it yourself. See the \next command.
\DeclareDocumentCommand\scene{O{}+m}{%% +m will be re-parsed as m.
  \ifnvt@instyle\def\tmpok{0}\else\def\tmpok{1}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@instyle\def\tmpok{0}\fi%%
  \begingroup\nvt@instyletrue%%
  \def\tmpsceneleft{\nvt@sceneleft}\def\tmpsceneright{\nvt@sceneright}%%
  \directlua{nvt.parsescene('\luaescapestring{#1}')}%%
  \ifnum\tmpreturn=-99\relax%%
    \nvt@fatal{Cannot use \string\scene\space in preamble.^^J%%
      Did you mean \string\defaultscene\space instead?}%%
  \fi%%
  \ifnum\tmpreturn=0\relax%%
    \nvt@err{Did not understand \string\scene\space option.^^J%%
      \spii Only option is [align=A] for A -> left right center.}%%
  \fi%%
  \ifnum\tmpok=1\relax%%
    \par\edef\tmppgtot{\fpeval{\pagetotal = 0pt}}%%
    \ifnum\tmppgtot>0\relax\strut\par\vspace*{-2\nvt@bls}\fi%%
    \vspace{\nvt@bls}\vspace*{-\nvt@bls}\blankline\nopagebreak%%
    \setlength\parindent{0pt}%%
    \def\textit##1{##1}\def\it##1{##1}%%
    \def\smcp##1{##1}\def\SMCP##1{##1}\def\Smcp##1{##1}\def\onum##1{##1}%%
    \sbox0{\nvt@aff{RawFeature={+titl,+case},Scale=1.08,FakeStretch=.96,LetterSpace=4}%%
      \char"200D{#2}\char"200D}%%
    \edef\tmpwide{\fpeval{\wd0 > 3.5in}}%%
    \ifnum\tmpwide=1\relax%%
      \nvt@warn{\string\scene\space content width exceeds 3.5in. Too wide.}%%
      \sbox0{\char"FFFD\space \string\scene\space content is too wide.}%%
    \fi%%
    \strut\tmpsceneleft\smash{\raisebox{-.108\nvt@em}{\usebox0}}\tmpsceneright\strut\par%%
  \else%%
    \nvt@err{Command \string\scene\space cannot be nested in itself,^^J%%
      \spii or used in \string\styleN (N=1-9), \string\image, or block environment.}%%
    \char"FFFD\obeyspaces%%
  \fi%%
  \endgroup\nopagebreak\blankline%%
}%%
%%


%% INITIAL LETTER(S): \init{character} also starred \init*
%%   The \init command scales its character to larger than normal size. It may be used immediately
%% following \maintext. Typically, this is at the start of a chapter.
%%   You cannot use \init anywhere else. If you do that, the character prints at normal size,
%% and a warning results.
%%   The {character} may include preceding punctuation, such as quotes, guillemet, or Spanish
%% inverted marks. Except for Dutch IJ, use only a single alphabetic character. Do not use
%% \init for creating a numbered list. You may choose to place the following few words in
%% small caps, for an interesting effect.
%%   A blank line is inserted above \init, to prevent the enlarged character from crashing into
%% whatever is above it. The descender on characters such as Ccedilla will not crash into
%% the line below.
%%   The enlarged character kerns against its surrounding U+2060 control characters. At left,
%% that absorbs excess bearing. At right, it lets T hang above the following text. Feature ss20
%% adjusts some characters for proper appearance at scale.
%%   If the following text is too close for your taste, use \init*{character}. That inserts
%% a tiny amount of space between the initial character and whatever follows.
\DeclareDocumentCommand\init{sm}{%%
  \ifvmode\def\tmpok{1}\else\def\tmpok{0}\fi%%
  \def\tmptest{1}\ifx\nvt@initscale\tmptest\relax\def\tmpok{0}\fi%%
  \ifnvt@infootnote\def\tmpok{0}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%%
  \ifnvt@indisplay\def\tmpok{0}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@instyle\def\tmpok{0}\fi%%
  \begingroup\let\itshape\relax%%
  \def~{\hspace{.2\nvt@em}}%%
  \ifnum\tmpok=1\relax%%
    \sbox1{%%
      \nvt@aff{RawFeature={-smcp,-c2sc,+ss20},Scale=\nvt@initscale,FakeStretch=.94}%%
        \char"2060{#2}\char"2060%%
    }%%
    {\strut\smash{\usebox1}}%%
    \IfBooleanTF{#1}{\hspace{.04em}}{}%%
  \else
    \nvt@warn{\string\init only allowed at start of paragraph following ^^J%%
      \spii \string\maintext. Do not use \string\indent, or \string\noindent\space there.}%%
    {#2}%%
  \fi%%
  \endgroup%%
  \obeyspaces%%
}%%
%%


%% DROP CAP: \dcap{letter} also \dcap*{letter}
%%   Drop caps are rarely used in popular fiction, because they do not look good if the first
%% paragraph does not continue to at least two full lines beneath the drop cap. That is rare,
%% due to short paragraphs and dialogue. But if you plan ahead, and write your chapters using
%% a long opening paragraph, then you may consider drop caps. Otherwise, \init is better.
%%   The drop cap should be a single letter, without preceding punctuation. A macro code such as
%% \'A is considered to be a single letter. But Novelette does not enforce this limitation.
%%   All drop caps will occupy two lines. No more, no less. The X-height of the drop cap will be
%% at the X-height of ordinary letters, so it will be above the following lowercase/smcp text.
%% The baseline of the drop cap will be the same amount below the baseline of where it sits,
%% providing a nice visual symmetry (in the developer's opinion). If the drop cap has diacritical
%% above, it will rise above. If the drop cap is J Q or Ccedilla, the font provides letters
%% that do not intrude into the line below the drop cap. The font is always the main font.
%%   The unstarred \dcap spaces both lines equally (they vertically align) whether or not the
%% drop cap is a one-letter word. The starred \dcap* brings the immediately following text closer,
%% unless the drop cap is a one-letter word; in that case, the space serves to align vertically.
%%   Except in display zones, Novelette scales horizontal by em, vertical by baselineskip.
%% Thus, different scales are applied to the dcap letter; its aspect ratio changes with layout.
%% The numbers apply aspect ratio 1 for smallest baselineskip, h/w>1 for taller baselineskip.
%%   If the first line is a paragraph, do not end it with \par. Use \fakepar instead.
\DeclareDocumentCommand\dcap{sm}{%%
  \ifvmode\def\tmpok{1}\else\def\tmpok{0}\fi%%
  \def\tmptest{1}\ifx\nvt@initscale\tmptest\relax\def\tmpok{0}\fi%%
  \ifnum\tmpok=1\relax\vspace*{\nvt@bls}\fi%%
  \ifnvt@infootnote\def\tmpok{0}\fi%%
  \ifnvt@inheader\def\tmpok{0}\fi%%
  \ifnvt@indisplay\def\tmpok{0}\fi%%
  \ifnvt@inblock\def\tmpok{0}\fi%%
  \ifnvt@instyle\def\tmpok{0}\fi%%
  \let\itshape\relax%%
  \ifnum\tmpok=1\relax%%
    %% Vertical stretch depends on em and bls, but horizontal only on em. Xheight=.65em.
    \edef\tmpscale{\fpeval{(\nvt@bls+.856\nvt@em)/(.65*\nvt@em)}}%%
    \edef\tmpstretch{\fpeval{3.17/\tmpscale}}%%
\edef\tmpback{\fpeval{((\tmpscale-1)*\tmpstretch*.044em)+.1\nvt@em}pt}%% for O
\def\tmpback{.1\nvt@em}%%
    \sbox0{%%
      \hspace{-\tmpback}%%
      \nvt@aff{RawFeature={-smcp,-c2sc,-ss14,+ss20,+cv18},Scale=\tmpscale,FakeStretch=\tmpstretch}%%
      {\char"200D{#2}\char"200D}%%
    }%%
    \xdef\tmpwd{\fpeval{\wd0 + .1\nvt@em}pt}%%
    \xdef\tmplw{\fpeval{\textwidth - \tmpwd}pt}%%
    \parshape=3 \tmpwd \tmplw \tmpwd \tmplw 0pt \the\textwidth\relax%% No inner group here.
%%    \strut\smash{\llap{\raisebox{-\nvt@bls}{\usebox0}}}%%
\edef\tmpdn{\fpeval{-\nvt@bls-.206*\nvt@em}pt}%%
%%\strut\smash{\llap{\raisebox{\tmpdn}{\usebox0}}}%%
\strut\smash{\llap{\raisebox{\tmpdn}{\usebox0}}}%%
    \IfBooleanTF{#1}{\hspace{-.1\nvt@em}}{}%%
  \else%%
    \nvt@warn{\string\init, or \string\dcap, only allowed at start of paragraph.^^J%%
      \spii Do not use \string\indent, or \string\noindent\space there.}%%
    {#2}%%
  \fi%%
  \char"200D\obeyspaces%%
}%%
